<footer class="footer">
	<div class="container">
		<div class="footer__nav">
			<div class="footer__col">
				<h3 class="footer__col-title">Тематические программы</h3>
				<ul>
					{% for p in programs %}
						<li><a href="{{ ('/programs/' + p.slug + '/') | url }}">{{ p.title }}</a></li>
					{% endfor %}
				</ul>
			</div>
			<div class="footer__col">
				<h3 class="footer__col-title">Вокалисты</h3>
				<ul>
					{% for v in vocalists %}
						<li><a href="{{ ('/vocalists/' + v.slug + '/') | url }}">{{ v.name }}</a></li>
					{% endfor %}
				</ul>
			</div>
			<div class="footer__col">
				<h3 class="footer__col-title">Форматы</h3>
				<ul>
					{% for f in formats %}
						<li><a href="{{ ('/formats/' + f.slug + '/') | url }}">{{ f.title }}</a></li>
					{% endfor %}
				</ul>
			</div>
			<div class="footer__col">
				<h3 class="footer__col-title">События</h3>
				<ul>
					{% for e in events %}
						<li><a href="{{ ('/events/' + e.slug + '/') | url }}">{{ e.title }}</a></li>
					{% endfor %}
				</ul>
			</div>
			<div class="footer__col">
				<h3 class="footer__col-title">Связаться</h3>
				<ul>
					<li><a href="{{ site.telegram }}">Телеграм</a></li>
					{% if site.youtube %}<li><a href="{{ site.youtube }}" rel="noopener" target="_blank">YouTube</a></li>{% endif %}
					{% if site.vk %}<li><a href="{{ site.vk }}" rel="noopener" target="_blank">ВКонтакте</a></li>{% endif %}
					{% if site.instagram %}<li><a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram</a></li>{% endif %}
					<li><a href="{{ '/about/' | url }}">О группе</a></li>
					<li><a href="{{ '/blog/' | url }}">Блог</a></li>
					<li><a href="{{ '/repertoire/' | url }}">Репертуар</a></li>
					<li><a href="{{ '/riders/' | url }}">Райдеры</a></li>
				</ul>
			</div>
		</div>
		<div class="footer__bottom">
			<span class="footer__brand">{{ site.name }} · {{ site.shortName }}</span>
			<span class="footer__meta">{{ site.city }} · Международные туры · © 2026</span>
		</div>
	</div>
</footer>
