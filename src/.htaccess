# Preserve shared links after replacing the full promo and compacting Live Icon.
# Retired overcompressed costume 4K copies; approved masters preserve the edit.
RewriteRule ^assets/video/mp4/promo-costume-red-6f67800c7805-2160\.mp4$ https://luxuryband.ru/assets/video/mp4/promo-costume-red-4ef6085a27d4-2160.mp4 [L,R=301,NE,QSD]
RewriteRule ^assets/video/mp4/promo-costume-bw-822965daacce-2160\.mp4$ https://luxuryband.ru/assets/video/mp4/promo-costume-bw-01dc7bdc6938-2160.mp4 [L,R=301,NE,QSD]
RewriteRule ^assets/video/mp4/promo-costume-gold-b9f4a6ecf5ab-2160\.mp4$ https://luxuryband.ru/assets/video/mp4/promo-costume-gold-42ce52957175-2160.mp4 [L,R=301,NE,QSD]
RewriteRule ^assets/video/mp4/promo-costume-white-bcef639df1ff-2160\.mp4$ https://luxuryband.ru/assets/video/mp4/promo-costume-white-9d71d4290f9c-2160.mp4 [L,R=301,NE,QSD]
RewriteCond %{QUERY_STRING} (^|&)file=promo-costume-red-6f67800c7805-2160\.mp4(&|$)
