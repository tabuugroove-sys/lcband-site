<div class="leo">
	<section class="leo-hero" data-leo-hero aria-labelledby="leo-title">
		<div class="leo-hero__stage">
			<picture class="leo-hero__picture">
				<source media="(max-width: 700px)" type="image/avif" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-mobile-640.avif?v=2' | url }} 640w" sizes="100vw">
				<source media="(max-width: 700px)" type="image/webp" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-mobile-640.webp?v=2' | url }} 640w" sizes="100vw">
				<source type="image/avif" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-640.avif?v=2' | url }} 640w, {{ '/assets/leo-sax/hero/leo-sax-hero-1280.avif?v=2' | url }} 1280w, {{ '/assets/leo-sax/hero/leo-sax-hero-1672.avif?v=2' | url }} 1672w" sizes="100vw">
				<source type="image/webp" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-640.webp?v=2' | url }} 640w, {{ '/assets/leo-sax/hero/leo-sax-hero-1280.webp?v=2' | url }} 1280w, {{ '/assets/leo-sax/hero/leo-sax-hero-1672.webp?v=2' | url }} 1672w" sizes="100vw">
				<img class="leo-hero__image" src="{{ '/assets/leo-sax/hero/leo-sax-hero-1672.webp?v=2' | url }}" alt="Leo Sax — саксофонист Лео на сцене с саксофоном" width="1672" height="941" fetchpriority="high" decoding="async">
			</picture>
			<video class="leo-player" data-leo-video playsinline preload="none" aria-label="Промо-видео Leo Sax"></video>
		</div>
		<div class="leo-hero__shade" aria-hidden="true"></div>

		<div class="leo-crest">
			<header class="leo-wordmark">
				<h1 id="leo-title">LEO <span>SAX</span></h1>
			</header>
			<div class="leo-crest__mark" aria-hidden="true">
				<svg class="leo-crest__shield" viewBox="0 0 300 420" role="presentation" focusable="false">
					<path d="M150 18 280 66v142c0 88-51 153-130 200C71 361 20 296 20 208V66Z" />
				</svg>
				<img class="leo-emblem" src="{{ '/assets/leo-sax/leo-lion-sax-emblem.webp' | url }}" alt="" width="466" height="780" decoding="async">
			</div>
		</div>

		<button class="leo-play" type="button" data-leo-play aria-label="Смотреть полное промо Leo Sax">
			<span aria-hidden="true"></span>
		</button>

		<div class="leo-player-ui" data-player-ui aria-hidden="true" inert>
			<button class="leo-player-ui__close" type="button" data-video-close aria-label="Закрыть видео"></button>
			<div class="leo-player-ui__quality" role="group" aria-label="Качество видео">
				<button type="button" data-video-quality="480">480p</button>
				<button type="button" data-video-quality="720">720p</button>
				<button type="button" data-video-quality="1080">1080p</button>
			</div>
			<div class="leo-player-ui__bar">
				<button class="leo-player-ui__toggle" type="button" data-video-toggle aria-label="Пауза"></button>
				<input class="leo-player-ui__progress" data-video-progress type="range" min="0" max="100" value="0" step="0.1" aria-label="Позиция видео">
				<span class="leo-player-ui__time" data-video-time>0:00 / 2:35</span>
				<button class="leo-player-ui__fullscreen" type="button" data-video-fullscreen aria-label="На весь экран"></button>
			</div>
		</div>
		<p class="leo-player-status" data-player-status aria-live="polite"></p>
	</section>

	<section class="leo-gallery" aria-label="Фотографии Leo Sax">
		<div class="leo-carousel" data-carousel>
			<button class="leo-carousel__arrow leo-carousel__arrow--prev" type="button" data-carousel-prev aria-label="Предыдущее фото"></button>
			<div class="leo-carousel__viewport" data-carousel-viewport tabindex="0" aria-label="Фотографии Leo Sax">
				<div class="leo-carousel__track" data-carousel-track>
					{% for photo in gallery %}
					<figure class="leo-slide" data-carousel-slide data-slide-index="{{ loop.index0 }}">
						<picture>
							<source type="image/avif" srcset="{{ ('/assets/leo-sax/gallery/' + photo.slug + '-480.avif') | url }} 480w, {{ ('/assets/leo-sax/gallery/' + photo.slug + '-960.avif') | url }} 960w" sizes="(max-width: 700px) 78vw, 31vw">
							<source type="image/webp" srcset="{{ ('/assets/leo-sax/gallery/' + photo.slug + '-480.webp') | url }} 480w, {{ ('/assets/leo-sax/gallery/' + photo.slug + '-960.webp') | url }} 960w" sizes="(max-width: 700px) 78vw, 31vw">
							<img src="{{ ('/assets/leo-sax/gallery/' + photo.slug + '-960.webp') | url }}" alt="{{ photo.alt }}" width="960" height="1440" loading="lazy" decoding="async">
						</picture>
					</figure>
					{% endfor %}
				</div>
			</div>
			<button class="leo-carousel__arrow leo-carousel__arrow--next" type="button" data-carousel-next aria-label="Следующее фото"></button>
		</div>
		<div class="leo-carousel__dots" data-carousel-dots aria-label="Позиция в фотогалерее">
			{% for photo in gallery %}<button type="button" data-carousel-dot="{{ loop.index0 }}" aria-label="Фото {{ loop.index }}"{% if loop.first %} class="is-active" aria-current="true"{% endif %}></button>{% endfor %}
		</div>
	</section>

	<section class="leo-moments" aria-labelledby="leo-moments-title">
		<div class="leo-wrap">
			<div class="leo-section-head">
				<p class="leo-kicker">Сценарий</p>
				<h2 id="leo-moments-title">Где саксофон<br><em>звучит уместно.</em></h2>
			</div>
			<div class="leo-moments__grid">
				<article><span>01</span><h3>Welcome</h3><p>Первые встречи, звон бокалов — и вечер уже звучит.</p></article>
				<article><span>02</span><h3>Церемония</h3><p>Мелодия ведёт к главному моменту, не забирая его себе.</p></article>
				<article><span>03</span><h3>Ужин</h3><p>Тёплый jazz, soul и bossa nova остаются рядом с разговорами.</p></article>
				<article><span>04</span><h3>Вечеринка</h3><p>Sax &amp; DJ добавляет танцполу ритм и живое дыхание.</p></article>
			</div>
		</div>
	</section>

	<section class="leo-repertoire" aria-labelledby="leo-repertoire-title">
		<div class="leo-wrap">
			<div class="leo-section-head leo-section-head--rep">
				<p class="leo-kicker">Репертуар</p>
				<h2 id="leo-repertoire-title">Музыка следует<br><em>ритму события.</em></h2>
				<p class="leo-repertoire__lead">От дыхания джаза до лёгкого поп-мотива — программа меняет настроение мягко, без лишних слов.</p>
			</div>
			<div class="leo-repertoire__groups">
				{% for group in repertoire %}
				<details class="leo-repertoire__group">
					<summary><span>{{ group.title }}</span><small>{{ group.count }}</small><i aria-hidden="true"></i></summary>
					<ul>
						{% for song in group.songs %}<li><strong>{{ song[0] }}</strong>{% if song[1] %}<span>{{ song[1] }}</span>{% endif %}</li>{% endfor %}
					</ul>
				</details>
				{% endfor %}
			</div>
		</div>
	</section>
</div>
