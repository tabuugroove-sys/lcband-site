		{slug:'luxury-latin-dance-master-class', poster:'luxury-latin-dance-master-class-ru-4x3', title:'Teddy · Танцевальный мастер-класс', eyebrow:'Интерактив'},
		{slug:'interact-laz-coco-jambo', title:'LAZ · Coco Jambo', eyebrow:'Интерактив'},
		{slug:'live-baskov-lcb', title:'Басков · LC Band', eyebrow:'Лайв'},
		{slug:'live-lets-get-loud', title:'Let\'s Get Loud · Лайв', eyebrow:'Лайв'},
		{slug:'live-baskov-revva', title:'Басков + Ревва · Лайв', eyebrow:'Лайв'},
		{slug:'live-jazz-vintage', title:'Джазовая · Винтажная', eyebrow:'Тематик'},
		{slug:'live-big-lineup', title:'Big Lineup', eyebrow:'Лайв'},
		{slug:'live-perfect', title:'Perfect', eyebrow:'Лайв'},
		{slug:'live-soho', title:'Soho Rooms', eyebrow:'Лайв'},
		{slug:'live-berezy', title:'Берёзы', eyebrow:'Лайв'},
		{slug:'interact-chainsmokers', title:'Chainsmokers', eyebrow:'Интерактив'},
		{slug:'live-dance-monkey', title:'Dance Monkey · Лайв', eyebrow:'Лайв'},
		{slug:'live-simple-the-best', title:'Simply the Best · Jazz', eyebrow:'Лайв'},
		{slug:'live-adele-hello', title:'Adele · Hello', eyebrow:'Лайв'}
	] %}
	<div class="container container--narrow reveal">
		<h2 class="section__title">Смотрите,<br><span class="muted">как это работает на сцене.</span></h2>
		<p class="section__lead">Студийные промо-ролики, запись с концертов, интерактивы и тематические программы.</p>
	</div>

	<div class="video-rail video-rail--big reveal" role="region" aria-label="Студийные проморолики">
		<div class="video-rail__heading"><h3 class="video-rail__title">Студийные проморолики</h3></div>
		<ul class="video-rail__track">
			{% for v in promos %}
			<li class="vtile vtile--big">
				<a class="vtile__link" href="#" data-video="{{ v.slug }}">
					<picture class="vtile__pic">
						<source media="(max-width: 734px)" type="image/webp" sizes="84vw"
							srcset="{{ ('/assets/video/posters/' + (v.poster or v.slug) + '-720.webp') | url }} 720w, {{ ('/assets/video/posters/' + (v.poster or v.slug) + '-1080.webp') | url }} 1080w">
						<img class="vtile__poster" src="{{ ('/assets/video/posters/' + (v.poster or v.slug) + '.jpg') | url }}?v=20260620i" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					</picture>
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
	<div class="video-rail video-rail--small reveal" role="region" aria-label="Живые видео с концертов">
		<div class="video-rail__heading"><h3 class="video-rail__title">Живые видео с концертов</h3></div>
		<ul class="video-rail__track">
			{% for v in lives %}
			<li class="vtile vtile--small">
				<a class="vtile__link" href="#" data-video="{{ v.slug }}">
					<picture class="vtile__pic">
						<source media="(max-width: 734px)" type="image/webp" sizes="72vw"
							srcset="{{ ('/assets/video/posters/' + (v.poster or v.slug) + '-720.webp') | url }} 720w, {{ ('/assets/video/posters/' + (v.poster or v.slug) + '-1080.webp') | url }} 1080w">
						<img class="vtile__poster" src="{{ ('/assets/video/posters/' + (v.poster or v.slug) + '.jpg') | url }}?v=20260826a" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					</picture>
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

<!-- =============== BOOK =============== -->
<section class="section section--book" id="book">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Бронирование</p>
		<h2 class="section__title">Напишите —<br><span class="muted">соберём программу под ваше событие.</span></h2>
		<p class="section__lead">Расскажите дату, место и формат. Пришлём состав, тайминг и смету в течение дня.</p>
		<div class="book__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Написать в Телеграм</a>
			<a class="btn btn--ghost-dark" href="#top">Наверх</a>
		</div>
	</div>
</section>

{% if weddingVariant or tilesVariant %}
<!-- =============== VARIANT SWITCHER (preview pages only) =============== -->
<div class="variant-switcher" aria-label="Переключение вариантов">
	<span class="variant-switcher__label">Вариант:</span>
	<a href="{{ '/' | url }}"   class="variant-switcher__link{% if not weddingVariant and not tilesVariant %} is-active{% endif %}">main</a>
	<a href="{{ '/v3/' | url }}" class="variant-switcher__link{% if weddingVariant == 'v3' %} is-active{% endif %}">V3 · wedding only</a>
	<a href="{{ '/v4/' | url }}" class="variant-switcher__link{% if tilesVariant == 'v4' %} is-active{% endif %}">V4 · all tiles halo</a>
</div>
{% endif %}
