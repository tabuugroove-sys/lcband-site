---
layout: layouts/base.njk
---
{% set isEn = htmlLang == 'en' %}
{% block schema %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@graph": [
		{ "@type": "MusicGroup", "@id": "{{ site.url }}/#musicgroup", "name": "{{ site.name }}", "url": "{{ site.url }}" },
		{
			"@type": "BlogPosting",
			"@id": "{{ site.url }}{{ page.url }}#article",
			"headline": {{ (h1 or title) | dump | safe }},
			"description": {{ description | dump | safe }},
			"inLanguage": "{% if isEn %}en-US{% else %}ru-RU{% endif %}",
			"datePublished": "{{ page.date | date }}",
			"dateModified": "{{ page.date | date }}",
			"author": { "@id": "{{ site.url }}/#musicgroup" },
			"publisher": { "@id": "{{ site.url }}/#musicgroup" },
			"mainEntityOfPage": "{{ site.url }}{{ page.url }}"
			{%- if heroImage %},
			"image": "{{ site.url }}/assets/photos/{{ heroImage }}"
			{%- endif %}
		},
		{
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "{{ site.shortName }}", "item": "{{ site.url }}{% if isEn %}/en/{% else %}/{% endif %}" },
				{ "@type": "ListItem", "position": 2, "name": "{% if isEn %}Blog{% else %}Блог{% endif %}", "item": "{{ site.url }}{% if isEn %}/en/blog/{% else %}/blog/{% endif %}" },
				{ "@type": "ListItem", "position": 3, "name": {{ (h1 or title) | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
			]
		}
		{%- if faq %},
		{
			"@type": "FAQPage",
			"@id": "{{ site.url }}{{ page.url }}#faq",
			"mainEntity": [
				{%- for item in faq %}
				{
					"@type": "Question",
					"name": {{ item.q | dump | safe }},
					"acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
				}{% if not loop.last %},{% endif %}
				{%- endfor %}
			]
		}
		{%- endif %}
	]
}
</script>
{% endblock %}

<article class="post">
	<header class="page-hero page-hero--list">
		<div class="container container--narrow">
			<p class="page-hero__breadcrumb">
				<a href="{{ ('/en/' if isEn else '/') | url }}">{{ site.shortName }}</a> <span>·</span>
				<a href="{{ ('/en/blog/' if isEn else '/blog/') | url }}">{% if isEn %}Blog{% else %}Блог{% endif %}</a> <span>·</span>
				<span>{{ eyebrow or ('Article' if isEn else 'Статья') }}</span>
			</p>
			<p class="page-hero__eyebrow">{{ eyebrow or ('Blog' if isEn else 'Блог') }}</p>
			<h1 class="page-hero__title">{{ h1 or title }}</h1>
			{% if lead %}<p class="page-hero__lead">{{ lead }}</p>{% endif %}
			<p class="post__meta">{% if isEn %}Updated{% else %}Обновлено{% endif %} {{ page.date | date }}</p>
		</div>
	</header>

	<div class="section section--flush">
		<div class="container container--narrow reveal">
			<div class="prose">
				{{ content | safe }}
			</div>
		</div>
	</div>

	{% if faq %}
	<section class="section section--light" id="faq">
		<div class="container container--narrow reveal">
			<p class="section__eyebrow">{% if isEn %}Frequently Asked Questions{% else %}Частые вопросы{% endif %}</p>
			<h2 class="section__title">{% if isEn %}Clear answers,<br><span class="muted">straight to the point.</span>{% else %}Коротко<br><span class="muted">по делу.</span>{% endif %}</h2>
			<div class="faq">
				{% for item in faq %}
				<details class="faq__item">
					<summary class="faq__q">{{ item.q }}</summary>
					<div class="faq__a"><p>{{ item.a | replace(('Telegram' if isEn else 'Телеграм'), '<a href="' + site.telegram + '">' + ('Telegram' if isEn else 'Телеграм') + '</a>') | safe }}</p></div>
				</details>
				{% endfor %}
			</div>
		</div>
	</section>
	{% endif %}

	{% if related %}
	<section class="section section--flush">
		<div class="container container--narrow reveal">
			<p class="section__eyebrow">{% if isEn %}Related Reading{% else %}Дальше по теме{% endif %}</p>
			<ul class="post__related">
				{% for r in related %}
				<li><a href="{{ r.href | url }}"><span class="post__related-title">{{ r.title }}</span><span class="post__related-sub">{{ r.sub }}</span></a></li>
				{% endfor %}
			</ul>
		</div>
	</section>
	{% endif %}

	<section class="section section--book">
		<div class="container container--narrow reveal">
			<p class="section__eyebrow">{% if isEn %}Let's Discuss Your Event{% else %}Обсудим ваше событие{% endif %}</p>
			<h2 class="section__title">{% if isEn %}Message us for a program and quote.{% else %}Напишите — соберём программу и смету.{% endif %}</h2>
			<p class="section__lead">{% if isEn %}Share the date, venue and format. We will send a suitable lineup, timing and price, normally within a day.{% else %}Расскажите дату, площадку и формат. Пришлём состав, тайминг и цену под ваше событие в течение дня.{% endif %}</p>
			<div class="book__cta">
				<a class="btn btn--primary" href="{{ site.telegram }}">{% if isEn %}Message on Telegram{% else %}Написать в Телеграм{% endif %}</a>
				<a class="btn btn--ghost-dark" href="{{ ('/en/events/' if isEn else '/events/') | url }}">{% if isEn %}All events{% else %}Все события{% endif %}</a>
			</div>
		</div>
	</section>
</article>
