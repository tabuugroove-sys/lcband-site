</style>

<script>
(function () {
	var v = document.querySelector('.sx-hero__media');
	if (!v || !('IntersectionObserver' in window)) return;
	var scrolledAway = false;   // hero ушёл из вида (прокрутили вниз)
	var started = false;        // видео уже запускали
	var play = function () { var p = v.play(); if (p && p.catch) p.catch(function () {}); };
	// При загрузке и пока стоим вверху — видео НЕ стартует, держится постер (фото).
	// Запускаем только после жеста: вниз (hero вышел) → снова вверх (hero вернулся).
	var io = new IntersectionObserver(function (entries) {
		entries.forEach(function (e) {
			if (!e.isIntersecting) {
				scrolledAway = true;
			} else if (scrolledAway) {
				started = true;
				play();
			} else if (started) {
				play();
			}
		});
	}, { threshold: 0.35 });
	io.observe(v);
})();
</script>
