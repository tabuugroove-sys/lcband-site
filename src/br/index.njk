{% set landing = footerI18n[htmlLang] %}
{% set landingPrefixes = {vocalists:'vocalist-', programs:'program-', formats:'format-', events:'event-'} %}
{% set landingPortraits = {irina:'irina.jpg', stas:'stas-2026-10.jpg', teddy:'teddy.jpg', laz:'laz.jpg'} %}
{% for group in ['vocalists', 'programs', 'formats', 'events'] %}
<section class="section section--light" id="{{ 'lineup' if group == 'vocalists' else group }}">
	<div class="container">
		<h2 class="section__title">{{ landing.headings[group] }}</h2>
		<ul class="{{ 'vocalists' if group == 'vocalists' else 'formats' }}">
			{% for slug, label in landing[group] %}
			<li class="{{ 'voc' if group == 'vocalists' else 'format' }}" id="{{ landingPrefixes[group] + slug }}">
				{% if group == 'vocalists' %}
				<div class="voc__photo"><img src="{{ ('/assets/vocalists/' + landingPortraits[slug]) | url }}" alt="{{ label }} — Luxury Cover Band" loading="lazy"></div>
				{% endif %}
				<div{% if group != 'vocalists' %} class="format__body"{% endif %}>
					<h3 class="{{ 'voc__name' if group == 'vocalists' else 'format__title' }}">{{ label }}</h3>
					<p class="{{ 'voc__bio' if group == 'vocalists' else 'format__text' }}">{{ landing.summaries[group][slug] }}</p>
					<a class="{{ 'voc__more' if group == 'vocalists' else 'format__more' }}" href="{{ site.whatsapp }}">{{ landing.request }} ›</a>
				</div>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>
{% endfor %}

{% for guide in landing.guides %}
<section class="section{% if loop.index % 2 == 0 %} section--elev{% endif %}" id="{{ guide.id }}">
	<div class="container container--narrow">
		<h2 class="section__title">{{ guide.title }}</h2>
		<p class="section__lead">{{ guide.text }}</p>
		<div class="cta-row cta-row--left">
			<a class="btn btn--primary" href="{{ site.whatsapp }}">{{ landing.links.whatsapp }}</a>
			{% if guide.id == 'costumes' %}<a class="btn btn--ghost-dark" href="#top">Ver os figurinos</a>{% endif %}
		</div>
	</div>
</section>
{% endfor %}

