{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MusicGroup",
      "@id": "{{ site.url }}/ae/#musicgroup",
      "name": "{{ site.name }}",
      "description": "Live entertainment for weddings, corporate events and private parties in Dubai and the UAE.",
      "url": "{{ site.url }}/ae/",
      "image": "{{ site.url }}/{{ site.defaultOgImage }}",
      "areaServed": ["Dubai", "United Arab Emirates"],
      "sameAs": ["{{ site.telegram }}"]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I hire entertainment in the UAE?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Send the date, venue, guest count and preferred music format. We confirm the available lineup, technical rider and quote for your Dubai event."
          }
        },
        {
          "@type": "Question",
          "name": "What live music formats are available for Dubai events?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose a compact live set, vocalists with musicians, or a full cover band. The lineup is adapted to the event format, venue and programme."
          }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

