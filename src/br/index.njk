				<picture class="tile__pic">
					<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
						srcset="{{ '/assets/photos/corporate-768.webp' | url }} 768w, {{ '/assets/photos/corporate-1152.webp' | url }} 1152w">
					<img class="tile__img" src="{{ '/assets/photos/corporate.jpg?v=6' | url }}" alt="Eventos corporativos — Luxury Cover Band" loading="lazy">
				</picture>
				<div class="tile__content">
					<h3 class="tile__title">Eventos corporativos</h3>
					<p class="tile__sub">Sua marca viva em grande palco.</p>
					<div class="cta-row">
						<a class="btn btn--blue" href="{{ '/events/corporate/' | url }}">Saiba mais</a>
						<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Falar no Telegram</a>
					</div>
				</div>
			</li>
			<li class="tile tile--has-photo tile--center tile--copy-split tile--wedding">
				<a class="tile__tap-target" href="{{ '/events/wedding/' | url }}" aria-label="Abrir: Casamentos"></a>
				<picture class="tile__pic">
					<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
						srcset="{{ '/assets/photos/wedding-768.webp' | url }} 768w, {{ '/assets/photos/wedding-1152.webp' | url }} 1152w">
					<img class="tile__img" src="{{ '/assets/photos/wedding.jpg' | url }}" alt="Casamentos — Luxury Cover Band" loading="lazy">
				</picture>
				<div class="tile__content">
					<h3 class="tile__title">Casamentos</h3>
					<p class="tile__sub">Show · Primeira dança · Jantar</p>
					<div class="cta-row">
						<a class="btn btn--blue" href="{{ '/events/wedding/' | url }}">Saiba mais</a>
						<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Falar no Telegram</a>
					</div>
				</div>
			</li>
			<li class="tile tile--has-photo tile--copy-top tile--copy-dark tile--birthday">
				<a class="tile__tap-target" href="{{ '/events/birthday/' | url }}" aria-label="Abrir: Aniversários"></a>
