.sx-h2--book { font-size:clamp(36px,6vw,80px); letter-spacing:-0.03em; line-height:1.0; margin:22px auto 0; }
.sx-book__sub { font-size:19px; color:#86868b; margin:24px auto 0; max-width:560px; }
.sx-book__cta { margin-top:40px; }
.sx-book__contact { display:flex; gap:40px; justify-content:center; flex-wrap:wrap; margin-top:46px; color:#86868b; font-size:15px; }

