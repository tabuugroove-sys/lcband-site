<!-- =============== STORY ROOMS (Apple TV 4K style: bands + pinned screen) =============== -->
{#- Полосы и слои экрана строятся из ОДНОГО массива: новая полоса = одна
    запись {eyebrow, title, text, bg, tint?, light?, video}. Порядок записей =
    порядок полос и z-порядок слоёв. Видео и постер берутся по slug'у video:
    /assets/video/mp4/<video>-1080.mp4 + /assets/video/posters/<video>.jpg
    bg — любое CSS-background; палитра ниже = точные цвета полос section-rooms
    с apple.com/apple-tv-4k (Music / Fitness+ / Arcade / Photos). -#}
{% set storyRooms = [
	{eyebrow:'Репертуар', title:'12 языков.<br>Один репертуар.', text:'Поём на 12 языках — с правильной фонетикой, не транслитом. Итальянский, испанский, французский, английский и другие — под программу и аудиторию.', bg:'radial-gradient(at top right, #796bf2, #572f91)', tint:'#beb8d8', video:'interact-laz-coco-jambo'},
	{eyebrow:'Репертуар', title:'500+ песен.<br>Любая эпоха и жанр.', text:'От ретро и джаза до современных хитов. Собираем сет-лист под вашу аудиторию и повод — не играем один и тот же концерт всем.', bg:'radial-gradient(at top right, #0ae8b5, #00bb53)', tint:'#afe9c4', video:'live-big-lineup'},
	{eyebrow:'Интерактив', title:'Не просто концерт.<br>Шоу с залом.', text:'Дуэты с гостями, конкурсы, интерактивные номера. Не просто играем для публики — работаем с ней весь вечер.', bg:'radial-gradient(at top right, #ea6037, #d62c3f)', tint:'#fac0cb', video:'interact-chainsmokers'},
	{eyebrow:'Образы', title:'20+ образов.<br>Свой стиль на каждый повод.', text:'От классики до тематического шоу — каждый сценический образ группы продуман как законченная визуальная история.', bg:'#f5f5f7', light:true, video:'live-icon'}
] %}
<section class="story-rooms" data-story-rooms>
	<div class="story-rooms__gallery" aria-hidden="true">
		<div class="story-rooms__device">
			<div class="story-rooms__frame">
				{% for r in storyRooms %}
				<div class="story-rooms__layer" data-story-layer="{{ loop.index0 }}" style="z-index: {{ loop.index }};">
					<video muted loop playsinline preload="metadata"
						poster="{{ ('/assets/video/posters/' + r.video + '.jpg') | url }}">
						<source src="{{ ('/assets/video/mp4/' + r.video + '-1080.mp4') | url }}" type="video/mp4">
					</video>
				</div>
				{% endfor %}
			</div>
		</div>
	</div>
	<div class="story-rooms__rooms">
		{% for r in storyRooms %}
		<div class="story-room{% if r.light %} story-room--light{% endif %}" data-room="{{ loop.index0 }}" style="--room-bg: {{ r.bg }};{% if r.tint %} --room-tint: {{ r.tint }};{% endif %}">
			<div class="story-room__copy">
				<img class="story-room__static" src="{{ ('/assets/video/posters/' + r.video + '.jpg') | url }}" alt="" loading="lazy" width="1800" height="1012">
				<p class="story-room__eyebrow">{{ r.eyebrow }}</p>
				<h3 class="story-room__title">{{ r.title | safe }}</h3>
				<p class="story-room__text">{{ r.text }}</p>
			</div>
		</div>
		{% endfor %}
	</div>
</section>

<!-- ЗАГЛУШКИ: видео в блоке выше — временные, позже заменим на слайдшоу образов и другие материалы -->

<section class="section section--flush">
	<div class="container reveal">
		{% set aboutStats = [
			{num: site.stats.shows, label: 'выступлений'},
			{num: site.stats.countries, label: 'стран'},
			{num: site.stats.years, label: 'лет на сцене'},
			{num: site.stats.tvShows, label: 'ТВ-проектов'},
			{num: site.stats.songs, label: 'песен в репертуаре'},
			{num: site.stats.languages, label: 'языков'},
			{num: site.stats.looks, label: 'сценических образов', href: '/costumes/'},
			{num: site.stats.lineup, label: 'музыкантов на сцене'}
		] %}
		<ul class="highlight-stats">
			{% for s in aboutStats %}
			<li class="highlight-stat highlight-stat--{{ ['a','b','c','d'][loop.index0 % 4] }}{% if s.href %} highlight-stat--linked{% endif %}">
				{% if s.href %}
				<a class="highlight-stat__link" href="{{ s.href | url }}">
					<div class="highlight-stat__num">{{ s.num }}</div>
					<div class="highlight-stat__label">{{ s.label }}</div>
				</a>
				{% else %}
				<div class="highlight-stat__num">{{ s.num }}</div>
				<div class="highlight-stat__label">{{ s.label }}</div>
				{% endif %}
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

