---
pagination:
  data: enContent.programs
  size: 1
  alias: program
permalink: "/en/programs/{{ program.slug }}/"
layout: layouts/base.njk
htmlLang: en
ogLocale: en_US
eleventyComputed:
  title: "{{ program.title }} — {{ site.shortName }}"
  description: "{{ program.lead }}"
  keywords: "{{ program.keywords }}"
  ogImage: "{{ program.poster }}"
---

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MusicGroup", "@id": "{{ site.url }}/#musicgroup", "name": "{{ site.name }}", "url": "{{ site.url }}" },
    { "@type": "Service", "@id": "{{ site.url }}{{ page.url }}#service", "name": "{{ program.title }}", "description": {{ program.lead | dump | safe }}, "serviceType": "Themed live-band program", "provider": { "@id": "{{ site.url }}/#musicgroup" }, "areaServed": ["Moscow", "Russia", "International tours"], "url": "{{ site.url }}{{ page.url }}" }
    {% for item in program.videos %},
    { "@type": "VideoObject", "@id": "{{ site.url }}{{ page.url }}#video-{{ item.slug }}", "name": "{{ item.title }} — {{ program.title }}", "description": {{ program.lead | dump | safe }}, "thumbnailUrl": "{{ site.url }}/{{ item.poster }}", "contentUrl": "{{ site.url }}/assets/video/mp4/{{ item.slug }}-720.mp4", "embedUrl": "{{ site.url }}{{ page.url }}", "uploadDate": "2026-06-18", "publisher": { "@id": "{{ site.url }}/#musicgroup" } }
    {% endfor %}
  ]
}
</script>
{% endblock %}

<section class="page-hero{% if program.slug == 'spanish' %} page-hero--spanish-promo{% endif %}">
	<div class="container container--narrow">
		<p class="page-hero__breadcrumb">
			<a href="{{ '/en/' | url }}">{{ site.shortName }}</a> <span>·</span>
			<a href="{{ '/en/programs/' | url }}">Themed Programs</a> <span>·</span>
			<span>{{ program.label }}</span>
		</p>
		{% if program.slug != 'spanish' %}
		<p class="page-hero__eyebrow">{{ program.eyebrow }}</p><h1 class="page-hero__title">{{ program.headline }}</h1><p class="page-hero__lead">{{ program.lead }}</p>
		{% endif %}
	</div>
	{% if program.slug == 'spanish' %}
	<div class="spanish-promo">
		<div class="spanish-promo__visual" aria-hidden="true">
			<div class="spanish-promo__card"><img class="spanish-promo__lights" src="{{ '/assets/photos/spanish-hero/lights-overlay.png?v=2' | url }}" alt="" loading="lazy" decoding="async"><p class="spanish-promo__card-title">Macarena<br>Despacito<br>Bailando</p></div>
			<img class="spanish-promo__orb spanish-promo__orb--one" src="{{ '/assets/photos/spanish-hero/teddy-white.jpg' | url }}" alt="" loading="eager">
			<img class="spanish-promo__orb spanish-promo__orb--two" src="{{ '/assets/photos/spanish-hero/latin-duo.jpg' | url }}" alt="" loading="eager">
			<img class="spanish-promo__orb spanish-promo__orb--three" src="{{ '/assets/photos/spanish-hero/teddy-latina.jpg' | url }}" alt="" loading="eager">
		</div>
		<div class="spanish-promo__copy"><p class="spanish-promo__eyebrow">{{ program.eyebrow }}</p><h1 class="spanish-promo__title">{{ program.headline }}</h1><p class="spanish-promo__lead">{{ program.lead }}</p></div>
	</div>
	{% elif program.poster %}
	<div class="page-hero__media">
		<img src="{{ ('/' + program.poster) | url }}" alt="{{ program.title }} — Luxury Cover Band" loading="eager">
		{% if program.video %}
		<a class="page-hero__play" href="#" data-video="{{ program.video }}" aria-label="Watch video"><span></span></a>
		{% endif %}
	</div>
	{% endif %}
</section>

{% if program.videos %}<section class="section section--light program-video-carousel">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Video</p>
		<h2 class="section__title">{{ program.title }}<br><span class="muted">in live format.</span></h2>
		<p class="section__lead">{{ program.videoLead or "A few short videos to show the feel, repertoire and stage language of this program." }}</p>
	</div>
	<div class="video-rail video-rail--big video-rail--program reveal" role="region" aria-label="{{ program.title }} videos">
		<ul class="video-rail__track">
		{% for item in program.videos %}
		<li class="vtile vtile--big">
			<a class="vtile__link" href="#" data-video="{{ item.slug }}">
				<img class="vtile__poster" src="{{ ('/' + item.poster) | url }}?v=20260817a" alt="{{ item.title }} — {{ program.title }}" loading="lazy">
				<span class="vtile__play" aria-hidden="true"></span>
				<div class="vtile__caption">
					<span class="vtile__eyebrow">{{ item.label }}</span>
					<span class="vtile__title">{{ item.title }}</span>
				</div>
			</a>
		</li>
		{% endfor %}
		</ul>
	</div>
	{% if program.promoUrl %}
	<div class="container container--narrow reveal program-promo-cta">
		<a class="btn btn--ghost-dark" href="{{ program.promoUrl }}" target="_blank" rel="noopener">⬇ {{ program.promoLabel or "Download promo (Google Drive)" }}</a>
	</div>
	{% endif %}
</section>
{% endif %}

{% if program.photos %}
<section class="section section--light program-photos-section">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Photos</p>
		<h2 class="section__title">The look<br><span class="muted">of the project.</span></h2>
	</div>
	<div class="container reveal">
		<ul class="program-photos">
			{% for ph in program.photos %}
			<li class="program-photos__item">
				<img src="{{ ('/' + ph.src) | url }}" alt="{{ ph.alt }}" loading="lazy" decoding="async">
			</li>
			{% endfor %}
		</ul>
	</div>
</section>
{% endif %}

<section class="section section--light">
	<div class="container container--narrow reveal">
		<h2 class="section__title">What is included<br><span class="muted{% if program.slug == 'spanish' %} muted--spanish-gradient{% endif %}">in the program.</span></h2>
		<ul class="bullets">
			{% for b in program.bullets %}
			<li class="bullet">
				<span class="bullet__check">✓</span>
				<span class="bullet__text">{{ b }}</span>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

<section class="section section--elev">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">More options</p>
		<h2 class="section__title">Other themed programs.</h2>
		<p class="section__lead">{{ site.stats.songs }} songs in {{ site.stats.languages }} languages — we can combine several blocks in one evening.</p>
	</div>
	<div class="container reveal">
		<ul class="caps">
			{% for p in enContent.programs %}
				{% if p.slug != program.slug %}
				<li class="cap cap--cover">
					<a class="cap__link" href="{{ ('/en/programs/' + p.slug + '/') | url }}">
						<div class="cap__photo"><img src="{{ ('/' + p.poster) | url }}" alt="{{ p.title }} — LC Band" loading="lazy"></div>
						<div class="cap__overlay"><h3 class="cap__title">{{ p.title }}</h3></div>
					</a>
				</li>
				{% endif %}
			{% endfor %}
		</ul>
	</div>
</section>

<section class="section section--book">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow section__eyebrow--light">Booking</p>
		<h2 class="section__title section__title--light">Interested in<br><span class="muted-light">{{ program.title }}?</span></h2>
		<p class="section__lead section__lead--light">Send us the date, venue and format — we will suggest the lineup and timing.</p>
		<div class="book__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Message on Telegram</a>
			<a class="btn btn--ghost-light" href="{{ '/en/programs/' | url }}">All themed programs</a>
		</div>
	</div>
</section>
