						<img class="vtile__poster" src="{{ ('/assets/video/posters/' + v.slug + '.jpg') | url }}?v=20260622c" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					</picture>
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

