<section class="artist-catalog">
	<div class="artist-catalog__hero">
		<p class="artist-catalog__kicker">LC Band artists</p>
		<h1>Артисты на стриминге</h1>
		<p class="artist-catalog__lead">Три страницы артистов и список треков, которые сейчас видны на их стриминг-профилях.</p>
	</div>

	<div class="artist-catalog__columns" aria-label="Артисты и треки">
		{% for artist in artists %}
		<article class="artist-column artist-column--{{ artist.accent }}">
			<header class="artist-column__head">
				<a class="artist-column__avatar" href="{{ artist.url }}" target="_blank" rel="noopener" aria-label="{{ artist.name }} на Spotify">
					<img src="{{ artist.avatar }}" alt="{{ artist.name }} — аватарка на стриминге" loading="lazy">
				</a>
				<div>
					<p class="artist-column__source">Spotify · {{ artist.streamName }}</p>
					<h2>{{ artist.name }}</h2>
				</div>
			</header>

			<ol class="artist-column__tracks">
				{% for track in artist.tracks %}
				<li>
					<span class="artist-column__track-title">{{ track.title }}</span>
					<span class="artist-column__track-year">{{ track.year }}</span>
				</li>
				{% endfor %}
			</ol>

			<a class="artist-column__link" href="{{ artist.url }}" target="_blank" rel="noopener">Открыть страницу артиста</a>
		</article>
		{% endfor %}
	</div>
</section>

<style>
.artist-catalog {
	min-height: 100vh;
	padding: calc(var(--nav-h) + 72px) 22px 96px;
	background:
		radial-gradient(circle at 14% 18%, rgba(255, 49, 95, 0.18), transparent 30%),
		radial-gradient(circle at 88% 10%, rgba(17, 186, 164, 0.16), transparent 28%),
		linear-gradient(180deg, #0b0b0b 0%, #111 42%, #f5f5f2 42.1%, #f7f7f4 100%);
	color: #f7f7f4;
}

.artist-catalog__hero {
	max-width: 1120px;
	margin: 0 auto 48px;
	display: grid;
	grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
	gap: clamp(24px, 6vw, 84px);
	align-items: end;
}

.artist-catalog__kicker {
	grid-column: 1 / -1;
	font-size: 12px;
	line-height: 1.2;
	font-weight: 700;
	letter-spacing: 0.24em;
	text-transform: uppercase;
	color: #ffcc4d;
}

.artist-catalog h1 {
	max-width: 740px;
	font-family: var(--ff-display);
	font-size: clamp(46px, 8vw, 104px);
	line-height: 0.92;
	font-weight: 700;
	letter-spacing: 0;
}

.artist-catalog__lead {
	max-width: 430px;
	font-size: clamp(17px, 2vw, 22px);
	line-height: 1.35;
	color: rgba(247, 247, 244, 0.74);
}

.artist-catalog__columns {
	max-width: 1120px;
	margin: 0 auto;
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 18px;
	align-items: start;
}

.artist-column {
	--artist-accent: #ffcc4d;
	position: relative;
	min-height: 100%;
	padding: clamp(20px, 3vw, 30px);
	background: rgba(255,255,255,0.94);
	color: #111;
	border: 1px solid rgba(0,0,0,0.08);
	border-radius: 8px;
	box-shadow: 0 28px 70px rgba(0,0,0,0.2);
	overflow: hidden;
}

.artist-column::before {
	content: "";
	position: absolute;
	inset: 0 0 auto;
	height: 7px;
	background: var(--artist-accent);
}

.artist-column--laz { --artist-accent: #ff315f; }
.artist-column--teddy { --artist-accent: #11baa4; }
.artist-column--stas { --artist-accent: #ffcc4d; }

.artist-column__head {
	display: grid;
	grid-template-columns: 96px minmax(0, 1fr);
	gap: 18px;
	align-items: center;
	margin-top: 6px;
}

.artist-column__avatar {
	display: block;
	width: 96px;
	height: 96px;
	border-radius: 50%;
	overflow: hidden;
	background: #111;
	border: 3px solid var(--artist-accent);
}

.artist-column__avatar img {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.artist-column__source {
	font-size: 11px;
	font-weight: 700;
	letter-spacing: 0.16em;
	text-transform: uppercase;
	color: #6e6e73;
}

.artist-column h2 {
	margin-top: 8px;
	font-family: var(--ff-display);
	font-size: clamp(30px, 4vw, 48px);
	line-height: 0.96;
	font-weight: 700;
	letter-spacing: 0;
}

.artist-column__tracks {
	margin-top: 28px;
	padding: 0;
	list-style: none;
	display: grid;
	gap: 1px;
	background: rgba(0,0,0,0.1);
}

.artist-column__tracks li {
	display: grid;
	grid-template-columns: minmax(0, 1fr) auto;
	gap: 14px;
	align-items: baseline;
	padding: 12px 0;
	background: rgba(255,255,255,0.96);
}

.artist-column__track-title {
	font-size: 16px;
	line-height: 1.25;
	font-weight: 650;
	letter-spacing: 0;
	overflow-wrap: anywhere;
}

.artist-column__track-year {
	font-size: 12px;
	font-weight: 700;
	color: #8e8e93;
}

.artist-column__link {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-height: 42px;
	margin-top: 24px;
	padding: 10px 18px;
	border-radius: 999px;
	background: #111;
	color: #fff;
	font-size: 14px;
	line-height: 1.15;
	font-weight: 700;
}

@media (max-width: 980px) {
	.artist-catalog__columns {
		grid-template-columns: 1fr;
	}

	.artist-column {
		max-width: 680px;
		width: 100%;
		margin: 0 auto;
	}
}

@media (max-width: 720px) {
	.artist-catalog {
		padding: calc(var(--nav-h) + 48px) 16px 64px;
		background:
			radial-gradient(circle at 16% 10%, rgba(255, 49, 95, 0.22), transparent 34%),
			linear-gradient(180deg, #0a0a0a 0%, #111 36%, #f7f7f4 36.1%, #f7f7f4 100%);
	}

	.artist-catalog__hero {
		grid-template-columns: 1fr;
		gap: 20px;
		margin-bottom: 32px;
	}

	.artist-catalog__lead {
		color: rgba(247, 247, 244, 0.8);
	}

	.artist-column__head {
		grid-template-columns: 82px minmax(0, 1fr);
	}

	.artist-column__avatar {
		width: 82px;
		height: 82px;
	}
}
</style>
