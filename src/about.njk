<!-- =============== STORY ROOMS (Apple TV 4K style: bands + pinned screen) =============== -->
{#- Полосы и слои экрана строятся из ОДНОГО массива: новая полоса = одна
    запись {eyebrow, title, text, bg, tint?, light?, video}. Порядок записей =
    порядок полос и z-порядок слоёв. Видео и постер берутся по slug'у video:
    /assets/video/mp4/<video>-1080.mp4 + /assets/video/posters/<video>.jpg
    bg — любое CSS-background; палитра ниже = точные цвета полос section-rooms
    с apple.com/apple-tv-4k (Music / Fitness+ / Arcade / Photos). -#}
{% set storyRooms = [
	{eyebrow:'Репертуар', title:'12 языков.<br>Один репертуар.', text:'Итальянский, испанский, французский, английский и другие языки — под программу и аудиторию. Список песен можно открыть с поиском или скачать в PDF.', href:'/repertoire/', linkLabel:'Открыть список песен', bg:'radial-gradient(at top right, #796bf2, #572f91)', tint:'#beb8d8', video:'interact-chainsmokers'},
	{eyebrow:'Репертуар', title:'500+ песен.<br>От джаза до танцпола.', text:'Для welcome — джаз и лаунж; для основной программы — поп, рок, ретро или латино. Выбираем песни и порядок блоков под сценарий вашего вечера.', href:'/programs/', linkLabel:'Посмотреть программы', bg:'radial-gradient(at top right, #0ae8b5, #00bb53)', tint:'#afe9c4', video:'live-big-lineup'},
