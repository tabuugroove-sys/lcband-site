{% if htmlLang == 'ar' or htmlLang == 'pt-BR' %}
{% set footerLocal = footerI18n[htmlLang] %}
{% set footerAnchors = {programs:'program-', vocalists:'vocalist-', formats:'format-', events:'event-'} %}
<footer class="footer">
	<div class="container">
		<div class="footer__nav">
			{% for group in ['programs', 'vocalists', 'formats', 'events'] %}
			<div class="footer__col">
				<h3 class="footer__col-title">{{ footerLocal.headings[group] }}</h3>
				<ul>
					{% for slug, label in footerLocal[group] %}
					<li><a href="{{ (footerLocal.home + '#' + footerAnchors[group] + slug) | url }}">{{ label }}</a></li>
					{% endfor %}
				</ul>
			</div>
			{% endfor %}
			<div class="footer__col">
				<h3 class="footer__col-title">{{ footerLocal.headings.contact }}</h3>
				<ul>
					<li><a href="{{ site.whatsapp }}">{{ footerLocal.links.whatsapp }}</a></li>
					{% for anchor in ['about', 'videos', 'planning', 'repertoire', 'riders'] %}
					<li><a href="{{ (footerLocal.home + '#' + anchor) | url }}">{{ footerLocal.links[anchor] }}</a></li>
					{% endfor %}
				</ul>
			</div>
		</div>
		<div class="footer__bottom">
			<a class="footer__brand" href="{{ footerLocal.home | url }}">{{ site.name }}</a>
			<span class="footer__meta">{{ footerLocal.city }} · {{ footerLocal.links.tours }} · © 2026</span>
		</div>
		{% if translations[page.url] %}
		<nav class="footer__languages" aria-label="{{ footerLocal.languageLabel }}">
			{% for alternate in translations[page.url] %}{% if alternate.lang != 'x-default' %}
			<a href="{{ alternate.url | url }}" lang="{{ alternate.lang }}" hreflang="{{ alternate.lang }}"{% if alternate.url == page.url %} aria-current="page"{% endif %}>{{ footerLocal.languages[alternate.lang] }}</a>
			{% endif %}{% endfor %}
		</nav>
		{% endif %}
	</div>
</footer>
{% else %}
<footer class="footer">
	<div class="container">
		{% set footerEn = footerI18n.en if htmlLang == 'en' else null %}
		{% set footerBase = '/en' if footerEn else '' %}
		<div class="footer__nav">
			<div class="footer__col">
				<h3 class="footer__col-title">{{ footerEn.headings.programs if footerEn else 'Тематические программы' }}</h3>
				<ul>
					{% for p in programs %}
						<li><a href="{{ (footerBase + '/programs/' + p.slug + '/') | url }}">{{ (footerEn.programs[p.slug] or p.slug) if footerEn else p.title }}</a></li>
					{% endfor %}
				</ul>
			</div>
			<div class="footer__col">
				<h3 class="footer__col-title">{{ footerEn.headings.vocalists if footerEn else 'Вокалисты' }}</h3>
				<ul>
					{% for v in vocalists %}
						<li><a href="{{ (footerBase + '/vocalists/' + v.slug + '/') | url }}">{{ (v.nameLatin or v.slug) if footerEn else v.name }}</a></li>
					{% endfor %}
				</ul>
			</div>
			<div class="footer__col">
				<h3 class="footer__col-title">{{ footerEn.headings.formats if footerEn else 'Форматы' }}</h3>
				<ul>
					{% for f in formats %}
						<li><a href="{{ (footerBase + '/formats/' + f.slug + '/') | url }}">{{ (footerEn.formats[f.slug] or f.slug) if footerEn else f.title }}</a></li>
					{% endfor %}
				</ul>
			</div>
			<div class="footer__col">
				<h3 class="footer__col-title">{{ footerEn.headings.events if footerEn else 'События' }}</h3>
				<ul>
					{% for e in events %}
						<li><a href="{{ (footerBase + '/events/' + e.slug + '/') | url }}">{{ (footerEn.events[e.slug] or e.slug) if footerEn else e.title }}</a></li>
					{% endfor %}
				</ul>
			</div>
			<div class="footer__col">
				<h3 class="footer__col-title">{{ footerEn.headings.contact if footerEn else 'Связаться' }}</h3>
				<ul>
					<li><a href="{{ site.whatsapp if footerEn else site.telegram }}">{{ footerEn.links.whatsapp if footerEn else 'Телеграм' }}</a></li>
					{% if site.vk %}<li><a href="{{ site.vk }}" rel="noopener" target="_blank">{{ footerEn.links.vk if footerEn else 'ВКонтакте' }}</a></li>{% endif %}
					{% if site.instagram %}<li><a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram</a></li>{% endif %}
					<li><a href="{{ (footerBase + '/about/') | url }}">{{ footerEn.links.about if footerEn else 'О группе' }}</a></li>
					<li><a href="{{ (footerBase + '/live/') | url }}">{{ 'Live videos' if footerEn else 'Видео выступлений' }}</a></li>
					<li><a href="{{ (footerBase + '/blog/') | url }}">{{ footerEn.links.blog if footerEn else 'Блог' }}</a></li>
					<li><a href="{{ (footerBase + '/repertoire/') | url }}">{{ footerEn.links.repertoire if footerEn else 'Репертуар' }}</a></li>
					<li><a href="{{ (footerBase + '/riders/') | url }}">{{ footerEn.links.riders if footerEn else 'Райдеры' }}</a></li>
				</ul>
			</div>
		</div>
		<div class="footer__bottom">
			<a class="footer__brand" href="{{ (footerBase + '/') | url }}">{{ site.name }}</a>
			<span class="footer__meta">{{ 'Moscow' if footerEn else site.city }} · {{ footerEn.links.tours if footerEn else 'Международные туры' }} · © 2026</span>
		</div>
		{% if translations[page.url] %}
		<nav class="footer__languages" aria-label="{{ 'Language' if footerEn else 'Язык' }}">
			{% for alternate in translations[page.url] %}{% if alternate.lang != 'x-default' %}
			<a href="{{ alternate.url | url }}" lang="{{ alternate.lang }}" hreflang="{{ alternate.lang }}"{% if alternate.url == page.url %} aria-current="page"{% endif %}>{{ footerEn.languages[alternate.lang] if footerEn else alternate.label }}</a>
			{% endif %}{% endfor %}
		</nav>
		{% endif %}
	</div>
</footer>
{% endif %}
