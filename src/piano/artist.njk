---
pagination:
  data: pianoPages
  size: 1
  alias: artist
permalink: "/piano/{{ artist.slug }}/"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{{ artist.title }}</title>
  <meta name="description" content="{{ artist.description }}">
  <meta name="theme-color" content="#10110f">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <link rel="canonical" href="{{ site.url }}/piano/{{ artist.slug }}/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ artist.title }}">
  <meta property="og:description" content="{{ artist.description }}">
  <meta property="og:url" content="{{ site.url }}/piano/{{ artist.slug }}/">
  <meta property="og:image" content="{{ site.url }}/assets/piano/{{ artist.heroImage }}-1200.webp">
  <meta property="og:site_name" content="Luxury Band">
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "{{ artist.title }}",
    "description": "{{ artist.description }}",
    "url": "{{ site.url }}/piano/{{ artist.slug }}/",
    "inLanguage": "ru",
    "isPartOf": { "@type": "WebSite", "name": "Luxury Band", "url": "{{ site.url }}/" },
    "about": { "@type": "Person", "name": "RAIM", "jobTitle": "Пианист" },
    "primaryImageOfPage": "{{ site.url }}/assets/piano/{{ artist.heroImage }}-1200.webp"
  }
  </script>
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/assets/piano/piano.css' | url }}">
  <script src="{{ '/assets/piano/piano.js' | url }}" defer></script>
</head>
<body class="theme-{{ artist.theme }}">
  <a class="skip" href="#films">Перейти к видео</a>
  <header class="topbar">
    <nav class="wrap navigation" aria-label="Основная навигация">
      <a class="brand" href="{{ '/' | url }}"><img src="{{ '/assets/favicon.svg' | url }}" width="30" height="30" alt=""><span>Luxury Band</span></a>
      <div class="navlinks"><a href="#films">Видео</a>{% if artist.photos.length %}<a href="#portraits">Фото</a>{% endif %}<a href="#format">Формат</a><a class="nav-book" href="#booking">Обсудить событие <span aria-hidden="true">↗</span></a></div>
    </nav>
  </header>
  <main id="top">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{{ artist.eyebrow }}</p>
        <h1 id="hero-title"><span class="artist-name">{{ artist.name }}</span><span class="artist-subtitle">{{ artist.subtitle }}</span></h1>
        <p class="intro">{{ artist.intro }}</p>
        <a class="button button-light" data-video data-title="{{ artist.heroVideoTitle }}" href="{{ site.url }}/assets/video/mp4/{{ artist.heroVideo }}.mp4"><span class="play-triangle" aria-hidden="true"></span>Смотреть и слушать<span class="button-arrow" aria-hidden="true">↗</span></a>
        <div class="hero-caption"><span class="status-light" aria-hidden="true"></span>{{ artist.heroLabel }}</div>
      </div>
      <div class="hero-visual">
        <div class="orbit" aria-hidden="true"></div>
        <a class="hero-photo" data-video data-title="{{ artist.heroVideoTitle }}" href="{{ site.url }}/assets/video/mp4/{{ artist.heroVideo }}.mp4" aria-label="Смотреть: {{ artist.heroVideoTitle }}">
          <img src="{{ ('/assets/piano/' + artist.heroImage + '-1200.webp') | url }}" srcset="{{ ('/assets/piano/' + artist.heroImage + '-640.webp') | url }} 640w, {{ ('/assets/piano/' + artist.heroImage + '-1200.webp') | url }} 1200w" sizes="(max-width:760px) calc(100vw - 40px), 50vw" alt="{{ artist.heroAlt }}" fetchpriority="high">
          <span class="photo-play" aria-hidden="true">↗</span>
        </a>
        <span class="vertical-note" aria-hidden="true">LIVE MUSIC / REAL MOMENTS</span>
        <div class="visual-caption"><span>{{ artist.chapter }}</span><span>Нажмите, чтобы услышать <span aria-hidden="true">↗</span></span></div>
      </div>
      <div class="hero-bottom"><a href="#story">Вечер в деталях <span aria-hidden="true">↓</span></a><span>Фортепиано. Вживую.</span></div>
    </section>
    <div class="keyboard" aria-hidden="true">{% for key in range(0,28) %}<i{% if key % 7 != 2 and key % 7 != 6 %} class="has-black"{% endif %}></i>{% endfor %}</div>

    <section class="story paper" id="story" aria-labelledby="story-title">
      <div class="wrap story-grid"><div><p class="eyebrow">Музыка ближе</p><h2 id="story-title">{{ artist.quote }}</h2></div><div class="story-copy"><span class="flourish" aria-hidden="true">𝄞</span><p>{{ artist.about }}</p></div></div>
    </section>

    <section class="films wrap" id="films" aria-labelledby="films-title">
      <div class="section-heading"><div><p class="eyebrow">Нажмите play</p><h2 id="films-title">Лучше услышать.</h2></div><p class="section-aside">Живой звук.<br>Настоящее настроение.</p></div>
      <div class="film-grid{% if artist.videos.length == 1 %} film-grid-single{% endif %}">
        {% for video in artist.videos %}
        <article class="film">
          <a class="film-image" data-video data-title="{{ video.title }}" href="{{ site.url }}/assets/video/mp4/{{ video.slug }}.mp4" aria-label="Смотреть видео: {{ video.title }}"><img src="{{ ('/assets/piano/' + video.poster + '.webp') | url }}" alt="{{ video.title }} — кадр выступления" loading="lazy" decoding="async"><span class="film-play" aria-hidden="true">▶</span><span class="film-index" aria-hidden="true">0{{ loop.index }}</span></a>
          <div class="film-caption"><div><p class="eyebrow">{{ video.label }}</p><h3>{{ video.title }}</h3></div><a href="{{ site.url }}/assets/video/mp4/{{ video.slug }}.mp4" target="_blank" rel="noopener" aria-label="Открыть отдельное видео: {{ video.title }}">↗</a></div>
        </article>
        {% endfor %}
      </div>
    </section>

    {% if artist.photos.length %}
    <section class="portraits paper" id="portraits" aria-labelledby="portraits-title">
      <div class="wrap"><div class="section-heading"><div><p class="eyebrow">Свет. Образ. Характер.</p><h2 id="portraits-title">По ту сторону клавиш.</h2></div><span class="section-aside">RAIM / Portraits</span></div>
      <div class="portrait-grid">{% for photo in artist.photos %}<figure><a href="{{ ('/assets/piano/' + photo.file + '-1200.webp') | url }}" data-photo data-title="{{ photo.title }}" aria-label="Увеличить фото: {{ photo.title }}"><img src="{{ ('/assets/piano/' + photo.file + '-640.webp') | url }}" alt="{{ photo.alt }}" loading="lazy" decoding="async"><span aria-hidden="true">↗</span></a><figcaption><span>0{{ loop.index }}</span>{{ photo.title }}</figcaption></figure>{% endfor %}</div>
      </div>
    </section>
    {% endif %}

    <section class="formats wrap" id="format" aria-labelledby="format-title">
      <div class="formats-heading"><p class="eyebrow">Настроение вашего события</p><h2 id="format-title">{{ artist.formatsTitle }}</h2></div>
      <div class="format-list">{% for format in artist.formats %}<article><span class="format-tag">{{ format.tag }}</span><div><h3>{{ format.title }}</h3><p>{{ format.text }}</p></div><span class="format-mark" aria-hidden="true">✳</span></article>{% endfor %}</div>
      <p class="practical">Дату, состав программы, инструмент на площадке и технические условия согласуем перед бронированием.</p>
    </section>

    <section class="sibling" aria-labelledby="sibling-title"><div class="wrap sibling-grid"><div><p class="eyebrow">{{ artist.siblingEyebrow }}</p><h2 id="sibling-title">{{ artist.siblingTitle }}</h2></div><div><p>{{ artist.siblingText }}</p><a class="text-link" href="{{ ('/piano/' + artist.siblingSlug + '/') | url }}">{{ artist.siblingLink }} <span aria-hidden="true">↗</span></a></div></div></section>

    <section class="booking wrap" id="booking" aria-labelledby="booking-title"><p class="eyebrow">Начнём с вашего повода</p><h2 id="booking-title">{{ artist.bookingTitle }}</h2><p>Напишите дату, место и формат события.<br>Обсудим программу и подготовим предложение.</p><a class="button button-light" href="{{ site.telegram }}" target="_blank" rel="noopener">Обсудить с Luxury Band <span class="button-arrow" aria-hidden="true">↗</span></a></section>
  </main>
  <footer class="wrap footer"><a class="brand" href="{{ '/' | url }}">Luxury Band</a><span>RAIM · {% if artist.slug == 'karaoke' %}Piano karaoke{% else %}Piano sessions{% endif %}</span><button class="share" type="button" hidden>Поделиться ↗</button><a href="#top">Наверх ↑</a></footer>
  <dialog class="media-dialog" aria-labelledby="media-title"><div class="dialog-heading"><h2 id="media-title">Видео</h2><button class="close-dialog" type="button" aria-label="Закрыть">×</button></div><video class="dialog-video" controls playsinline preload="none" hidden></video><img class="dialog-photo" alt="" hidden><p class="media-error" role="status" hidden>Не удалось загрузить видео. Откройте его по ссылке ниже.</p><a class="media-direct" target="_blank" rel="noopener">Открыть оригинал ↗</a></dialog>
  <p class="toast" role="status" hidden></p>
</body>
</html>
