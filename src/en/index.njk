					<img class="tile__img" src="{{ '/assets/photos/author-music-stage.jpg' | url }}" alt="Original music by Luxury Cover Band — live stage performance, original tracks on Apple Music and Spotify" loading="lazy" width="1920" height="1280" style="object-position: left center;">
				</picture>
				<div class="tile__content">
					<h3 class="tile__title">Original<span class="tile__line"> Music</span></h3>
					<p class="tile__sub"><span class="tile__line">Original tracks</span> <span class="tile__line">with stars</span> <span class="tile__line">and Luxury AI Radio</span></p>
					<div class="cta-row">
						<a class="btn btn--blue" href="{{ '/artists/' | url }}">Learn more</a>
						<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Message on Telegram</a>
					</div>
				</div>
			</li>
		</ul>
	</div>
</section>

<!-- =============== VIDEO RAILS (Apple-style 2 rows · no Cyrillic-titled songs) =============== -->
<section class="section" id="videos">
	{% set promos = [
		{slug:'promo-danza-cuduro', poster:'promo-danza-cuduro-2026', title:'Danza Cuduro · Live', eyebrow:'Live'},
		{slug:'thematic-retro-heart', poster:'thematic-retro-heart-2026', title:'You\'re My Heart · Retro', eyebrow:'Themed'},
		{slug:'promo-lets-get-it-started', title:'Let\'s Get It Started', eyebrow:'Promo'},
		{slug:'promo-cold-heart', title:'Cold Heart', eyebrow:'Promo'},
		{slug:'promo-loca-loca', title:'Loca Loca · LAZ', eyebrow:'Promo'},
		{slug:'promo-amore-no', title:'Amore No · Italian', eyebrow:'Themed'},
		{slug:'thematic-italian', title:'Cosa sei · Italian', eyebrow:'Themed'},
		{slug:'interact-wedding-shallow', title:'Shallow · Wedding', eyebrow:'Interactive'}
	] %}
	{% set lives = [
		{slug:'live-icon', title:'Epic Live · Icon', eyebrow:'Live'},
		{slug:'teddy-macarena', title:'Teddy · Macarena', eyebrow:'Interactive'},
		{slug:'teddy-latina-promo', title:'Teddy · Latin', eyebrow:'Latino'},
		{slug:'luxury-latin-dance-master-class', title:'Teddy · Dance Masterclass', eyebrow:'Interactive'},
		{slug:'interact-laz-coco-jambo', title:'LAZ · Coco Jambo', eyebrow:'Interactive'},
		{slug:'live-lets-get-loud', title:'Let\'s Get Loud', eyebrow:'Live'},
		{slug:'live-jazz-vintage', title:'Jazz · Vintage', eyebrow:'Themed'},
		{slug:'live-big-lineup', title:'Big Lineup', eyebrow:'Live'},
		{slug:'live-perfect', title:'Perfect', eyebrow:'Live'},
		{slug:'live-soho', title:'Soho Rooms', eyebrow:'Live'},
		{slug:'interact-chainsmokers', title:'Chainsmokers', eyebrow:'Interactive'},
		{slug:'live-dance-monkey', title:'Dance Monkey', eyebrow:'Live'},
		{slug:'live-simple-the-best', title:'Simply the Best · Jazz', eyebrow:'Live'},
		{slug:'live-adele-hello', title:'Adele · Hello', eyebrow:'Live'}
	] %}
	<div class="container container--narrow reveal">
		<h2 class="section__title">See how<br><span class="muted">it works on stage.</span></h2>
		<p class="section__lead">Studio promo videos, concert recordings, interactive moments, and themed programs.</p>
	</div>

	<div class="video-rail video-rail--big reveal" role="region" aria-label="Studio promo videos">
		<div class="video-rail__heading"><h3 class="video-rail__title">Studio Promo Videos</h3></div>
		<ul class="video-rail__track">
			{% for v in promos %}
			<li class="vtile vtile--big">
				<a class="vtile__link" href="#" data-video="{{ v.slug }}">
					<picture class="vtile__pic">
						<source media="(max-width: 734px)" type="image/webp" sizes="84vw"
							srcset="{{ ('/assets/video/posters/' + (v.poster or v.slug) + '-720.webp') | url }} 720w, {{ ('/assets/video/posters/' + (v.poster or v.slug) + '-1080.webp') | url }} 1080w">
						<img class="vtile__poster" src="{{ ('/assets/video/posters/' + (v.poster or v.slug) + '.jpg') | url }}?v=20260620i" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					</picture>
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
	<div class="video-rail video-rail--small reveal" role="region" aria-label="Live concert videos">
		<div class="video-rail__heading"><h3 class="video-rail__title">Live Concert Videos</h3></div>
		<ul class="video-rail__track">
			{% for v in lives %}
			<li class="vtile vtile--small">
				<a class="vtile__link" href="#" data-video="{{ v.slug }}">
					<picture class="vtile__pic">
						<source media="(max-width: 734px)" type="image/webp" sizes="72vw"
							srcset="{{ ('/assets/video/posters/' + v.slug + '-720.webp') | url }} 720w, {{ ('/assets/video/posters/' + v.slug + '-1080.webp') | url }} 1080w">
						<img class="vtile__poster" src="{{ ('/assets/video/posters/' + v.slug + '.jpg') | url }}?v=20260622c" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					</picture>
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

<!-- =============== BOOK =============== -->
<section class="section section--book" id="book">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Booking</p>
		<h2 class="section__title">Get in touch —<br><span class="muted">we'll build a show for your event.</span></h2>
		<p class="section__lead">Tell us the date, venue, and format. We'll send the lineup, timing, and quote the same day.</p>
		<div class="book__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Message on Telegram</a>
			<a class="btn btn--ghost-dark" href="#top">Back to top</a>
		</div>
	</div>
</section>
