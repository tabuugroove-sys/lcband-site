		{slug:'promo-egoistka', poster:'promo-egoistka-2026-red-stage', title:'Эгоистка · 2020–2025', eyebrow:'Клип'},
		{slug:'thematic-retro-heart', poster:'thematic-retro-heart-2026', title:'You\'re My Heart · Ретро', eyebrow:'Тематик'},
		{slug:'promo-danza-cuduro', poster:'promo-danza-cuduro-2026', title:'Danza Cuduro · Live', eyebrow:'Лайв'},
		{slug:'promo-lets-get-it-started', title:'Let\'s Get It Started', eyebrow:'Промо'},
		{slug:'promo-cold-heart', title:'Cold Heart', eyebrow:'Промо'},
		{slug:'promo-loca-loca', title:'Loca Loca · LAZ', eyebrow:'Промо'},
		{slug:'promo-letet', title:'Лететь', eyebrow:'Промо'},
