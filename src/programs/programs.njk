---
pagination:
  data: programs
  size: 1
  alias: program
permalink: "/programs/{{ program.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ program.title }} — {{ site.shortName }}"
  description: "{{ program.lead }}"
  keywords: "{{ program.keywords }}"
  ogImage: "{{ program.poster }}"
---

{% block schema %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "MusicGroup",
			"@id": "{{ site.url }}/#musicgroup",
			"name": "{{ site.name }}",
			"url": "{{ site.url }}"
		},
		{
			"@type": "Service",
			"@id": "{{ site.url }}{{ page.url }}#service",
			"name": "{{ program.title }}",
			"description": "{{ program.lead }}",
			"serviceType": "Тематическая программа кавер-группы",
			"provider": { "@id": "{{ site.url }}/#musicgroup" },
			"areaServed": ["Москва", "Россия", "Международные туры"],
			"url": "{{ site.url }}{{ page.url }}"
		}
		{% for item in program.videos %},
		{
			"@type": "VideoObject",
			"@id": "{{ site.url }}{{ page.url }}#video-{{ item.slug }}",
			"name": "{{ item.title }} — {{ program.title }}",
			"description": "{{ program.lead }}",
			"thumbnailUrl": "{{ site.url }}/{{ item.poster }}",
			"contentUrl": "{{ site.url }}/assets/video/mp4/{{ item.slug }}-720.mp4",
			"embedUrl": "{{ site.url }}{{ page.url }}",
			"uploadDate": "2026-06-18",
			"publisher": { "@id": "{{ site.url }}/#musicgroup" }
		}
		{% endfor %}
	]
}
</script>
{% endblock %}

<section class="page-hero">
	<div class="container container--narrow">
		<p class="page-hero__breadcrumb">
			<a href="{{ '/' | url }}">{{ site.shortName }}</a> <span>·</span>
			<a href="{{ '/programs/' | url }}">Тематические программы</a> <span>·</span>
			<span>{{ program.label }}</span>
		</p>
		<p class="page-hero__eyebrow">{{ program.eyebrow }}</p>
		<h1 class="page-hero__title">{{ program.headline }}</h1>
		<p class="page-hero__lead">{{ program.lead }}</p>
	</div>
	{% if program.poster %}
	<div class="page-hero__media">
		<img src="{{ ('/' + program.poster) | url }}" alt="{{ program.title }} — Luxury Cover Band" loading="eager">
		{% if program.video %}
		<a class="page-hero__play" href="#" data-video="{{ program.video }}" aria-label="Смотреть видео"><span></span></a>
		{% endif %}
	</div>
	{% endif %}
</section>

{% if program.videos %}
<section class="section section--light program-video-carousel">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Видео</p>
		<h2 class="section__title">{{ program.title }}<br><span class="muted">в живом формате.</span></h2>
		<p class="section__lead">Несколько фрагментов программы — live-выступления и клипы, чтобы быстро показать настроение этого блока.</p>
		<div class="program-video-carousel__controls" aria-label="Навигация по видео">
			<button class="program-video-carousel__btn" type="button" data-video-carousel-prev aria-label="Предыдущее видео">‹</button>
			<button class="program-video-carousel__btn" type="button" data-video-carousel-next aria-label="Следующее видео">›</button>
		</div>
	</div>
	<div class="video-shelf video-shelf--program reveal" data-video-carousel>
		{% for item in program.videos %}
		<a class="video-card" href="#" data-video="{{ item.slug }}">
			<img src="{{ ('/' + item.poster) | url }}" alt="{{ item.title }} — {{ program.title }}" loading="lazy">
			<span class="video-card__play" aria-hidden="true"></span>
			<span class="video-card__meta">
				<span class="video-card__label">{{ item.label }}</span>
				<span class="video-card__name">{{ item.title }}</span>
			</span>
		</a>
		{% endfor %}
	</div>
</section>
{% endif %}

<section class="section section--light">
	<div class="container container--narrow reveal">
		<h2 class="section__title">Что входит<br><span class="muted">в программу.</span></h2>
		<ul class="bullets">
			{% for b in program.bullets %}
			<li class="bullet">
				<span class="bullet__check">✓</span>
				<span class="bullet__text">{{ b }}</span>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

<section class="section section--elev">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Варианты</p>
		<h2 class="section__title">Другие тематические программы.</h2>
		<p class="section__lead">{{ site.stats.songs }} песен, {{ site.stats.languages }} языков — собираем вечер из любых комбинаций.</p>
	</div>
	<div class="container reveal">
		<ul class="caps">
			{% for p in programs %}
				{% if p.slug != program.slug %}
				<li class="cap cap--cover">
					<a class="cap__link" href="{{ ('/programs/' + p.slug + '/') | url }}">
						<div class="cap__photo"><img src="{{ ('/' + p.poster) | url }}" alt="{{ p.title }} — LC Band" loading="lazy"></div>
						<div class="cap__overlay">
							<h3 class="cap__title">{{ p.title }}</h3>
						</div>
					</a>
				</li>
				{% endif %}
			{% endfor %}
		</ul>
	</div>
</section>

<section class="section section--book">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow section__eyebrow--light">Бронирование</p>
		<h2 class="section__title section__title--light">Хочу<br><span class="muted-light">{{ program.title | lower }}.</span></h2>
		<p class="section__lead section__lead--light">Напишите дату, место и формат — подберём состав и пришлём тайминг.</p>
		<div class="book__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Написать в Телеграм</a>
			<a class="btn btn--ghost-light" href="{{ '/programs/' | url }}">Все тематические программы</a>
		</div>
	</div>
</section>
