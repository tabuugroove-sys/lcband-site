{#- Четыре немых ролика 2×2 вместо фото блока «О группе» — решение Михаила 29.10:
    Epic Live 04 «Голоса», студийное промо «пик за пиком», лучшие моменты остальных
    видео (mix-12, вместо 06 «Неон» — слева снизу) и 03 «Зал поёт».
    Полоса сверху — по образцу ленточки Apple One: одна фраза и «Узнать больше».
    Формат сетки по ширине экрана: 21:9 → 2:1 → 3:2, на телефоне четыре квадрата.
    Ролики из 4K/HQ-исходников («чтобы пикселей не было»): широкие 1280 и 1920
    (main.js берёт 1920 на больших и retina-экранах), квадраты 720; лежат на хостинге
    в assets/video/mp4 (media/manifest.json), постеры — assets/hero, описание —
    media/home-reel.json. Странице задать reelTitle, reelHref, reelMore. -#}
{% set reelLabels = {
  ru: {pause:'Пауза видео', resume:'Включить видео'},
  en: {pause:'Pause videos', resume:'Play videos'},
  ar: {pause:'إيقاف الفيديو مؤقتًا', resume:'تشغيل الفيديو'},
  'pt-BR': {pause:'Pausar vídeos', resume:'Reproduzir vídeos'}
} %}
{% set reelLabel = reelLabels[htmlLang or 'ru'] %}
<section class="reel" id="about" data-reel aria-labelledby="reel-title">
	<div class="reel__ribbon">
		<h2 class="reel__title" id="reel-title">{{ reelTitle | safe }}</h2>
		<a class="btn reel__more" href="{{ reelHref | url }}">{{ reelMore }}</a>
	</div>
	<div class="reel__grid" data-reel-grid>
		{%- for id in ['epic-04', 'studio-11', 'mix-12', 'epic-03'] %}
		<div class="reel__tile">
			<picture class="reel__poster">
				<source media="(max-width: 599px)" srcset="{{ ('/assets/hero/hq-20261029-' + id + '-square.webp') | url }}">
				<img src="{{ ('/assets/hero/hq-20261029-' + id + '-wide.webp') | url }}" alt="" width="1280" height="640" loading="lazy" decoding="async">
			</picture>
			<video class="reel__video" data-reel-video muted loop playsinline preload="none" tabindex="-1" aria-hidden="true"
				data-src-wide="{{ ('/assets/video/mp4/hq-20261029-' + id + '-wide1280.mp4') | url }}"
				data-src-wide-hd="{{ ('/assets/video/mp4/hq-20261029-' + id + '-wide1920.mp4') | url }}"
				data-src-square="{{ ('/assets/video/mp4/hq-20261029-' + id + '-square.mp4') | url }}"></video>
		</div>
		{%- endfor %}
		<button class="reel__toggle" type="button" data-reel-toggle hidden
			data-label-pause="{{ reelLabel.pause }}" data-label-resume="{{ reelLabel.resume }}"
			aria-label="{{ reelLabel.pause }}"></button>
	</div>
</section>
