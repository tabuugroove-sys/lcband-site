---
layout: layouts/base.njk
pagination:
  data: leoSaxLocales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
eleventyComputed:
  title: "{{ locale.title }}"
  description: "{{ locale.description }}"
  keywords: "{{ locale.keywords }}"
  htmlLang: "{{ locale.lang }}"
  ogLocale: "{% if locale.lang == 'en' %}en_US{% else %}ru_RU{% endif %}"
ogImage: assets/leo-sax/hero/leo-sax-hero-1672.webp
barePage: true
showMainNav: true
bodyClass: leo-sax-page
pageStylesheet: /assets/leo-sax/leo-sax.css?v=5
pageScript: /assets/leo-sax/leo-sax.js?v=3
leoSaxPage: true
---
{% set isEn = locale.lang == 'en' %}
{% set gallery = [
	{ slug: "playing-burgundy", alt: "Leo Sax играет на саксофоне в бордовом сценическом образе", altEn: "Leo Sax performing in a burgundy stage look" },
	{ slug: "city-black-tie", alt: "Саксофонист Лео в чёрном костюме на фоне московской архитектуры", altEn: "Leo Sax in black tie against Moscow architecture" },
	{ slug: "white-jacket", alt: "Leo Sax с саксофоном в белом пиджаке у красной кулисы", altEn: "Leo Sax in a white jacket beside a red curtain" },
	{ slug: "library-full", alt: "Саксофонист Лео в тёмном костюме в библиотечном интерьере", altEn: "Leo Sax in a dark suit in a library interior" },
	{ slug: "welcome-light", alt: "Leo Sax на welcome-зоне мероприятия с саксофоном", altEn: "Leo Sax performing in an event welcome area" },
	{ slug: "burgundy-portrait", alt: "Саксофонист Лео сидит с саксофоном в бордовом пиджаке", altEn: "Seated portrait of Leo Sax in a burgundy jacket" },
	{ slug: "library-portrait", alt: "Портрет Leo Sax в тёмном костюме в библиотеке", altEn: "Portrait of Leo Sax in a dark suit in a library" }
] %}

{% set repertoire = [
	{ title: "Зарубежные", count: "45 треков", songs: [
		["Più che puoi","Eros Ramazzotti"],["Sway","Dean Martin"],["The Shadow of Your Smile","Johnny Mandel"],
		["Just the Two of Us","Grover Washington"],["Careless Whisper","George Michael"],["Black Orpheus","Jazz standard"],
		["Despacito","Luis Fonsi ft. Daddy Yankee"],["Lady","Modjo"],["Hallelujah","Alexandra Burke"],
		["My All","Mariah Carey"],["If I Ain’t Got You","Alicia Keys"],["Stand by Me","Ben E. King"],
		["It’s My Life (Latin Version)","Bon Jovi"],["You’ve Got a Friend","Carole King"],["Get Lucky","Daft Punk feat. Pharrell Williams"],
		["What a Wonderful World","Louis Armstrong"],["Can’t Take My Eyes Off You","Frankie Valli"],["Loving You","Kenny G"],
		["Die with a Smile","Bruno Mars, Lady Gaga"],["Flowers","Miley Cyrus"],["I’m Not the Only One","Sam Smith"],
		["Isn’t She Lovely","Jazz standard"],["Bésame Mucho",""] ,["The Moment","Kenny G"],
		["Paradise","Kenny G"],["Sunny","Boney M."],["Englishman in New York","Sting"],
		["Fly Me to the Moon","Julie London"],["The Chicken","Brian Bromberg"],["L-O-V-E","Nat King Cole"],
		["The Girl from Ipanema","Stan Getz"],["Heal the World","Michael Jackson"],["Just the Way You Are","Billy Joel"],
		["Don’t Know Why","Norah Jones"],["Easy","Lionel Richie"],["When I Need You","Celine Dion"],
		["Feelings","Morris Albert"],["The Door","Teddy Swims"],["Mirrors","Justin Timberlake"],
		["I Believe","Dave Koz"],["Easy on Me","Adele"],["I Will Survive","Gloria Gaynor"],
		["Shape of You (Club Version)","Ed Sheeran"],["Dance Monkey","Tones and I"],["Magic Moments","Perry Como"]
	] },
	{ title: "Отечественные", count: "25 треков", songs: [
		["Счастье","Алексей Чумаков"],["Я не могу без тебя","Алексей Чумаков"],["Сказка под дождём","Игорь Бутман"],
		["Я буду всегда с тобой","Леонид Агутин"],["Летний дождь","Леонид Агутин"],["With You","Егор Сесарев"],
		["Девочка, танцуй","Artik & Asti"],["Life","Zivert"],["С Днём рождения","Ирина Аллегрова"],
		["Ночь","Chebanov"],["Всё в твоих руках","Анжелика Варум, Леонид Агутин"],["Нарисовать мечту","Анастасия Иванова"],
		["Тут и там","Алексей Чумаков"],["Половина сердца","Маша Шейх, Ева Власова"],["Я — это ты","Мурат Насыров"],
		["Луч солнца золотого","Муслим Магомаев"],["Эта история","Шер Остон"],["Ветер перемен","Александр Панайотов"],
		["Я люблю тебя до слёз","Александр Серов"],["Есть только миг","Хор Турецкого"],["Моя","Ара Мартиросян"],
		["Куда уходит детство","ВИА «Сливки»"],["Полетели","Филипп Киркоров"],["Комета","Jony"],
		["А снег идёт","Кватро"]
	] }
] %}

<div class="leo">
	<section class="leo-hero" data-leo-hero aria-labelledby="leo-title">
		<div class="leo-hero__stage">
			<picture class="leo-hero__picture">
				<source media="(max-width: 700px)" type="image/avif" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-mobile-640.avif?v=3' | url }} 640w" sizes="100vw">
				<source media="(max-width: 700px)" type="image/webp" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-mobile-640.webp?v=3' | url }} 640w" sizes="100vw">
				<source type="image/avif" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-640.avif?v=3' | url }} 640w, {{ '/assets/leo-sax/hero/leo-sax-hero-1280.avif?v=3' | url }} 1280w, {{ '/assets/leo-sax/hero/leo-sax-hero-1672.avif?v=3' | url }} 1672w" sizes="100vw">
				<source type="image/webp" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-640.webp?v=3' | url }} 640w, {{ '/assets/leo-sax/hero/leo-sax-hero-1280.webp?v=3' | url }} 1280w, {{ '/assets/leo-sax/hero/leo-sax-hero-1672.webp?v=3' | url }} 1672w" sizes="100vw">
				<img class="leo-hero__image" src="{{ '/assets/leo-sax/hero/leo-sax-hero-1672.webp?v=3' | url }}" alt="{% if isEn %}Leo Sax performing live on stage{% else %}Leo Sax — саксофонист Лео на сцене с саксофоном{% endif %}" width="1672" height="941" fetchpriority="high" decoding="async">
			</picture>
			<video class="leo-player" data-leo-video playsinline preload="none" aria-label="{% if isEn %}Leo Sax promotional video{% else %}Промо-видео Leo Sax{% endif %}"></video>
		</div>
		<div class="leo-hero__shade" aria-hidden="true"></div>

		<div class="leo-crest">
			<header class="leo-wordmark">
				<h1 id="leo-title">LEO <span>SAX</span></h1>
			</header>
			<div class="leo-crest__mark" aria-hidden="true">
				<svg class="leo-crest__shield" viewBox="0 0 300 420" role="presentation" focusable="false">
					<path d="M150 18 280 66v142c0 88-51 153-130 200C71 361 20 296 20 208V66Z" />
				</svg>
				<img class="leo-emblem" src="{{ '/assets/leo-sax/leo-lion-sax-emblem.webp' | url }}" alt="" width="466" height="780" decoding="async">
			</div>
		</div>

		<button class="leo-play" type="button" data-leo-play aria-label="{% if isEn %}Watch the full Leo Sax promo{% else %}Смотреть полное промо Leo Sax{% endif %}">
			<span aria-hidden="true"></span>
		</button>

		<div class="leo-player-ui" data-player-ui aria-hidden="true" inert>
			<button class="leo-player-ui__close" type="button" data-video-close aria-label="{% if isEn %}Close video{% else %}Закрыть видео{% endif %}"></button>
			<div class="leo-player-ui__quality" role="group" aria-label="{% if isEn %}Video quality{% else %}Качество видео{% endif %}">
				<button type="button" data-video-quality="480">480p</button>
				<button type="button" data-video-quality="720">720p</button>
				<button type="button" data-video-quality="1080">1080p</button>
			</div>
			<div class="leo-player-ui__bar">
				<button class="leo-player-ui__toggle" type="button" data-video-toggle aria-label="{% if isEn %}Pause{% else %}Пауза{% endif %}"></button>
				<input class="leo-player-ui__progress" data-video-progress type="range" min="0" max="100" value="0" step="0.1" aria-label="{% if isEn %}Video position{% else %}Позиция видео{% endif %}">
				<span class="leo-player-ui__time" data-video-time>0:00 / 2:35</span>
				<button class="leo-player-ui__fullscreen" type="button" data-video-fullscreen aria-label="{% if isEn %}Full screen{% else %}На весь экран{% endif %}"></button>
			</div>
		</div>
		<p class="leo-player-status" data-player-status aria-live="polite"></p>
	</section>

	<section class="leo-gallery" aria-label="{% if isEn %}Leo Sax photos{% else %}Фотографии Leo Sax{% endif %}">
		<div class="leo-carousel" data-carousel>
			<button class="leo-carousel__arrow leo-carousel__arrow--prev" type="button" data-carousel-prev aria-label="{% if isEn %}Previous photo{% else %}Предыдущее фото{% endif %}"></button>
			<div class="leo-carousel__viewport" data-carousel-viewport tabindex="0" aria-label="{% if isEn %}Leo Sax photos{% else %}Фотографии Leo Sax{% endif %}">
				<div class="leo-carousel__track" data-carousel-track>
					{% for photo in gallery %}
					<figure class="leo-slide" data-carousel-slide data-slide-index="{{ loop.index0 }}">
						<picture>
							<source type="image/avif" srcset="{{ ('/assets/leo-sax/gallery/' + photo.slug + '-480.avif') | url }} 480w, {{ ('/assets/leo-sax/gallery/' + photo.slug + '-960.avif') | url }} 960w" sizes="(max-width: 700px) 78vw, 31vw">
							<source type="image/webp" srcset="{{ ('/assets/leo-sax/gallery/' + photo.slug + '-480.webp') | url }} 480w, {{ ('/assets/leo-sax/gallery/' + photo.slug + '-960.webp') | url }} 960w" sizes="(max-width: 700px) 78vw, 31vw">
							<img src="{{ ('/assets/leo-sax/gallery/' + photo.slug + '-960.webp') | url }}" alt="{% if isEn %}{{ photo.altEn }}{% else %}{{ photo.alt }}{% endif %}" width="960" height="1440" loading="lazy" decoding="async">
						</picture>
					</figure>
					{% endfor %}
				</div>
			</div>
			<button class="leo-carousel__arrow leo-carousel__arrow--next" type="button" data-carousel-next aria-label="{% if isEn %}Next photo{% else %}Следующее фото{% endif %}"></button>
		</div>
		<div class="leo-carousel__dots" data-carousel-dots aria-label="{% if isEn %}Photo gallery position{% else %}Позиция в фотогалерее{% endif %}">
			{% for photo in gallery %}<button type="button" data-carousel-dot="{{ loop.index0 }}" aria-label="{% if isEn %}Photo{% else %}Фото{% endif %} {{ loop.index }}"{% if loop.first %} class="is-active" aria-current="true"{% endif %}></button>{% endfor %}
		</div>
	</section>

	<section class="leo-moments" aria-labelledby="leo-moments-title">
		<div class="leo-wrap">
			<div class="leo-section-head">
				<p class="leo-kicker">{% if isEn %}Occasions{% else %}Сценарий{% endif %}</p>
				<h2 id="leo-moments-title">{% if isEn %}Where saxophone<br><em>belongs naturally.</em>{% else %}Где саксофон<br><em>звучит уместно.</em>{% endif %}</h2>
			</div>
			<div class="leo-moments__grid">
				<article><span>01</span><h3>Welcome</h3><p>{% if isEn %}First meetings, clinking glasses — and the evening already has a sound.{% else %}Первые встречи, звон бокалов — и вечер уже звучит.{% endif %}</p></article>
				<article><span>02</span><h3>{% if isEn %}Ceremony{% else %}Церемония{% endif %}</h3><p>{% if isEn %}The melody carries the key moment without taking it over.{% else %}Мелодия ведёт к главному моменту, не забирая его себе.{% endif %}</p></article>
				<article><span>03</span><h3>{% if isEn %}Dinner{% else %}Ужин{% endif %}</h3><p>{% if isEn %}Warm jazz, soul and bossa nova stay comfortably alongside conversation.{% else %}Тёплый jazz, soul и bossa nova остаются рядом с разговорами.{% endif %}</p></article>
				<article><span>04</span><h3>{% if isEn %}Party{% else %}Вечеринка{% endif %}</h3><p>{% if isEn %}Sax &amp; DJ gives the dancefloor rhythm and a live pulse.{% else %}Sax &amp; DJ добавляет танцполу ритм и живое дыхание.{% endif %}</p></article>
			</div>
		</div>
	</section>

	<section class="leo-repertoire" aria-labelledby="leo-repertoire-title">
		<div class="leo-wrap">
			<div class="leo-section-head leo-section-head--rep">
				<p class="leo-kicker">{% if isEn %}Repertoire{% else %}Репертуар{% endif %}</p>
				<h2 id="leo-repertoire-title">{% if isEn %}Music follows<br><em>the rhythm of the event.</em>{% else %}Музыка следует<br><em>ритму события.</em>{% endif %}</h2>
				<p class="leo-repertoire__lead">{% if isEn %}From the breath of jazz to a light pop motif, the program shifts the mood smoothly and without unnecessary words.{% else %}От дыхания джаза до лёгкого поп-мотива — программа меняет настроение мягко, без лишних слов.{% endif %}</p>
			</div>
			<div class="leo-repertoire__groups">
				{% for group in repertoire %}
				<details class="leo-repertoire__group">
					<summary><span>{% if isEn %}{% if loop.first %}International{% else %}Russian-Language{% endif %}{% else %}{{ group.title }}{% endif %}</span><small>{% if isEn %}{{ group.songs | length }} tracks{% else %}{{ group.count }}{% endif %}</small><i aria-hidden="true"></i></summary>
					<ul>
						{% for song in group.songs %}<li><strong>{{ song[0] }}</strong>{% if song[1] %}<span>{{ song[1] }}</span>{% endif %}</li>{% endfor %}
					</ul>
				</details>
				{% endfor %}
			</div>
		</div>
	</section>
</div>
