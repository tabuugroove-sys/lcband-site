---
pagination:
  data: events
  size: 1
  alias: event
permalink: "/events/{{ event.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ event.title }} — кавер-группа в Москве · {{ site.shortName }}"
  description: "{{ event.lead }}"
  keywords: "{{ event.keywords }}"
---

{% block schema %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "MusicGroup",
			"@id": "{{ site.url }}/#musicgroup",
			"name": "{{ site.name }}",
			"url": "{{ site.url }}"
		},
		{
			"@type": "Service",
			"@id": "{{ site.url }}{{ page.url }}#service",
			"name": "{{ event.title }} — {{ site.name }}",
			"description": "{{ event.lead }}",
			"serviceType": "Живая музыка и кавер-группа на мероприятие",
			"provider": { "@id": "{{ site.url }}/#musicgroup" },
			"areaServed": ["Москва", "Россия", "Международные туры"],
			"url": "{{ site.url }}{{ page.url }}"
		}
		,
		{
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "{{ site.shortName }}", "item": "{{ site.url }}/" },
				{ "@type": "ListItem", "position": 2, "name": "События", "item": "{{ site.url }}/events/" },
				{ "@type": "ListItem", "position": 3, "name": {{ event.title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
			]
		}
		{% if event.faq %},
		{
			"@type": "FAQPage",
			"@id": "{{ site.url }}{{ page.url }}#faq",
			"mainEntity": [
				{%- for item in event.faq %}
				{ "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}
				{%- endfor %}
			]
		}
		{% endif %}
		{% if event.featuredVideo %},
		{
			"@type": "VideoObject",
			"@id": "{{ site.url }}{{ page.url }}#video-{{ event.featuredVideo }}",
			"name": "{{ event.title }} — видео {{ site.name }}",
			"description": "{{ event.lead }}",
			"thumbnailUrl": "{{ site.url }}/assets/video/posters/{{ event.featuredVideo }}.jpg",
			"contentUrl": "{{ site.url }}/assets/video/mp4/{{ event.featuredVideo }}-720.mp4",
			"embedUrl": "{{ site.url }}{{ page.url }}",
			"uploadDate": "2026-06-18",
			"publisher": { "@id": "{{ site.url }}/#musicgroup" }
		}
		{% endif %}
	]
}
</script>
{% endblock %}

<section class="page-hero">
	<div class="container container--narrow">
		<p class="page-hero__breadcrumb">
			<a href="{{ '/' | url }}">{{ site.shortName }}</a> <span>·</span>
			<a href="{{ '/events/' | url }}">События</a> <span>·</span>
			<span>{{ event.title }}</span>
		</p>
		<p class="page-hero__eyebrow">{{ event.eyebrow }}</p>
		<h1 class="page-hero__title">{{ event.headline }}</h1>
		<p class="page-hero__lead">{{ event.lead }}</p>
	</div>
</section>

<section class="section section--flush">
	<div class="container reveal">
		<div class="stats">
			<div class="stat"><div class="stat__num">{{ site.stats.shows }}</div><div class="stat__label">выступлений</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.countries }}</div><div class="stat__label">стран</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.years }}</div><div class="stat__label">лет на сцене</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.songs }}</div><div class="stat__label">песен в репертуаре</div></div>
		</div>
		{% if event.trustLine %}<p class="trust-line">{{ event.trustLine }}</p>{% endif %}
	</div>
</section>

<section class="section section--light">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Как строится</p>
		<h2 class="section__title">Структура<br><span class="muted">программы.</span></h2>
	</div>
</section>

{% for b in event.blocks %}
<section class="feature-block feature-block--{% if loop.index0 % 2 == 0 %}light{% else %}elev{% endif %}{% if loop.index0 % 2 == 1 %} feature-block--reverse{% endif %}">
	<div class="feature-block__inner reveal">
		{% if b.image %}
			{% if b.video %}
			<a class="feature-block__media feature-block__media--video video-card" href="#" data-video="{{ b.video }}" aria-label="Смотреть видео {{ b.title }}">
				<img src="{{ ('/assets/photos/' + b.image) | url }}" alt="{{ b.imageAlt or (b.title + ' — ' + event.title) }}" loading="lazy">
				<span class="video-card__play" aria-hidden="true"></span>
			</a>
			{% else %}
			<div class="feature-block__media">
				<img src="{{ ('/assets/photos/' + b.image) | url }}" alt="{{ b.imageAlt or (b.title + ' — ' + event.title) }}" loading="lazy">
			</div>
			{% endif %}
		{% endif %}
		<div class="feature-block__body">
			<h3 class="feature-block__title">{{ b.title }}</h3>
			<p class="feature-block__text">{{ b.text }}</p>
		</div>
	</div>
</section>
{% endfor %}

{% if event.featuredVideo %}
<section class="section section--elev">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Видео</p>
		<h2 class="section__title">Как это<br><span class="muted">выглядит.</span></h2>
	</div>
	<div class="container reveal">
		<div class="featured-video">
			<a class="video-card video-card--wide" href="#" data-video="{{ event.featuredVideo }}">
				<img src="{{ ('/assets/video/posters/' + event.featuredVideo + '.jpg') | url }}" alt="{{ event.title }} — видео" loading="lazy">
				<span class="video-card__play" aria-hidden="true"></span>
			</a>
		</div>
	</div>
</section>
{% endif %}

{% if event.slug == 'corporate' %}
<section class="section section--light" id="formats">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Форматы работы</p>
		<h2 class="section__title">Одна команда —<br><span class="muted">четыре роли.</span></h2>
		<p class="section__lead">Мы не просто играем концерт. Мы встраиваемся в формат события — от хоровой коллаборации до караоке-шоу с гостями.</p>
	</div>
	<div class="container reveal">
		<ul class="formats">
			{% for f in formats %}
			<li class="format">
				<a class="format__link" href="{{ ('/formats/' + f.slug + '/') | url }}">
					<div class="format__photo"><img src="{{ ('/' + f.poster) | url }}" alt="{{ f.title }} — формат LC Band" loading="lazy"></div>
					<div class="format__body">
						<span class="format__label">{{ f.eyebrow }}</span>
						<h3 class="format__title">{{ f.title }}</h3>
						<p class="format__text">{{ f.headline }}</p>
						<span class="format__more">Подробнее ›</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>
{% endif %}

{% if event.faq %}
<section class="section section--light" id="faq">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Вопросы</p>
		<h2 class="section__title">Частые<br><span class="muted">вопросы.</span></h2>
		<div class="faq">
			{% for item in event.faq %}
			<details class="faq__item"{% if loop.first %} open{% endif %}>
				<summary class="faq__q">{{ item.q }}</summary>
				<div class="faq__a"><p>{% set _ans = item.aHtml if item.aHtml else item.a %}{{ _ans | replace("Телеграм", '<a href="' + site.telegram + '">Телеграм</a>') | safe }}</p></div>
			</details>
			{% endfor %}
		</div>
	</div>
</section>
{% endif %}

<section class="section section--flush">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Ещё у нас</p>
		<ul class="related-links">
			<li><a href="{{ '/programs/' | url }}">Тематические программы</a></li>
			<li><a href="{{ '/repertoire/' | url }}">Репертуар — 500+ песен</a></li>
			<li><a href="{{ '/vocalists/' | url }}">Вокалисты</a></li>
			<li><a href="{{ '/formats/' | url }}">Форматы работы</a></li>
			<li><a href="{{ '/sax/' | url }}">Саксофонист</a></li>
		</ul>
	</div>
</section>

<section class="section section--book">
	<div class="container container--narrow reveal">
		<h2 class="section__title section__title--light">{{ event.cta }}.</h2>
		<div class="book__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Написать в Телеграм</a>
			<a class="btn btn--ghost-light" href="{{ '/events/' | url }}">Все события</a>
		</div>
	</div>
</section>
