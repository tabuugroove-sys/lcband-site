		<picture><source media="(max-width: 734px)" type="image/webp" sizes="100vw" srcset="{{ '/assets/hero/hero-bw-640.webp' | url }} 640w, {{ '/assets/hero/hero-bw-960.webp' | url }} 960w, {{ '/assets/hero/hero-bw-1280.webp' | url }} 1280w"><img class="hero__bg hero__bg--bw"             src="{{ '/assets/hero/hero-bw.jpg' | url }}"    alt="{{ site.name }} — إطلالة بالأبيض والأسود"  loading="lazy" data-hero-img="bw"></picture>
		<picture><source media="(max-width: 734px)" type="image/webp" sizes="100vw" srcset="{{ '/assets/hero/hero-gold-640.webp' | url }} 640w, {{ '/assets/hero/hero-gold-960.webp' | url }} 960w, {{ '/assets/hero/hero-gold-1280.webp' | url }} 1280w"><img class="hero__bg hero__bg--gold"           src="{{ '/assets/hero/hero-gold.jpg' | url }}"  alt="{{ site.name }} — إطلالة ذهبية على المسرح"  loading="lazy" data-hero-img="gold"></picture>
		<picture><source media="(max-width: 734px)" type="image/webp" sizes="100vw" srcset="{{ '/assets/hero/hero-white-640.webp' | url }} 640w, {{ '/assets/hero/hero-white-960.webp' | url }} 960w, {{ '/assets/hero/hero-white-1280.webp' | url }} 1280w"><img class="hero__bg hero__bg--white"          src="{{ '/assets/hero/hero-white.jpg' | url }}" alt="{{ site.name }} — إطلالة بيضاء على خلفية النجوم"  loading="lazy" data-hero-img="white"></picture>
		<video class="hero__video" data-hero-video playsinline preload="none"></video>
