<!-- =============== HERO (4-COLOR SWITCHABLE LINEUP + INLINE VIDEO) =============== -->
<section class="hero" data-hero>
	<div class="hero__stage">
		{#- Мобильный получает webp 640-1280w вместо 2400px jpg; eager — только
		    активный красный образ, остальные три lazy -#}
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-red-640.webp' | url }} 640w, {{ '/assets/hero/hero-red-960.webp' | url }} 960w, {{ '/assets/hero/hero-red-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--red is-active"  src="{{ '/assets/hero/hero-red.jpg' | url }}"   alt="{{ site.name }} — красный образ на LED-стене" loading="eager" fetchpriority="high" data-hero-img="red">
		</picture>
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-bw-640.webp' | url }} 640w, {{ '/assets/hero/hero-bw-960.webp' | url }} 960w, {{ '/assets/hero/hero-bw-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--bw"             src="{{ '/assets/hero/hero-bw.jpg' | url }}"    alt="{{ site.name }} — чёрно-белый образ"  loading="lazy" data-hero-img="bw">
		</picture>
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-gold-640.webp' | url }} 640w, {{ '/assets/hero/hero-gold-960.webp' | url }} 960w, {{ '/assets/hero/hero-gold-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--gold"           src="{{ '/assets/hero/hero-gold.jpg' | url }}"  alt="{{ site.name }} — золотой образ на сцене"       loading="lazy" data-hero-img="gold">
		</picture>
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-white-640.webp' | url }} 640w, {{ '/assets/hero/hero-white-960.webp' | url }} 960w, {{ '/assets/hero/hero-white-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--white"          src="{{ '/assets/hero/hero-white.jpg' | url }}" alt="{{ site.name }} — белый образ на звёздном фоне"  loading="lazy" data-hero-img="white">
		</picture>
		<video class="hero__video" data-hero-video playsinline preload="none"></video>
	</div>
	<div class="hero__scrim"></div>
	<button class="hero__play" data-hero-play type="button" aria-label="Смотреть видео в этих костюмах"></button>
	<button class="hero__close" data-hero-close type="button" aria-label="Закрыть видео"></button>
	<button class="hero__arrow hero__arrow--prev" data-hero-prev type="button" aria-label="Предыдущее видео"></button>
	<button class="hero__arrow hero__arrow--next" data-hero-next type="button" aria-label="Следующее видео"></button>
	<div class="hero__controls" data-hero-controls>
		<button class="hero__toggle" data-hero-toggle type="button" aria-label="Пауза"></button>
		<div class="hero__progress" data-hero-progress>
			<div class="hero__progress-filled" data-hero-progress-filled></div>
		</div>
		<span class="hero__time" data-hero-time>0:00 / 0:00</span>
	</div>
	<div class="hero__quality" data-hero-quality role="group" aria-label="Качество видео">
		<button type="button" data-hero-q="720">720p</button>
		<button type="button" data-hero-q="1080" class="is-active">1080p</button>
		<button type="button" data-hero-q="2160" hidden>4K</button>
	</div>
	<div class="hero__recommendations" data-hero-recommendations aria-hidden="true" aria-label="Смотреть дальше">
		<button class="hero-rec" type="button" data-hero-recommendation="0">
			<img class="hero-rec__poster" data-hero-rec-poster alt="" loading="eager">
			<span class="hero-rec__copy">
				<span class="hero-rec__costume" data-hero-rec-costume></span>
				<strong class="hero-rec__title" data-hero-rec-title></strong>
			</span>
			<span class="hero-rec__play" aria-hidden="true"></span>
		</button>
		<button class="hero-rec" type="button" data-hero-recommendation="1">
			<img class="hero-rec__poster" data-hero-rec-poster alt="" loading="eager">
			<span class="hero-rec__copy">
				<span class="hero-rec__costume" data-hero-rec-costume></span>
				<strong class="hero-rec__title" data-hero-rec-title></strong>
			</span>
			<span class="hero-rec__play" aria-hidden="true"></span>
		</button>
	</div>
	<div class="hero__content">
		<p class="hero__eyebrow">Интернациональная кавер-группа</p>
		<h1 class="hero__title">{{ site.name }}</h1>
		<div class="hero__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Написать в Телеграм</a>
		</div>
		<div class="hero__picker" role="tablist" aria-label="Выбор образа">
			<button class="hero__dot hero__dot--red is-active"  data-hero-dot="red"   role="tab" aria-label="Красный образ"       aria-selected="true"></button>
			<button class="hero__dot hero__dot--bw"             data-hero-dot="bw"    role="tab" aria-label="Чёрно-белый образ"  aria-selected="false"></button>
			<button class="hero__dot hero__dot--gold"           data-hero-dot="gold"  role="tab" aria-label="Золотой образ"      aria-selected="false"></button>
			<button class="hero__dot hero__dot--white"          data-hero-dot="white" role="tab" aria-label="Белый образ"        aria-selected="false"></button>
		</div>
	</div>
	<a class="hero__scroll" href="#about" aria-label="К описанию"><span></span></a>
</section>

<!-- =============== ABOUT / STATS =============== -->
<section class="section section--elev" id="about">
	<div class="container about-split reveal">
		<div class="about-split__media">
			<img src="{{ '/assets/photos/concert-10k.jpg' | url }}" alt="Luxury Cover Band на сцене — стадионная практика" loading="lazy">
		</div>
		<div class="about-split__body">
			<p class="section__eyebrow">О группе</p>
			<h2 class="section__title">Сцена мирового уровня.</h2>
			<p class="section__lead">2000+ выступлений в 40 странах. Стадионы, ТВ, топ-звёзды — теперь на вашем событии.</p>
			<div class="cta-row cta-row--left">
				<a class="btn btn--blue" href="{{ '/about/' | url }}">Узнать больше</a>
				<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Написать в Телеграм</a>
			</div>
		</div>
	</div>
	<div class="container reveal">
		{% set homeStats = [
			{num: site.stats.shows, label: 'выступлений'},
			{num: site.stats.countries, label: 'стран'},
			{num: site.stats.years, label: 'лет на сцене'},
			{num: site.stats.songs, label: 'песен в репертуаре', href: '/repertoire/'}
		] %}
		<ul class="highlight-stats">
			{% for s in homeStats %}
			<li class="highlight-stat highlight-stat--{{ ['a','b','c','d'][loop.index0 % 4] }}{% if s.href %} highlight-stat--linked{% endif %}">
				{% if s.href %}
				<a class="highlight-stat__link" href="{{ s.href | url }}">
					<div class="highlight-stat__num">{{ s.num }}</div>
					<div class="highlight-stat__label">{{ s.label }}</div>
				</a>
				{% else %}
				<div class="highlight-stat__num">{{ s.num }}</div>
				<div class="highlight-stat__label">{{ s.label }}</div>
				{% endif %}
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

<!-- =============== VOCALISTS (hero only — cards moved to /vocalists/) =============== -->
<section class="section section--light section--flush" id="vocalists">
	<div class="hero-banner hero-banner--bleed{% if tilesVariant == 'v4' %} hero-banner--v4{% endif %} reveal">
		{#- Мобильный: отдельный квадратный кроп (вокалисты крупно), не сжатый
		    широкий кадр. Десктоп: webp-варианты полного кадра. -#}
		<picture class="hero-banner__pic">
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/photos/vocalists-mobile-640.webp' | url }} 640w, {{ '/assets/photos/vocalists-mobile-960.webp' | url }} 960w">
			<source media="(max-width: 734px)" srcset="{{ '/assets/photos/vocalists-mobile.jpg' | url }}">
			<source type="image/webp" sizes="100vw"
				srcset="{{ '/assets/photos/vocalists-1280.webp' | url }} 1280w, {{ '/assets/photos/vocalists-1920.webp' | url }} 1920w, {{ '/assets/photos/vocalists-2600.webp' | url }} 2600w">
			<img class="hero-banner__img" src="{{ '/assets/photos/vocalists.jpg' | url }}" alt="Luxury Cover Band — четыре вокалиста, студийная съёмка" loading="lazy">
		</picture>
		<div class="hero-banner__overlay">
			<p class="section__eyebrow">Вокалисты</p>
			<h2 class="section__title">Четыре голоса.<br><span class="muted">Четыре характера.</span></h2>
			<p class="section__lead">Каждый ведёт свою часть программы. Комбинируем в дуэтах, трио и квартетах под задачу ивента.</p>
			<div class="cta-row">
				<a class="btn btn--blue" href="{{ '/vocalists/' | url }}">Узнать больше</a>
				<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Написать в Телеграм</a>
			</div>
		</div>
	</div>
</section>

