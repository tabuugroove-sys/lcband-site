---
pagination:
  data: programs
  size: 1
  alias: program
permalink: "/programs/{{ program.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ program.seoTitle or (program.title + ' — ' + site.shortName) }}"
  description: "{{ program.seoDescription or program.lead }}"
  keywords: "{{ program.keywords }}"
  ogImage: "{{ program.poster }}"
---

{% block schema %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "MusicGroup",
			"@id": "{{ site.url }}/#musicgroup",
			"name": "{{ site.name }}",
			"url": "{{ site.url }}"
		},
		{
			"@type": "Service",
			"@id": "{{ site.url }}{{ page.url }}#service",
			"name": "{{ program.title }}",
			"description": "{{ program.lead }}",
			"serviceType": "Тематическая программа кавер-группы",
			"provider": { "@id": "{{ site.url }}/#musicgroup" },
			"areaServed": ["Москва", "Россия", "Международные туры"],
			"url": "{{ site.url }}{{ page.url }}"
		}
		{% for item in program.videos %},
		{
			"@type": "VideoObject",
			"@id": "{{ site.url }}{{ page.url }}#video-{{ item.slug }}",
			"name": "{{ item.title }} — {{ program.title }}",
			"description": "{{ program.lead }}",
			"thumbnailUrl": "{{ site.url }}/{{ item.poster }}",
			"contentUrl": "{{ site.url }}/assets/video/mp4/{{ item.slug }}-720.mp4",
			"embedUrl": "{{ site.url }}{{ page.url }}",
			"uploadDate": "2026-06-18",
			"publisher": { "@id": "{{ site.url }}/#musicgroup" }
		}
		{% endfor %}
		{% if program.faq %},
		{
			"@type": "FAQPage",
			"@id": "{{ site.url }}{{ page.url }}#faq",
			"mainEntity": [
				{%- for item in program.faq %}
				{ "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}
				{%- endfor %}
			]
		}
		{% endif %}
	]
}
</script>
{% endblock %}

<section class="page-hero{% if program.slug == 'latin' %} page-hero--spanish-promo{% endif %}">
	<div class="container container--narrow">
		<p class="page-hero__breadcrumb">
			<a href="{{ '/' | url }}">{{ site.shortName }}</a> <span>·</span>
			<a href="{{ '/programs/' | url }}">Тематические программы</a> <span>·</span>
			<span>{{ program.label }}</span>
		</p>
		{% if program.slug != 'latin' %}
			<p class="page-hero__eyebrow">{{ program.eyebrow }}</p>
			<h1 class="page-hero__title">{{ program.headline }}</h1>
			<p class="page-hero__lead">{{ program.lead }}</p>
		{% endif %}
	</div>
	{% if program.slug == 'latin' %}
	<div class="spanish-promo">
		<div class="spanish-promo__visual" aria-hidden="true">
			<div class="spanish-promo__card">
				<img class="spanish-promo__lights" src="{{ '/assets/photos/spanish-hero/lights-overlay.png?v=2' | url }}" alt="" loading="lazy" decoding="async">
				<p class="spanish-promo__card-title">Macarena<br>Despacito<br>Bailando</p>
			</div>
			<img class="spanish-promo__orb spanish-promo__orb--one" src="{{ '/assets/photos/spanish-hero/teddy-white.jpg' | url }}" alt="" loading="eager">
			<img class="spanish-promo__orb spanish-promo__orb--two" src="{{ '/assets/photos/spanish-hero/latin-duo.jpg' | url }}" alt="" loading="eager">
			<img class="spanish-promo__orb spanish-promo__orb--three" src="{{ '/assets/photos/spanish-hero/teddy-latina.jpg' | url }}" alt="" loading="eager">
		</div>
		<div class="spanish-promo__copy">
			<p class="spanish-promo__eyebrow">{{ program.eyebrow }}</p>
			<h1 class="spanish-promo__title">{{ program.headline }}</h1>
			<p class="spanish-promo__lead">{{ program.lead }}</p>
		</div>
	</div>
	{% elif program.poster %}
	<div class="page-hero__media">
		<img src="{{ ('/' + program.poster) | url }}" alt="{{ program.title }} — Luxury Cover Band" loading="eager">
		{% if program.video %}
		<a class="page-hero__play" href="#" data-video="{{ program.video }}" aria-label="Смотреть видео"><span></span></a>
		{% endif %}
	</div>
	{% endif %}
</section>

{% if program.videos and not program.hideVideoCarousel %}
<section class="section section--light program-video-carousel">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Видео</p>
		<h2 class="section__title">{{ program.title }}<br><span class="muted">в живом формате.</span></h2>
		<p class="section__lead">{% if program.slug == 'rock' %}Ниже обычные записи наших концертов и клип Let's Get It Started, по ним видно состав и как мы держимся на сцене. Если вам нужна конкретная рок-песня, попросите, и мы пришлём, как она звучит у нас.{% else %}{{ program.videoLead or "Несколько фрагментов программы — live-выступления и клипы, чтобы быстро показать настроение этого блока." }}{% endif %}</p>
	</div>
	<div class="video-rail video-rail--big video-rail--program reveal" role="region" aria-label="Видео {{ program.title }}">
		<ul class="video-rail__track">
		{% for item in program.videos %}
		<li class="vtile vtile--big">
			<a class="vtile__link" href="#" data-video="{{ item.slug }}">
				<img class="vtile__poster" src="{{ ('/' + item.poster) | url }}?v=20260623a" alt="{{ item.title }} — {{ program.title }}" loading="lazy">
				<span class="vtile__play" aria-hidden="true"></span>
				<div class="vtile__caption">
					<span class="vtile__eyebrow">{{ item.label }}</span>
					<span class="vtile__title">{{ item.title }}</span>
				</div>
			</a>
		</li>
		{% endfor %}
		</ul>
	</div>
</section>
{% endif %}

{% if program.photos %}
<section class="section section--light program-photos-section">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Фото</p>
		<h2 class="section__title">Атмосфера<br><span class="muted">проекта.</span></h2>
	</div>
	<div class="container reveal">
		<ul class="program-photos">
			{% for ph in program.photos %}
			<li class="program-photos__item">
				<img src="{{ ('/' + ph.src) | url }}" alt="{{ ph.alt }}" loading="lazy" decoding="async">
			</li>
			{% endfor %}
		</ul>
	</div>
	{% if program.promoUrl %}
	<div class="container container--narrow reveal program-promo-cta">
		<a class="btn btn--ghost-dark" href="{{ program.promoUrl }}" target="_blank" rel="noopener">⬇ {{ program.promoLabel or "Скачать промо (Google Drive)" }}</a>
	</div>
	{% endif %}
</section>
{% endif %}

{% if program.slug == 'jazz' and jazzRepertoire %}
<!-- =============== JAZZ REPERTOIRE (Old Money Band, из официального PDF) =============== -->
<section class="section section--elev rep-section" id="repertoire">
	<div class="container reveal">
		<div class="container--narrow rep-head">
			<p class="section__eyebrow">Репертуар</p>
			<h2 class="section__title">{{ jazzRepertoire.total }}+ песен.<br><span class="muted">От Синатры до Земфиры.</span></h2>
			<p class="section__lead">Это репертуар Old Money Band. Нужной песни нет? Пришлите название или ссылку, скажем, сможем ли подготовить и к какому сроку.</p>
			<div class="rep-filter">
				<input class="rep-filter__input" type="search" placeholder="Найти песню или артиста…" data-rep-input aria-label="Найти песню в репертуаре Old Money Band">
			</div>
		</div>
		<div class="rep-groups" data-rep-groups>
			{% for g in jazzRepertoire.groups %}
			<details class="rep-group" data-rep-group{% if loop.first %} open{% endif %}>
				<summary class="rep-group__summary">
					<span class="rep-group__index">0{{ loop.index }}</span>
					<span class="rep-group__heading">
						<span class="rep-group__title">{{ g.title }}</span>
						<span class="rep-group__note">{{ g.note }}</span>
					</span>
					<span class="rep-group__count" data-rep-count>{{ g.songs | length }}</span>
				</summary>
				<ul class="rep-group__list">
					{% for s in g.songs %}<li class="rep-group__song">{{ s }}</li>
					{% endfor %}
				</ul>
			</details>
			{% endfor %}
			<p class="rep-empty" data-rep-empty hidden>Такой песни в списке нет. Напишите нам в Телеграм, обсудим, сможем ли её подготовить.</p>
		</div>
	</div>
</section>
{% endif %}

<section class="section section--light">
	<div class="container container--narrow reveal">
		<h2 class="section__title">Что входит<br><span class="muted{% if program.slug == 'latin' %} muted--spanish-gradient{% endif %}">в программу.</span></h2>
		<ul class="bullets">
			{% for b in program.bullets %}
			<li class="bullet">
				<span class="bullet__check">✓</span>
				<span class="bullet__text">{{ b }}</span>
			</li>
			{% endfor %}
		</ul>
		{% if program.slug == 'italian' %}<p class="section__lead">В нашем <a class="evidence-link" href="{{ '/repertoire/' | url }}">репертуаре</a> есть поиск, отметьте песни, которые знаете. Если хотите новую, скажем, успеем ли к вашей дате. Состав, звук и время саундчека сверяем по <a class="evidence-link" href="{{ '/riders/' | url }}">техническому райдеру</a>.</p>{% endif %}
	</div>
</section>

{% if program.faq %}
<section class="section section--light" id="faq">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Вопросы</p>
		<h2 class="section__title">{{ program.title }}:<br><span class="muted">частые вопросы.</span></h2>
		<div class="faq">
			{% for item in program.faq %}
			<details class="faq__item">
				<summary class="faq__q">{{ item.q }}</summary>
				<div class="faq__a"><p>{% set _ans = item.aHtml if item.aHtml else item.a %}{{ _ans | replace("Телеграм", '<a href="' + site.telegram + '">Телеграм</a>') | safe }}</p></div>
			</details>
			{% endfor %}
		</div>
	</div>
</section>
{% endif %}

<section class="section section--elev">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Варианты</p>
		<h2 class="section__title">Другие тематические программы.</h2>
		<p class="section__lead">Несколько программ можно смешать в один вечер. Песни, состав и длительность подберём вместе.</p>
	</div>
	<div class="container reveal">
		<ul class="caps">
			{% for p in programs %}
				{% if p.slug != program.slug %}
				<li class="cap cap--cover">
					<a class="cap__link" href="{{ ('/programs/' + p.slug + '/') | url }}">
						<div class="cap__photo"><img src="{{ ('/' + p.poster) | url }}" alt="{{ p.title }} — LC Band" loading="lazy"></div>
						<div class="cap__overlay">
							<h3 class="cap__title">{{ p.title }}</h3>
						</div>
					</a>
				</li>
				{% endif %}
			{% endfor %}
		</ul>
	</div>
</section>

<section class="section section--book">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Бронирование</p>
		{% set bookingTitles = {italian: 'Обсудить итальянскую программу.', french: 'Обсудить французскую программу.', latin: 'Обсудить латиноамериканское шоу.', retro: 'Обсудить ретропрограмму.', jazz: 'Обсудить выступление Old Money Band.', rock: 'Обсудить рок-программу.'} %}
		<h2 class="section__title">{{ bookingTitles[program.slug] or 'Обсудить программу.' }}</h2>
		<p class="section__lead">Напишите дату, место и что за праздник, предложим состав и пришлём расписание.</p>
		<div class="book__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Написать в Телеграм</a>
			<a class="btn btn--ghost-dark" href="{{ '/programs/' | url }}">Все тематические программы</a>
		</div>
	</div>
</section>
