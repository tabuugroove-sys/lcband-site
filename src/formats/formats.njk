---
pagination:
  data: formats
  size: 1
  alias: format
permalink: "/formats/{{ format.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ format.title }} — {{ site.shortName }}"
  description: "{{ format.metaDescription or format.lead }}"
  keywords: "{{ format.keywords }}"
---

<section class="page-hero">
	<div class="container container--narrow">
		<p class="page-hero__breadcrumb">
			<a href="{{ '/' | url }}">{{ site.shortName }}</a> <span>·</span>
			<a href="{{ '/formats/' | url }}">Форматы</a> <span>·</span>
			<span>{{ format.title }}</span>
		</p>
		<p class="page-hero__eyebrow">{{ format.eyebrow }}</p>
		<h1 class="page-hero__title">{{ format.headline }}</h1>
		<p class="page-hero__lead">{{ format.lead }}</p>
	</div>
</section>

{% if format.heroAlt %}
<div class="page-hero__media reveal">
	<img src="{{ ('/' + format.poster) | url }}" alt="{{ format.heroAlt }}" width="1600" height="900" fetchpriority="high" decoding="async">
</div>
{% endif %}

<section class="section section--light">
	<div class="container container--narrow reveal">
		<h2 class="section__title">Что входит<br><span class="muted">в формат.</span></h2>
		<ul class="bullets">
			{% for b in format.bullets %}
			<li class="bullet">
				<span class="bullet__check">✓</span>
				<span class="bullet__text">{{ b }}</span>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

{% if format.artist %}
<section class="section section--dark format-artist">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow section__eyebrow--light">Основной артист</p>
		<h2 class="section__title section__title--light">{{ format.artist.name }}<br><span class="muted">{{ format.artist.role }}.</span></h2>
		<p class="format-artist__lead">{{ format.artist.lead }}</p>
		<p class="format-artist__price">{{ format.artist.price }}</p>
		<div class="format-artist__materials" aria-label="Промо и коммерческое предложение Юрия Шурховецкого">
			{% for item in format.artist.materials %}
			<a class="btn{% if loop.first %} btn--primary{% else %} btn--ghost-light{% endif %}" href="{{ item.url | url }}"{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}{% if item.download %} download{% endif %}>{{ item.label }}</a>
			{% endfor %}
		</div>
	</div>
</section>
{% endif %}

<section class="section section--book">
	<div class="container container--narrow reveal">
		<h2 class="section__title section__title--light">{{ format.cta }}.</h2>
		<div class="book__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Написать в Телеграм</a>
			<a class="btn btn--ghost-light" href="{{ '/formats/' | url }}">Все форматы</a>
		</div>
	</div>
</section>
