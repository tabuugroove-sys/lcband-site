.sx-btn--accent { color:#0a0a0a; background:#c69a4e; }
.sx-btn--glass { color:#fafafa; font-weight:500; background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.28); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); }
.sx-btn--dark { color:#1d1d1f; font-weight:500; background:rgba(0,0,0,0.05); border:1px solid rgba(0,0,0,0.16); }

