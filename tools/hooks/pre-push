#!/usr/bin/env bash
# =============================================================================
# pre-push — non-blocking REMINDER for lcband-site (shared by all agents).
# Enabled via:  git config core.hooksPath tools/hooks
#
# It does NOT block pushes. It only reminds you when origin/main has advanced
# past your local HEAD — the situation where you might be building on a stale
# base. The fix is always: git pull --ff-only, re-read live state, continue.
# (Git itself still rejects genuine non-fast-forward pushes — that's git, not us.)
# =============================================================================
set -uo pipefail

git fetch -q origin main 2>/dev/null || exit 0

behind="$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
if [ "${behind:-0}" != "0" ]; then
  echo "⚠️  pre-push reminder: origin/main is $behind commit(s) ahead of your HEAD."
  echo "    Another agent worked after you. Recommended before continuing:"
  echo "      git pull --ff-only && tools/agent-gate.sh live-posters"
  echo "    (reminder only — push is NOT blocked)"
fi
exit 0
