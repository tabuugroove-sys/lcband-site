# luxuryband.ru — канонизация хоста и устранение дублей (SEO)
# Управляется из git (src/.htaccess → passthrough → public_html). Не править на сервере вручную.

RewriteEngine On

# 1) www → без www, сразу на https (один 301, без http-хопа)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 2) http → https (для не-www запросов)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3) /index.html → /  (корень и любые подпапки) — убирает дубль главной и вложенных
RewriteCond %{THE_REQUEST} \s/+(([^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# 4) сырой ассет старого репертуара → нормальная страница /repertoire/
RewriteRule ^assets/repertoire/index\.html$ /repertoire/ [L,R=301]
