			<div class="stat"><div class="stat__num">{{ site.stats.years }}</div><div class="stat__label">عامًا على المسرح</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.songs }}</div><div class="stat__label">أغنية في الريبرتوار</div></div>
		</div>
	</div>
</section>

