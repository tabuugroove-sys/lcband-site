<section class="section section--flush">
	<div class="container reveal">
		{% set aboutStats = [
			{num: site.stats.shows, label: 'выступлений'},
			{num: site.stats.countries, label: 'стран'},
			{num: site.stats.years, label: 'лет на сцене'},
			{num: site.stats.tvShows, label: 'ТВ-проектов'},
			{num: site.stats.songs, label: 'песен в репертуаре'},
			{num: site.stats.languages, label: 'языков'},
			{num: site.stats.looks, label: 'сценических образов', href: '/costumes/'},
			{num: site.stats.lineup, label: 'музыкантов на сцене'}
		] %}
		<ul class="highlight-stats">
			{% for s in aboutStats %}
			<li class="highlight-stat highlight-stat--{{ ['a','b','c','d'][loop.index0 % 4] }}{% if s.href %} highlight-stat--linked{% endif %}">
				{% if s.href %}
				<a class="highlight-stat__link" href="{{ s.href | url }}">
					<div class="highlight-stat__num">{{ s.num }}</div>
					<div class="highlight-stat__label">{{ s.label }}</div>
				</a>
				{% else %}
				<div class="highlight-stat__num">{{ s.num }}</div>
				<div class="highlight-stat__label">{{ s.label }}</div>
				{% endif %}
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

