{#- Блок цифр «вариант F1» (выбран Михаилом 28.10.2026): одна большая цифра
    в градиенте с досчётом при появлении, под ней строкой остальные цифры.
    Решение Михаила 29.10: чёрный на всех страницах (28.10 главные были белыми).
    Параметры перед include:
      countTheme     — 'dark' (чёрный фон, по умолчанию) | 'light' (белый фон)
      countLang      — 'ru' (по умолчанию) | 'en' | 'pt' | 'ar'
      countSongsHref — ссылка у «песен» (необязательно)
      countLooksHref — ссылка у «сценических образов» (необязательно)
      countNote      — строка мелким текстом под цифрами (необязательно)
    Подпись под большой цифрой — как на apple.com/apple-music: первая фраза
    светлая, продолжение серым тем же кеглем, каждая фраза своей строкой;
    &nbsp; держит «в 40 странах» и не оставляет предлог в конце строки.
    Для pt/ar только подписи, которые уже были на этих страницах (без новых
    переводов). Цифры — из site.stats; досчёт берёт итог из текста, поэтому
    правка site.json сохраняет анимацию. Без JS и при reduced-motion — итог. -#}
{%- set st = site.stats %}
{%- set countDict = {
	ru: {
		aria: 'Luxury Cover Band в цифрах',
		lead: 'выступлений в&nbsp;' ~ st.countries ~ '&nbsp;странах,',
		more: 'от свадеб до&nbsp;приёмов первых&nbsp;лиц.',
		minis: [
			{num: st.years, label: 'лет на сцене', icon: 'years'},
			{num: st.tvShows, label: 'ТВ-проектов', icon: 'tv'},
			{num: st.songs, label: 'песен', href: countSongsHref, icon: 'songs'},
			{num: st.languages, label: 'языков', icon: 'languages'},
			{num: st.looks, label: 'сценических образов', href: countLooksHref, icon: 'looks'},
			{num: st.lineup, label: 'музыкантов на сцене', icon: 'lineup'}
		]
	},
	en: {
		aria: 'Luxury Cover Band in numbers',
		lead: 'performances in&nbsp;' ~ st.countries ~ '&nbsp;countries.',
		more: 'From weddings to receptions for heads&nbsp;of&nbsp;state.',
		minis: [
			{num: st.years, label: 'years on stage', icon: 'years'},
			{num: st.tvShows, label: 'TV projects', icon: 'tv'},
			{num: st.songs, label: 'songs', href: countSongsHref, icon: 'songs'},
			{num: st.languages, label: 'languages', icon: 'languages'},
			{num: st.looks, label: 'stage looks', href: countLooksHref, icon: 'looks'},
			{num: st.lineup, label: 'musicians on stage', icon: 'lineup'}
		]
	},
	pt: {
		aria: 'Luxury Cover Band',
		lead: 'shows em&nbsp;' ~ st.countries ~ '&nbsp;países',
		minis: [
			{num: st.years, label: 'anos de palco', icon: 'years'},
			{num: st.songs, label: 'músicas no repertório', href: countSongsHref, icon: 'songs'}
		]
	},
	ar: {
		aria: 'Luxury Cover Band',
		lead: 'عرض في&nbsp;' ~ st.countries ~ '&nbsp;دولة',
		minis: [
			{num: st.years, label: 'عامًا على المسرح', icon: 'years'},
			{num: st.songs, label: 'أغنية في الريبرتوار', href: countSongsHref, icon: 'songs'}
		]
	}
} %}
{%- set countText = countDict[countLang or 'ru'] %}
<link rel="stylesheet" href="{{ '/stat-icons.css?v=20261030views1' | url }}">
<section id="band-in-numbers" class="about-count{% if countTheme == 'light' %} about-count--light{% endif %}" data-count-block aria-label="{{ countText.aria }}">
	{#- Михаил 30.10: кольца звука вокруг «2000+», как в шапке apple.com/apple-music — толстые,
	    переливаются, обходят текст слева и справа и откликаются на мышь. Рисует main.js. -#}
	<canvas class="about-count__rings" data-count-rings aria-hidden="true"></canvas>
	<div class="about-count__inner">
		<p class="about-count__hero" dir="ltr" data-count>{{ st.shows }}</p>
		<p class="about-count__sub"><span class="about-count__lead">{{ countText.lead | safe }}</span>{% if countText.more %} <span class="about-count__more">{{ countText.more | safe }}</span>{% endif %}</p>
		<ul class="about-count__minis">
			{% for s in countText.minis %}
			<li class="about-count__mini">
				{% if s.href %}<a href="{{ s.href | url }}">{% endif %}
				<span class="about-count__n" dir="ltr" data-count>{{ s.num }}</span>
				<span class="about-count__l">{{ s.label }}</span>
				<span class="stat-icon" data-stat-icon="{{ s.icon }}" aria-hidden="true">
					<span class="stat-icon__stage">
						<span class="stat-icon__frame stat-icon__frame--center"><img src="{{ ('/assets/icons/stats/' ~ s.icon ~ '-20261030.webp') | url }}" width="768" height="256" loading="lazy" decoding="async" alt="" draggable="false"></span>
					</span>
				</span>
				{% if s.href %}</a>{% endif %}
			</li>
			{% endfor %}
		</ul>
		{% if countNote %}<p class="about-count__note">{{ countNote }}</p>{% endif %}
	</div>
</section>
<script src="{{ '/stat-icons.js?v=20261030views1' | url }}" defer></script>
<script>
(function () {
	// Досчёт цифр при появлении блока: все числа в тексте элемента (и обе
	// границы диапазона «15–20») растут от нуля, в конце — исходный текст.
	if (!('IntersectionObserver' in window)) return;
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
	function run(el) {
		var source = el.textContent, nums = source.match(/\d+/g), start = null;
		if (!nums) return;
		function tick(now) {
			if (start === null) start = now;
			var p = Math.min(1, (now - start) / 1200), e = 1 - Math.pow(1 - p, 3), i = 0;
			el.textContent = source.replace(/\d+/g, function () { return String(Math.round(Number(nums[i++]) * e)); });
			if (p < 1) requestAnimationFrame(tick); else el.textContent = source;
		}
		requestAnimationFrame(tick);
	}
	Array.prototype.forEach.call(document.querySelectorAll('[data-count-block]'), function (block) {
		if (block.hasAttribute('data-count-wired')) return;
		block.setAttribute('data-count-wired', '');
		var io = new IntersectionObserver(function (entries) {
			if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
			io.disconnect();
			Array.prototype.forEach.call(block.querySelectorAll('[data-count]'), run);
		}, { threshold: 0.25 });
		io.observe(block);
	});
})();
</script>
