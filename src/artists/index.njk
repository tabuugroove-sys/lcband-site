---
layout: layouts/base.njk
title: Авторская музыка артистов Luxury Cover Band
description: "LAZ, Teddy afro vocal и Stas: авторские релизы артистов Luxury Cover Band с плеерами, которые открываются прямо на странице."
keywords: "LAZ Marry, Teddy afro vocal Bloquia, Stas Zace, слушать артистов Luxury Cover Band"
permalink: /artists/
---

{% set artists = [
	{
		name: "LAZ",
		release: "Marry",
		role: "Вокалист Luxury Cover Band",
		copy: "Мягкий pop/R&B-релиз с камерной подачей и фирменной вокальной пластикой LAZ.",
		cover: "https://linkstorage.linkfire.com/medialinks/images/b845922e-2c60-463b-8411-3e7077c4e1dd/artwork-440x440.jpg",
		player: "https://open.spotify.com/embed/album/2FqQqaPYka6OceufGLPIP0?utm_source=generator&theme=0",
		smartlink: "https://lnk.to/MarryListenNow",
		accent: "laz"
	},
	{
		name: "Teddy afro vocal",
		release: "Bloquia",
		role: "Вокалист Luxury Cover Band",
		copy: "Afro vocal энергия Teddy в сольном релизе: плотный грув, танцевальный импульс и живой тембр.",
		cover: "https://imagestore.ffm.to/link/5f8b7d8b260000b8a89fea38/69a9debd3600000d00e1a999_70a37c77b810d683ffdbb8f94fcf274a.jpeg",
		player: "https://embed.music.apple.com/br/album/bloquia-single/1882231884",
		smartlink: "https://onerpm.link/264085142576",
		accent: "teddy"
	},
	{
		name: "Stas",
		release: "Zace",
		role: "Вокалист Luxury Cover Band",
		copy: "Авторский проект Стаса: слушать удобно прямо здесь или выбрать любимую площадку.",
		cover: "https://music-bandlink.s3.yandex.net/img/bandlinks/k5R0E_pNsGNkNh.jpeg",
		player: "https://open.spotify.com/embed/album/133Fplo02SddJKkFvSshqs?utm_source=generator&theme=0",
		smartlink: "https://band.link/zace",
		accent: "stas"
	}
] %}

<section class="artist-listen">
	<div class="artist-listen__hero">
		<p class="artist-listen__kicker">LC Band artists</p>
		<h1>Авторская музыка артистов</h1>
		<p class="artist-listen__lead">Три релиза можно открыть прямо на странице. Плееры не загружаются заранее: сайт остаётся лёгким, а музыка появляется только по нажатию.</p>
	</div>

	<div class="artist-listen__grid" aria-label="Артисты и релизы">
		{% for artist in artists %}
		<article class="listen-card listen-card--{{ artist.accent }}">
			<div class="listen-card__cover">
				<img src="{{ artist.cover }}" alt="{{ artist.name }} — {{ artist.release }}" loading="lazy">
			</div>
			<div class="listen-card__body">
				<p class="listen-card__role">{{ artist.role }}</p>
				<h2>{{ artist.name }}</h2>
				<p class="listen-card__release">{{ artist.release }}</p>
				<p class="listen-card__copy">{{ artist.copy }}</p>
				<div class="listen-card__actions">
					<button
						class="listen-card__button"
						type="button"
						data-player-target="artist-player-{{ loop.index }}"
						data-player-src="{{ artist.player }}"
					>Слушать на сайте</button>
					<a class="listen-card__link" href="{{ artist.smartlink }}" target="_blank" rel="noopener">Все площадки</a>
				</div>
			</div>
			<div class="listen-card__player" id="artist-player-{{ loop.index }}" aria-live="polite"></div>
		</article>
		{% endfor %}
	</div>
</section>

<style>
.artist-listen {
	min-height: 100vh;
	padding: calc(var(--nav-h) + 72px) 22px 96px;
	background:
		radial-gradient(circle at 18% 12%, rgba(255, 49, 95, 0.2), transparent 28%),
		radial-gradient(circle at 88% 4%, rgba(17, 186, 164, 0.18), transparent 26%),
		linear-gradient(180deg, #0b0b0b 0%, #111 58%, #f7f7f4 58.1%, #f7f7f4 100%);
	color: #f7f7f4;
	overflow: hidden;
}

.artist-listen__hero {
	max-width: 1120px;
	margin: 0 auto 48px;
	display: grid;
	grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
	gap: clamp(24px, 6vw, 88px);
	align-items: end;
}

.artist-listen__kicker {
	grid-column: 1 / -1;
	font-size: 12px;
	line-height: 1.2;
	font-weight: 700;
	letter-spacing: 0.24em;
	text-transform: uppercase;
	color: #ffcc4d;
}

.artist-listen h1 {
	max-width: 760px;
	font-family: var(--ff-display);
	font-size: clamp(44px, 8vw, 104px);
	line-height: 0.92;
	font-weight: 700;
	letter-spacing: 0;
}

.artist-listen__lead {
	max-width: 420px;
	font-size: clamp(17px, 2vw, 22px);
	line-height: 1.35;
	color: rgba(247, 247, 244, 0.74);
}

.artist-listen__grid {
	max-width: 1120px;
	margin: 0 auto;
	display: grid;
	gap: 18px;
}

.listen-card {
	position: relative;
	display: grid;
	grid-template-columns: minmax(180px, 260px) minmax(0, 1fr);
	gap: 0;
	min-height: 292px;
	background: rgba(255, 255, 255, 0.92);
	color: #111;
	border: 1px solid rgba(0, 0, 0, 0.08);
	border-radius: 8px;
	overflow: hidden;
	box-shadow: 0 28px 70px rgba(0, 0, 0, 0.24);
}

.listen-card::before {
	content: "";
	position: absolute;
	inset: 0 auto 0 0;
	width: 8px;
	background: var(--listen-accent);
}

.listen-card--laz { --listen-accent: #ff315f; }
.listen-card--teddy { --listen-accent: #11baa4; }
.listen-card--stas { --listen-accent: #ffcc4d; }

.listen-card__cover {
	position: relative;
	min-height: 100%;
	background: #111;
}

.listen-card__cover img {
	width: 100%;
	height: 100%;
	min-height: 292px;
	object-fit: cover;
}

.listen-card__body {
	padding: clamp(24px, 4vw, 44px);
	display: flex;
	flex-direction: column;
	justify-content: center;
}

.listen-card__role {
	font-size: 12px;
	font-weight: 700;
	letter-spacing: 0.18em;
	text-transform: uppercase;
	color: #6e6e73;
}

.listen-card h2 {
	margin-top: 12px;
	font-family: var(--ff-display);
	font-size: clamp(36px, 5.4vw, 72px);
	line-height: 0.95;
	font-weight: 700;
	letter-spacing: 0;
}

.listen-card__release {
	margin-top: 10px;
	font-family: var(--ff-display);
	font-size: clamp(22px, 2.8vw, 32px);
	line-height: 1.08;
	font-weight: 600;
	color: var(--listen-accent);
}

.listen-card__copy {
	max-width: 600px;
	margin-top: 18px;
	font-size: 17px;
	line-height: 1.48;
	color: #48484d;
}

.listen-card__actions {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
	margin-top: 26px;
}

.listen-card__button,
.listen-card__link {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-height: 44px;
	padding: 11px 20px;
	border-radius: 999px;
	font-size: 15px;
	line-height: 1.15;
	font-weight: 700;
	text-align: center;
}

.listen-card__button {
	background: #111;
	color: #fff;
	transition: transform 0.18s ease, background 0.18s ease;
}

.listen-card__button:hover {
	transform: translateY(-1px);
	background: var(--listen-accent);
	color: #111;
}

.listen-card__link {
	border: 1px solid rgba(0, 0, 0, 0.18);
	color: #111;
	background: rgba(255, 255, 255, 0.55);
}

.listen-card__player {
	grid-column: 1 / -1;
	display: none;
	padding: 0 18px 18px;
	background: rgba(255, 255, 255, 0.92);
}

.listen-card__player.is-loaded {
	display: block;
}

.listen-card__player iframe {
	display: block;
	width: 100%;
	height: 352px;
	border: 0;
	border-radius: 8px;
	background: #111;
}

@media (max-width: 820px) {
	.artist-listen {
		padding: calc(var(--nav-h) + 48px) 16px 64px;
		background:
			radial-gradient(circle at 15% 8%, rgba(255, 49, 95, 0.22), transparent 34%),
			linear-gradient(180deg, #0a0a0a 0%, #111 54%, #f7f7f4 54.1%, #f7f7f4 100%);
	}

	.artist-listen__hero {
		grid-template-columns: 1fr;
		gap: 20px;
		margin-bottom: 32px;
	}

	.artist-listen__lead {
		color: rgba(247, 247, 244, 0.8);
	}

	.listen-card {
		grid-template-columns: 1fr;
	}

	.listen-card::before {
		inset: 0 0 auto 0;
		width: auto;
		height: 7px;
	}

	.listen-card__cover img {
		aspect-ratio: 1 / 0.72;
		min-height: 0;
	}

	.listen-card__player {
		padding: 0 12px 12px;
	}

	.listen-card__player iframe {
		height: 380px;
	}
}

@media (prefers-reduced-motion: reduce) {
	.listen-card__button {
		transition: none;
	}
}
</style>

<script>
(() => {
	const buttons = document.querySelectorAll("[data-player-target]");
	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			const target = document.getElementById(button.dataset.playerTarget);
			if (!target) return;
			if (!target.dataset.loaded) {
				const iframe = document.createElement("iframe");
				iframe.src = button.dataset.playerSrc;
				iframe.title = "Музыкальный плеер " + button.closest(".listen-card").querySelector("h2").textContent.trim();
				iframe.allow = "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
				iframe.loading = "lazy";
				target.appendChild(iframe);
				target.dataset.loaded = "true";
			}
			target.classList.add("is-loaded");
			button.textContent = "Плеер открыт";
			button.disabled = true;
		});
	});
})();
</script>
