# luxuryband.ru — канонизация хоста и устранение дублей (SEO)
# Управляется из git (src/.htaccess → passthrough → public_html). Не править на сервере вручную.
# http→https: хостинг этого НЕ делает (проверено 25.07.2026 — http отдавал 200 без редиректа).
# Прошлая попытка зациклила сайт, потому что проверялся %{HTTPS}: за прокси Спринтхоста он
# не отражает реальную схему запроса. Поддержка Спринтхоста подтвердила рабочий признак —
# заголовок X-Forwarded-Proto (правило ниже взято из их документации, help.sprinthost.ru).

RewriteEngine On

# ВАЖНО про цели редиректов: за прокси Apache считает схему http, поэтому
# ОТНОСИТЕЛЬНАЯ цель (/path) превращается в http://… и роняет посетителя на
# незащищённый протокол — проверено 25.07.2026 на /index.html. Во всех правилах
# ниже цель абсолютная и всегда https://.

# 0) www → без www, сразу на https. Идёт раньше правила 1, чтобы http://www
#    уходил на канонический адрес одним переходом, а не двумя.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]

# 1) http → https для канонического хоста.
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# 2) старый сырой ассет репертуара → нормальная страница (должно идти ДО правила index.html)
RewriteRule ^assets/repertoire/index\.html$ https://luxuryband.ru/repertoire/ [L,R=301,NE]

# 2a) страница цен: канон живёт в блоге (/blog/skolko-stoit-kaver-gruppa/).
#     Ожидаемый по плану URL /faq/stoimost-kaver-gruppy/ → 301 на канон,
#     чтобы не плодить дубль под запрос «сколько стоит кавер-группа».
RewriteRule ^faq/stoimost-kaver-gruppy/?$ https://luxuryband.ru/blog/skolko-stoit-kaver-gruppa/ [L,R=301]

# 3) /index.html → /  (корень и подпапки) — убирает дубль главной и вложенных
RewriteCond %{THE_REQUEST} \s/+(([^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^(([^/]+/)*)index\.html$ https://luxuryband.ru/%1 [L,R=301,NE]

# 4) CORS только для видеофайлов — чтобы их можно было fetch'ить с других origin
#    (нужно для программной перезаливки на видеохостинги; на рендер сайта не влияет)
<IfModule mod_headers.c>
	<FilesMatch "\.(mp4|webm|mov|m4v)$">
		Header set Access-Control-Allow-Origin "*"
		Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
	</FilesMatch>
</IfModule>
