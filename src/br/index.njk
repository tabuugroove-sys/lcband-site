			{% for v in lives | internationalVideos %}
			<li class="vtile vtile--small">
				<a class="vtile__link" href="#" data-video="{{ v.slug }}">
					<picture class="vtile__pic">
						<source type="image/webp" sizes="(max-width: 734px) 72vw, max(240px, min(28vw, 440px))"
							srcset="{{ ('/assets/video/posters/' + ((v.poster or v.slug) | internationalPoster(v.slug)) + '-720.webp') | url }} 720w, {{ ('/assets/video/posters/' + ((v.poster or v.slug) | internationalPoster(v.slug)) + '-1080.webp') | url }} 1080w">
						<img class="vtile__poster" src="{{ ('/assets/video/posters/' + ((v.poster or v.slug) | internationalPoster(v.slug)) + '.jpg') | url }}?v=20260622c" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					</picture>
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
	</div>
</section>

