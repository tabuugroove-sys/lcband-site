keywords: "Leo Sax, Лео саксофонист, саксофонист на мероприятие Москва, саксофон на welcome, саксофон на свадьбу, sax dj"
ogImage: assets/leo-sax/hero/leo-sax-hero-1672.webp
permalink: /sax/leo-sax/
barePage: true
bodyClass: leo-sax-page
pageStylesheet: /assets/leo-sax/leo-sax.css?v=1
pageScript: /assets/leo-sax/leo-sax.js?v=1
leoSaxPage: true
---
{% set gallery = [
	{ slug: "playing-burgundy", alt: "Leo Sax играет на саксофоне в бордовом сценическом образе" },
	{ slug: "city-black-tie", alt: "Саксофонист Лео в чёрном костюме на фоне московской архитектуры" },
	{ slug: "white-jacket", alt: "Leo Sax с саксофоном в белом пиджаке у красной кулисы" },
	{ slug: "library-full", alt: "Саксофонист Лео в тёмном костюме в библиотечном интерьере" },
	{ slug: "welcome-light", alt: "Leo Sax на welcome-зоне мероприятия с саксофоном" },
	{ slug: "burgundy-portrait", alt: "Саксофонист Лео сидит с саксофоном в бордовом пиджаке" },
	{ slug: "library-portrait", alt: "Портрет Leo Sax в тёмном костюме в библиотеке" }
] %}

{% set repertoire = [
	{ title: "Джаз, босса-нова и лёгкая фоновая музыка", count: "17 треков", songs: [
		["Bésame Mucho","Consuelo Velázquez"],["Let's Stay Together","Al Green"],["Georgia On My Mind","Ray Charles"],
		["Autumn Leaves","Joseph Kosma"],["Wave","Antônio Carlos Jobim"],["Somewhere Over The Rainbow","Harold Arlen"],
		["My Way","Frank Sinatra"],["Don't Know Why","Norah Jones"],["The Girl From Ipanema","Jobim & Astrud Gilberto"],
		["Sunny","Bobby Hebb"],["Isn't She Lovely","Stevie Wonder"],["Misty","Erroll Garner"],
		["Fly Me To The Moon","Frank Sinatra"],["The Look Of Love","Bacharach & Dusty Springfield"],["Blue Bossa","Kenny Dorham"],
		["Água de Beber","Antônio Carlos Jobim"],["Mas Que Nada","Jorge Ben Jor"]
	] },
	{ title: "Поп и соул", count: "7 треков", songs: [
		["Cold Heart","Elton John & Dua Lipa"],["September","Earth, Wind & Fire"],["Love Nwantiti","CKay"],
		["Dilemma","Nelly & Kelly Rowland"],["Havana","Camila Cabello"],["If I Ain't Got You","Alicia Keys"],
		["Señorita","Shawn Mendes & Camila Cabello"]
	] },
	{ title: "Итальянское и латина", count: "3 трека", songs: [
		["Susanna","Adriano Celentano"],["Sarà Perché Ti Amo","Ricchi e Poveri"],["Abbracciame","Andrea Sannino"]
	] }
] %}

<div class="leo">
	<section class="leo-hero" data-leo-hero aria-labelledby="leo-title">
		<div class="leo-hero__stage">
			<picture class="leo-hero__picture">
				<source media="(max-width: 700px)" type="image/avif" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-mobile-640.avif' | url }} 640w" sizes="100vw">
				<source media="(max-width: 700px)" type="image/webp" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-mobile-640.webp' | url }} 640w" sizes="100vw">
				<source type="image/avif" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-640.avif' | url }} 640w, {{ '/assets/leo-sax/hero/leo-sax-hero-1280.avif' | url }} 1280w, {{ '/assets/leo-sax/hero/leo-sax-hero-1672.avif' | url }} 1672w" sizes="100vw">
				<source type="image/webp" srcset="{{ '/assets/leo-sax/hero/leo-sax-hero-640.webp' | url }} 640w, {{ '/assets/leo-sax/hero/leo-sax-hero-1280.webp' | url }} 1280w, {{ '/assets/leo-sax/hero/leo-sax-hero-1672.webp' | url }} 1672w" sizes="100vw">
				<img class="leo-hero__image" src="{{ '/assets/leo-sax/hero/leo-sax-hero-1672.webp' | url }}" alt="Leo Sax — саксофонист Лео на сцене с саксофоном" width="1672" height="941" fetchpriority="high" decoding="async">
			</picture>
			<video class="leo-player" data-leo-video playsinline preload="none" aria-label="Промо-видео Leo Sax"></video>
		</div>
		<div class="leo-hero__shade" aria-hidden="true"></div>

		<header class="leo-wordmark">
			<h1 id="leo-title">LEO <span>SAX</span></h1>
		</header>

		<svg class="leo-emblem" viewBox="0 0 180 220" aria-hidden="true">
			<path class="leo-emblem__shield" d="M90 8 159 31v69c0 48-24 82-69 110-45-28-69-62-69-110V31Z"/>
			<path d="M66 62c-14 6-23 20-20 36 2 10 9 18 18 23-9 12-8 28 1 40 9-6 17-14 22-24 3 15 12 27 25 34 1-14-2-27-9-39 15-4 26-15 29-30-8 4-16 5-24 4 10-10 14-23 11-37-9 7-16 16-20 27-2-16-12-30-27-37Z"/>
			<path d="M70 80c10-8 24-8 34 0 6 5 9 12 9 20-7 5-13 12-16 21-13-1-24-8-29-19-3-8-2-16 2-22Z"/>
			<circle cx="91" cy="91" r="2.8" class="leo-emblem__eye"/>
			<path class="leo-emblem__sax" d="M105 103c20 2 32 13 31 28-1 14-10 24-25 28-11 3-21-1-24-10-3-8 2-16 11-18 8-2 14 2 15 9"/>
			<path class="leo-emblem__sax" d="m106 103-9-7m37 37 14 5m-39-10 8-4m-16 14 8-3"/>
			<path class="leo-emblem__bell" d="m147 132 17 8-20 9Z"/>
		</svg>

		<button class="leo-play" type="button" data-leo-play aria-label="Смотреть полное промо Leo Sax">
			<span aria-hidden="true"></span>
		</button>

		<div class="leo-player-ui" data-player-ui aria-hidden="true" inert>
			<button class="leo-player-ui__close" type="button" data-video-close aria-label="Закрыть видео"></button>
			<div class="leo-player-ui__quality" role="group" aria-label="Качество видео">
				<button type="button" data-video-quality="480">480p</button>
				<button type="button" data-video-quality="720">720p</button>
				<button type="button" data-video-quality="1080">1080p</button>
			</div>
			<div class="leo-player-ui__bar">
				<button class="leo-player-ui__toggle" type="button" data-video-toggle aria-label="Пауза"></button>
				<input class="leo-player-ui__progress" data-video-progress type="range" min="0" max="100" value="0" step="0.1" aria-label="Позиция видео">
				<span class="leo-player-ui__time" data-video-time>0:00 / 2:35</span>
				<button class="leo-player-ui__fullscreen" type="button" data-video-fullscreen aria-label="На весь экран"></button>
			</div>
		</div>
		<p class="leo-player-status" data-player-status aria-live="polite"></p>
	</section>

	<section class="leo-gallery" aria-labelledby="leo-gallery-title">
		<div class="leo-section-head leo-section-head--dark">
			<p class="leo-kicker">Образы</p>
			<h2 id="leo-gallery-title">Один музыкант.<br><em>Семь состояний.</em></h2>
		</div>
		<div class="leo-carousel" data-carousel>
			<button class="leo-carousel__arrow leo-carousel__arrow--prev" type="button" data-carousel-prev aria-label="Предыдущее фото"></button>
			<div class="leo-carousel__viewport" data-carousel-viewport tabindex="0" aria-label="Фотографии Leo Sax">
				<div class="leo-carousel__track" data-carousel-track>
					{% for photo in gallery %}
					<figure class="leo-slide" data-carousel-slide data-slide-index="{{ loop.index0 }}">
						<picture>
							<source type="image/avif" srcset="{{ ('/assets/leo-sax/gallery/' + photo.slug + '-480.avif') | url }} 480w, {{ ('/assets/leo-sax/gallery/' + photo.slug + '-960.avif') | url }} 960w" sizes="(max-width: 700px) 78vw, 31vw">
							<source type="image/webp" srcset="{{ ('/assets/leo-sax/gallery/' + photo.slug + '-480.webp') | url }} 480w, {{ ('/assets/leo-sax/gallery/' + photo.slug + '-960.webp') | url }} 960w" sizes="(max-width: 700px) 78vw, 31vw">
							<img src="{{ ('/assets/leo-sax/gallery/' + photo.slug + '-960.webp') | url }}" alt="{{ photo.alt }}" width="960" height="1440" loading="lazy" decoding="async">
						</picture>
					</figure>
					{% endfor %}
				</div>
			</div>
			<button class="leo-carousel__arrow leo-carousel__arrow--next" type="button" data-carousel-next aria-label="Следующее фото"></button>
		</div>
		<div class="leo-carousel__dots" data-carousel-dots aria-label="Позиция в фотогалерее">
			{% for photo in gallery %}<button type="button" data-carousel-dot="{{ loop.index0 }}" aria-label="Фото {{ loop.index }}"{% if loop.first %} class="is-active" aria-current="true"{% endif %}></button>{% endfor %}
		</div>
	</section>

	<section class="leo-moments" aria-labelledby="leo-moments-title">
		<div class="leo-wrap">
			<div class="leo-section-head">
				<p class="leo-kicker">Сценарий</p>
				<h2 id="leo-moments-title">Где саксофон<br><em>звучит уместно.</em></h2>
			</div>
			<div class="leo-moments__grid">
				<article><span>01</span><h3>Welcome</h3><p>Первые встречи, звон бокалов — и вечер уже звучит.</p></article>
				<article><span>02</span><h3>Церемония</h3><p>Мелодия ведёт к главному моменту, не забирая его себе.</p></article>
				<article><span>03</span><h3>Ужин</h3><p>Тёплый jazz, soul и bossa nova остаются рядом с разговорами.</p></article>
				<article><span>04</span><h3>Вечеринка</h3><p>Sax &amp; DJ добавляет танцполу ритм и живое дыхание.</p></article>
			</div>
		</div>
	</section>

	<section class="leo-repertoire" aria-labelledby="leo-repertoire-title">
		<div class="leo-wrap">
			<div class="leo-section-head leo-section-head--rep">
				<p class="leo-kicker">Репертуар</p>
				<h2 id="leo-repertoire-title">Музыка следует<br><em>ритму события.</em></h2>
				<p class="leo-repertoire__lead">От дыхания джаза до лёгкого поп-мотива — программа меняет настроение мягко, без лишних слов.</p>
			</div>
			<div class="leo-repertoire__groups">
				{% for group in repertoire %}
				<details class="leo-repertoire__group">
					<summary><span>{{ group.title }}</span><small>{{ group.count }}</small><i aria-hidden="true"></i></summary>
					<ul>
						{% for song in group.songs %}<li><strong>{{ song[0] }}</strong><span>{{ song[1] }}</span></li>{% endfor %}
					</ul>
				</details>
				{% endfor %}
			</div>
		</div>
	</section>
</div>
