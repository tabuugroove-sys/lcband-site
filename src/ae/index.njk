<!-- =============== VIDEO =============== -->
<section class="section" id="videos">
	{% set promos = [
		{slug:'promo-egoistka', title:'Egoistka · 2020–2025', eyebrow:'كليب'},
		{slug:'promo-main-reel', title:'Main Reel', eyebrow:'برومو'},
		{slug:'promo-loca-loca', title:'Loca Loca · LAZ', eyebrow:'برومو'},
		{slug:'promo-letet', title:'Letet', eyebrow:'برومو'},
		{slug:'promo-lets-get-it-started', title:'Let\'s Get It Started', eyebrow:'برومو'}
	] %}
	{% set lives = [
		{slug:'live-big-lineup', title:'Big Lineup', eyebrow:'حفل حي'},
		{slug:'live-perfect', title:'Perfect', eyebrow:'حفل حي'},
		{slug:'live-soho', title:'Soho Rooms', eyebrow:'حفل حي'},
		{slug:'live-berezy', title:'Beryozy', eyebrow:'حفل حي'},
		{slug:'live-icon', title:'Icon', eyebrow:'حفل حي'},
		{slug:'interact-wedding-shallow', title:'Shallow · زفاف', eyebrow:'تفاعلي'},
		{slug:'interact-chainsmokers', title:'Chainsmokers', eyebrow:'تفاعلي'}
	] %}
	<div class="container container--narrow reveal">
		<h2 class="section__title">شاهد كيف<br><span class="muted">يبدو العرض على المسرح.</span></h2>
		<p class="section__lead">فيديوهات ترويجية من الاستوديو، حفلات حية، فقرات تفاعلية مع الجمهور وبرامج موضوعية.</p>
	</div>

	<div class="video-rail video-rail--big reveal" role="region" aria-label="الفيديوهات الترويجية">
		<div class="video-rail__heading"><h3 class="video-rail__title">فيديوهات ترويجية من الاستوديو</h3></div>
		<ul class="video-rail__track">
			{% for v in promos %}
			<li class="vtile vtile--big">
				<a class="vtile__link" href="#" data-video="{{ v.slug }}">
					<img class="vtile__poster" src="{{ ('/assets/video/posters/' + v.slug + '.jpg') | url }}" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
	<div class="video-rail video-rail--small reveal" role="region" aria-label="فيديوهات الحفلات الحية">
		<div class="video-rail__heading"><h3 class="video-rail__title">فيديوهات الحفلات الحية</h3></div>
		<ul class="video-rail__track">
			{% for v in lives %}
			<li class="vtile vtile--small">
				<a class="vtile__link" href="#" data-video="{{ v.slug }}">
					<img class="vtile__poster" src="{{ ('/assets/video/posters/' + v.slug + '.jpg') | url }}" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
