# luxuryband.ru — канонизация хоста и устранение дублей (SEO)
# Управляется из git (src/.htaccess → passthrough → public_html). Не править на сервере вручную.
# http→https: хостинг этого НЕ делает (проверено 25.07.2026 — http отдавал 200 без редиректа).
# Прошлая попытка зациклила сайт, потому что проверялся %{HTTPS}: за прокси Спринтхоста он
# не отражает реальную схему запроса. Поддержка Спринтхоста подтвердила рабочий признак —
# заголовок X-Forwarded-Proto (правило ниже взято из их документации, help.sprinthost.ru).

RewriteEngine On

# ВАЖНО про цели редиректов: за прокси Apache считает схему http, поэтому
# ОТНОСИТЕЛЬНАЯ цель (/path) превращается в http://… и роняет посетителя на
# незащищённый протокол — проверено 25.07.2026 на /index.html. Во всех правилах
# ниже цель абсолютная и всегда https://.

# 0) www → без www, сразу на https. Идёт раньше правила 1, чтобы http://www
#    уходил на канонический адрес одним переходом, а не двумя.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]

# 1) http → https для канонического хоста.
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# 2) Полный каталог репертуара имеет собственный канон /assets/repertoire/.
#    Его index.html обрабатывает общее правило 3; не возвращаем читателя на landing.

# 2a) страница цен: канон живёт в блоге (/blog/skolko-stoit-kaver-gruppa/).
#     Ожидаемый по плану URL /faq/stoimost-kaver-gruppy/ → 301 на канон,
#     чтобы не плодить дубль под запрос «сколько стоит кавер-группа».
RewriteRule ^faq/stoimost-kaver-gruppy/?$ https://luxuryband.ru/blog/skolko-stoit-kaver-gruppa/ [L,R=301]

# 2b) программа «Испанская» стала «Латинское шоу»: /programs/spanish/ → /programs/latin/
#     (RU и EN). Цель абсолютная https — см. предупреждение выше. Страница-заглушка со
#     canonical и refresh лежит на старом адресе на случай, если сервер отдаст физический
#     файл раньше rewrite (деплой распаковывает архив поверх и старые файлы не удаляет).
RewriteRule ^programs/spanish/?$ https://luxuryband.ru/programs/latin/ [L,R=301]
RewriteRule ^en/programs/spanish/?$ https://luxuryband.ru/en/programs/latin/ [L,R=301]

# The separate concert gallery is retired; keep shared URLs useful.
RewriteRule ^live(?:/index\.html)?/?$ https://luxuryband.ru/#videos [L,R=301,NE]
RewriteRule ^en/live(?:/index\.html)?/?$ https://luxuryband.ru/en/#videos [L,R=301,NE]

# Retired background reels: preserve shared playback/download links before freeing media storage.
RewriteRule ^assets/video/mp4/hq-20261029-about-1280\.mp4$ https://luxuryband.ru/assets/video/mp4/lt2-20261030-about-1280.mp4 [L,R=301,NE,QSD]
RewriteCond %{QUERY_STRING} (^|&)file=hq-20261029-about-1280\.mp4(&|$)
RewriteRule ^download\.php$ https://luxuryband.ru/download.php?file=lt2-20261030-about-1280.mp4 [L,R=301,NE]
RewriteRule ^assets/video/mp4/hq-20261029-about-1920\.mp4$ https://luxuryband.ru/assets/video/mp4/lt2-20261030-about-1920.mp4 [L,R=301,NE,QSD]
