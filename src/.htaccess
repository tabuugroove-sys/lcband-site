RewriteCond %{QUERY_STRING} (^|&)file=promo-costume-bw-822965daacce-2160\.mp4(&|$)
RewriteRule ^download\.php$ https://luxuryband.ru/download.php?file=promo-costume-bw-01dc7bdc6938-2160.mp4 [L,R=301,NE]
RewriteCond %{QUERY_STRING} (^|&)file=promo-costume-gold-b9f4a6ecf5ab-2160\.mp4(&|$)
RewriteRule ^download\.php$ https://luxuryband.ru/download.php?file=promo-costume-gold-42ce52957175-2160.mp4 [L,R=301,NE]
RewriteCond %{QUERY_STRING} (^|&)file=promo-costume-white-bcef639df1ff-2160\.mp4(&|$)
