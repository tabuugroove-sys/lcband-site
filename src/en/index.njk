---
layout: layouts/base.njk
htmlLang: en
ogLocale: en_US
title: Luxury Cover Band — International Cover Band · 500+ Songs in 12 Languages
description: "Luxury Cover Band — international cover band: 500+ songs in 12 languages, stadium and TV experience. Weddings, corporate events, world tours. Lineup of 2–20 musicians."
keywords: "cover band, wedding band, corporate event band, live music band, international cover band, Luxury Cover Band, LC Band"
preloadImage: assets/hero/hero-red.jpg
preloadHeroMobileWebp: true
permalink: /en/
---

<!-- =============== HERO (EN · 4-COLOR SWITCHABLE LINEUP + INLINE VIDEO) =============== -->
<section class="hero" data-hero>
	<div class="hero__stage">
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-red-640.webp' | url }} 640w, {{ '/assets/hero/hero-red-960.webp' | url }} 960w, {{ '/assets/hero/hero-red-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--red is-active"  src="{{ '/assets/hero/hero-red.jpg' | url }}"   alt="{{ site.name }} — red look on an LED wall" loading="eager" fetchpriority="high" data-hero-img="red">
		</picture>
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-bw-640.webp' | url }} 640w, {{ '/assets/hero/hero-bw-960.webp' | url }} 960w, {{ '/assets/hero/hero-bw-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--bw"             src="{{ '/assets/hero/hero-bw.jpg' | url }}"    alt="{{ site.name }} — black-and-white look"  loading="lazy" data-hero-img="bw">
		</picture>
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-gold-640.webp' | url }} 640w, {{ '/assets/hero/hero-gold-960.webp' | url }} 960w, {{ '/assets/hero/hero-gold-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--gold"           src="{{ '/assets/hero/hero-gold.jpg' | url }}"  alt="{{ site.name }} — gold look on stage"       loading="lazy" data-hero-img="gold">
		</picture>
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-white-640.webp' | url }} 640w, {{ '/assets/hero/hero-white-960.webp' | url }} 960w, {{ '/assets/hero/hero-white-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--white"          src="{{ '/assets/hero/hero-white.jpg' | url }}" alt="{{ site.name }} — white look on a starry backdrop"  loading="lazy" data-hero-img="white">
		</picture>
		<video class="hero__video" data-hero-video playsinline preload="none"></video>
	</div>
	<div class="hero__scrim"></div>
	<button class="hero__play" data-hero-play type="button" aria-label="Watch video in these looks"></button>
	<button class="hero__close" data-hero-close type="button" aria-label="Close video"></button>
	<div class="hero__controls" data-hero-controls>
		<button class="hero__toggle" data-hero-toggle type="button" aria-label="Pause"></button>
		<div class="hero__progress" data-hero-progress>
			<div class="hero__progress-filled" data-hero-progress-filled></div>
		</div>
		<span class="hero__time" data-hero-time>0:00 / 0:00</span>
	</div>
	<div class="hero__quality" data-hero-quality role="group" aria-label="Video quality">
		<button type="button" data-hero-q="720">720p</button>
		<button type="button" data-hero-q="1080" class="is-active">1080p</button>
		<button type="button" data-hero-q="2160" hidden>4K</button>
	</div>
	<div class="hero__recommendations" data-hero-recommendations aria-hidden="true" aria-label="Watch next">
		<button class="hero-rec" type="button" data-hero-recommendation="0">
			<img class="hero-rec__poster" data-hero-rec-poster alt="" loading="eager">
			<span class="hero-rec__copy">
				<span class="hero-rec__costume" data-hero-rec-costume></span>
				<strong class="hero-rec__title" data-hero-rec-title></strong>
			</span>
			<span class="hero-rec__play" aria-hidden="true"></span>
		</button>
		<button class="hero-rec" type="button" data-hero-recommendation="1">
			<img class="hero-rec__poster" data-hero-rec-poster alt="" loading="eager">
			<span class="hero-rec__copy">
				<span class="hero-rec__costume" data-hero-rec-costume></span>
				<strong class="hero-rec__title" data-hero-rec-title></strong>
			</span>
			<span class="hero-rec__play" aria-hidden="true"></span>
		</button>
	</div>
	<div class="hero__content">
		<p class="hero__eyebrow">International Cover Band</p>
		<h1 class="hero__title">{{ site.name }}</h1>
		<div class="hero__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Message on Telegram</a>
		</div>
		<div class="hero__picker" role="tablist" aria-label="Choose the look">
			<button class="hero__dot hero__dot--red is-active"  data-hero-dot="red"   role="tab" aria-label="Red look"       aria-selected="true"></button>
			<button class="hero__dot hero__dot--bw"             data-hero-dot="bw"    role="tab" aria-label="Black-and-white look" aria-selected="false"></button>
			<button class="hero__dot hero__dot--gold"           data-hero-dot="gold"  role="tab" aria-label="Gold look"      aria-selected="false"></button>
			<button class="hero__dot hero__dot--white"          data-hero-dot="white" role="tab" aria-label="White look"     aria-selected="false"></button>
		</div>
	</div>
	<a class="hero__scroll" href="#about" aria-label="Scroll to the description"><span></span></a>
</section>

<!-- =============== ABOUT / STATS =============== -->
<section class="section section--elev" id="about">
	<div class="container about-split reveal">
		<div class="about-split__media">
			<img src="{{ '/assets/photos/concert-10k.jpg' | url }}" alt="Luxury Cover Band on stage — stadium-level experience" loading="lazy">
		</div>
		<div class="about-split__body">
			<p class="section__eyebrow">About the Band</p>
			<h2 class="section__title">World-class stage.</h2>
			<p class="section__lead">2000+ shows in 40 countries. Stadiums, TV, top stars — now at your event.</p>
			<div class="cta-row cta-row--left">
				<a class="btn btn--blue" href="{{ '/about/' | url }}">Learn more</a>
				<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Message on Telegram</a>
			</div>
		</div>
	</div>
	<div class="container reveal">
		<div class="stats">
			<div class="stat"><div class="stat__num">{{ site.stats.shows }}</div><div class="stat__label">shows</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.countries }}</div><div class="stat__label">countries</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.years }}</div><div class="stat__label">years on stage</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.songs }}</div><div class="stat__label">songs in the repertoire</div></div>
		</div>
	</div>
</section>

<!-- =============== VOCALISTS (hero only) =============== -->
<section class="section section--light section--flush" id="vocalists">
	<div class="hero-banner hero-banner--bleed reveal">
		<picture class="hero-banner__pic">
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/photos/vocalists-mobile-640.webp' | url }} 640w, {{ '/assets/photos/vocalists-mobile-960.webp' | url }} 960w">
			<source media="(max-width: 734px)" srcset="{{ '/assets/photos/vocalists-mobile.jpg' | url }}">
			<source type="image/webp" sizes="100vw"
				srcset="{{ '/assets/photos/vocalists-1280.webp' | url }} 1280w, {{ '/assets/photos/vocalists-1920.webp' | url }} 1920w, {{ '/assets/photos/vocalists-2600.webp' | url }} 2600w">
			<img class="hero-banner__img" src="{{ '/assets/photos/vocalists.jpg' | url }}" alt="Luxury Cover Band — four vocalists, studio photoshoot" loading="lazy">
		</picture>
		<div class="hero-banner__overlay">
			<p class="section__eyebrow">Vocalists</p>
			<h2 class="section__title">Four voices.<br><span class="muted">Four personalities.</span></h2>
			<p class="section__lead">Each one leads their part of the program. We combine them into duos, trios, and quartets to fit your event.</p>
			<div class="cta-row">
				<a class="btn btn--blue" href="{{ '/vocalists/' | url }}">Learn more</a>
				<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Message on Telegram</a>
			</div>
		</div>
	</div>
</section>

<!-- =============== DIRECTIONS (6 tiles, 2-up Apple-style) =============== -->
<section class="section section--flush" id="directions">
	<div class="reveal">
		<ul class="tile-grid tile-grid--bleed">
			<li class="tile tile--has-photo tile--copy-top tile--copy-dark tile--corporate">
				<a class="tile__tap-target" href="{{ '/events/corporate/' | url }}" aria-label="Open: Corporate Events"></a>
				<picture class="tile__pic">
					<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
						srcset="{{ '/assets/photos/corporate-768.webp' | url }} 768w, {{ '/assets/photos/corporate-1152.webp' | url }} 1152w">
					<img class="tile__img" src="{{ '/assets/photos/corporate.jpg?v=6' | url }}" alt="Corporate Events — Luxury Cover Band" loading="lazy">
				</picture>
				<div class="tile__content">
					<h3 class="tile__title">Corporate Events</h3>
					<p class="tile__sub">Your brand, live on a big stage.</p>
					<div class="cta-row">
						<a class="btn btn--blue" href="{{ '/events/corporate/' | url }}">Learn more</a>
						<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Message on Telegram</a>
					</div>
				</div>
			</li>
			<li class="tile tile--has-photo tile--center tile--copy-split tile--wedding">
				<a class="tile__tap-target" href="{{ '/events/wedding/' | url }}" aria-label="Open: Weddings"></a>
				<picture class="tile__pic">
					<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
						srcset="{{ '/assets/photos/wedding-768.webp' | url }} 768w, {{ '/assets/photos/wedding-1152.webp' | url }} 1152w">
					<img class="tile__img" src="{{ '/assets/photos/wedding.jpg' | url }}" alt="Weddings — Luxury Cover Band" loading="lazy">
				</picture>
				<div class="tile__content">
					<h3 class="tile__title">Weddings</h3>
					<p class="tile__sub">Show · First Dance · Reception</p>
					<div class="cta-row">
						<a class="btn btn--blue" href="{{ '/events/wedding/' | url }}">Learn more</a>
						<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Message on Telegram</a>
					</div>
				</div>
			</li>
			<li class="tile tile--has-photo tile--copy-top tile--copy-dark tile--birthday">
				<a class="tile__tap-target" href="{{ '/events/birthday/' | url }}" aria-label="Open: Birthdays"></a>
				<picture class="tile__pic">
					<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
						srcset="{{ '/assets/photos/birthday-768.webp' | url }} 768w, {{ '/assets/photos/birthday-1152.webp' | url }} 1152w">
					<img class="tile__img" src="{{ '/assets/photos/birthday.jpg' | url }}" alt="Birthdays — Luxury Cover Band" loading="lazy">
				</picture>
				<div class="tile__content">
					<h3 class="tile__title">Birthday</h3>
					<p class="tile__sub">Concerts guests remember for years.</p>
					<div class="cta-row">
						<a class="btn btn--blue" href="{{ '/events/birthday/' | url }}">Learn more</a>
						<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Message on Telegram</a>
					</div>
				</div>
			</li>
			<li class="tile tile--has-photo tile--copy-stack tile--copy-dark tile--clients">
				<a class="tile__tap-target" href="{{ '/events/corporate/' | url }}" aria-label="Open: Client Events"></a>
				<picture class="tile__pic">
					<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
						srcset="{{ '/assets/photos/clients-768.webp' | url }} 768w, {{ '/assets/photos/clients-1152.webp' | url }} 1152w">
					<img class="tile__img" src="{{ '/assets/photos/clients.jpg' | url }}" alt="Client Events — Luxury Cover Band" loading="lazy">
				</picture>
				<div class="tile__content">
					<h3 class="tile__title">Client<span class="tile__line"> Events</span></h3>
					<p class="tile__sub"><span class="tile__line">Exhibitions</span> <span class="tile__line">Award Shows</span> <span class="tile__line">Dinners</span></p>
					<div class="cta-row">
						<a class="btn btn--blue" href="{{ '/events/corporate/' | url }}">Learn more</a>
						<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Message on Telegram</a>
					</div>
				</div>
			</li>
			<li class="tile tile--has-photo tile--smoky tile--copy-stack tile--copy-dark tile--themes tile--themes-split">
