				<a class="btn btn--blue" href="{{ '/about/' | url }}">اعرف المزيد</a>
				<a class="btn btn--blue-ghost" href="{{ site.telegram }}">راسلنا على تيليجرام</a>
			</div>
		</div>
	</div>
	<div class="container reveal">
