<!DOCTYPE html>
<html lang="ru">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title>{{ title or site.name }}</title>
	<meta name="description" content="{{ description or site.description }}">
	{% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
	<link rel="canonical" href="{{ site.url }}{{ page.url }}">
	<meta name="theme-color" content="#000000">
	<meta name="format-detection" content="telephone=no">

	<meta property="og:type" content="website">
	<meta property="og:locale" content="ru_RU">
	<meta property="og:title" content="{{ title or site.name }}">
	<meta property="og:description" content="{{ description or site.tagline }}">
	<meta property="og:image" content="{{ site.url }}/{{ ogImage or site.defaultOgImage }}">
	<meta property="og:site_name" content="{{ site.name }}">
	<meta property="og:url" content="{{ site.url }}{{ page.url }}">

	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{{ title or site.name }}">
	<meta name="twitter:description" content="{{ description or site.tagline }}">
	<meta name="twitter:image" content="{{ site.url }}/{{ ogImage or site.defaultOgImage }}">

	<link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}">
	<link rel="mask-icon" href="{{ '/assets/favicon.svg' | url }}" color="#000000">
	{# preloadImage может быть с ведущим слэшем и без — нормализуем к абсолютному,
	   иначе на /ae/ и /br/ preload резолвится в /ae/assets/... и бьёт в 404.
	   preloadHeroMobileWebp: на мобильном hero отдаётся webp из <picture> —
	   прелоадим его, а jpg прелоадим только на десктопе (без двойной загрузки) #}
	{% if preloadHeroMobileWebp %}
	<link rel="preload" as="image" href="{{ ('/' + preloadImage) | replace('//', '/') | url }}" media="(min-width: 735px)">
	<link rel="preload" as="image" media="(max-width: 734px)" imagesizes="100vw"
		imagesrcset="{{ '/assets/hero/hero-red-640.webp' | url }} 640w, {{ '/assets/hero/hero-red-960.webp' | url }} 960w, {{ '/assets/hero/hero-red-1280.webp' | url }} 1280w">
	{% elif preloadImage %}<link rel="preload" as="image" href="{{ ('/' + preloadImage) | replace('//', '/') | url }}">{% endif %}
	<link rel="stylesheet" href="{{ '/styles.css?v=29' | url }}">

	<script>window.SITE_BASE = "{{ '/' | url }}";</script>

	{% block schema %}
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "MusicGroup",
				"@id": "{{ site.url }}/#musicgroup",
				"name": "{{ site.name }}",
				"alternateName": "{{ site.shortName }}",
				"description": "{{ site.description }}",
				"genre": ["Pop", "Rock", "Jazz", "Soul", "Funk", "Retro", "Latin", "Italian", "French chanson"],
				"image": "{{ site.url }}/{{ site.defaultOgImage }}",
				"url": "{{ site.url }}",
				"sameAs": [
					"{{ site.telegram }}"
					{% if site.youtube %}, "{{ site.youtube }}"{% endif %}
					{% if site.vk %}, "{{ site.vk }}"{% endif %}
					{% if site.instagram %}, "{{ site.instagram }}"{% endif %}
				],
				"areaServed": ["Москва", "Россия", "Международные туры"]
			},
			{
				"@type": "LocalBusiness",
				"@id": "{{ site.url }}/#business",
				"name": "{{ site.name }}",
				"description": "{{ site.description }}",
				"image": "{{ site.url }}/{{ site.defaultOgImage }}",
				"url": "{{ site.url }}",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "{{ site.city }}",
					"addressCountry": "RU"
				},
				"areaServed": ["Москва", "Московская область", "Россия", "Международные туры"],
				"priceRange": "$$",
				"sameAs": [
					"{{ site.telegram }}"
					{% if site.youtube %}, "{{ site.youtube }}"{% endif %}
					{% if site.vk %}, "{{ site.vk }}"{% endif %}
					{% if site.instagram %}, "{{ site.instagram }}"{% endif %}
				]
			},
			{
				"@type": "WebSite",
				"@id": "{{ site.url }}/#website",
				"name": "{{ site.name }}",
				"url": "{{ site.url }}",
				"inLanguage": "ru-RU",
				"publisher": { "@id": "{{ site.url }}/#musicgroup" }
			}
		]
	}
	</script>
	{% endblock %}
	{% block head %}{% endblock %}

	<!-- Yandex.Metrika counter -->
	<script type="text/javascript">
		(function(m,e,t,r,i,k,a){
			m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
			m[i].l=1*new Date();
			for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
			k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
		})(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=110040914', 'ym');

		ym(110040914, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
	</script>
	<noscript><div><img src="https://mc.yandex.ru/watch/110040914" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
	<!-- /Yandex.Metrika counter -->
</head>
<body>

	{% include "partials/nav.njk" %}

	<main id="top">
		{% block content %}{{ content | safe }}{% endblock %}
	</main>

	{% include "partials/footer.njk" %}
	{% include "partials/lightbox.njk" %}

	<script src="{{ '/main.js?v=10' | url }}" defer></script>
</body>
</html>
