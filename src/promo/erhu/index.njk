<body>
  <a class="skip" href="#gallery">Перейти к видео</a>
  <header class="topbar">
    <nav class="nav wrap" aria-label="Навигация галереи">
      <a class="brand" href="https://luxuryband.ru/"><img src="/assets/favicon.svg" width="30" height="30" alt=""><span>Luxury Band</span></a>
      <div class="navlinks"><a href="#gallery">Видео / <span lang="zh-Hans">影像</span></a><a href="#photos">Фото / <span lang="zh-Hans">照片</span></a><a href="#repertoire">Репертуар / <span lang="zh-Hans">曲目</span></a><button class="share" type="button">Поделиться <span aria-hidden="true">↗</span></button></div>
    </nav>
  </header>
  <main>
    <div class="hero-backdrop">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title" class="calligraphy-title"><img src="/assets/erhu/erhu-chinese-calligraphy-1040.webp" srcset="/assets/erhu/erhu-chinese-calligraphy-520.webp 520w, /assets/erhu/erhu-chinese-calligraphy-1040.webp 1040w" sizes="(max-width: 650px) calc(100vw - 40px), (max-width: 1000px) calc((100vw - 96px) / 2), 520px" width="1040" height="585" alt="Китайская каллиграфия 二胡 — название инструмента эрху, красные мазки кистью" fetchpriority="high"><span>Эрху</span></h1>
        <p class="intro">Пчела над жасмином роняет слезу.<br>Цветок принимает прозрачную каплю.<br>Лишь голос эрху наполняет тишину.</p>
        <a class="primary brush-button" href="#gallery">СМОТРЕТЬ</a>
      </div>
      <div class="living-scene">
        <img class="scene-photo" src="/assets/erhu/erhu-blossom-scene-960.webp" width="960" height="960" alt="" aria-hidden="true" decoding="async">
        <div class="scene-window">
          <img class="scene-poster" src="/assets/erhu/erhu-blossom-scene-960.webp" srcset="/assets/erhu/erhu-blossom-scene-480.webp 480w, /assets/erhu/erhu-blossom-scene-960.webp 960w" sizes="(max-width: 650px) calc(100vw - 40px), (max-width: 1000px) calc((100vw - 96px) / 2), 560px" width="960" height="960" alt="Музыкант с китайским инструментом эрху под розовыми цветущими ветвями — обложка «Дождь в Цзяннани»" decoding="async">
          <div class="scene-motion"><video id="scene-video" playsinline preload="none" aria-label="Дождь в Цзяннани / 江南雨" data-src="/assets/video/mp4/erhu-01-rain.mp4"></video></div>
          <button class="scene-start" type="button" aria-label="Смотреть видео: Дождь в Цзяннани / 江南雨" aria-controls="scene-video"><span class="round-play" aria-hidden="true">▶</span><span>Дождь в Цзяннани <span class="slash">/</span> <span lang="zh-Hans">江南雨</span><small>0:52</small></span></button>
          <div class="scene-controls" hidden>
            <button class="scene-toggle" type="button" aria-label="Пауза" aria-controls="scene-video">Ⅱ</button>
            <input class="scene-seek" type="range" min="0" max="100" value="0" step="0.1" aria-label="Позиция воспроизведения">
            <span class="scene-time">0:00</span>
            <button class="scene-mute" type="button" aria-label="Выключить звук" aria-pressed="false">♪</button>
            <a class="scene-expand" href="/assets/video/mp4/erhu-01-rain.mp4" data-slug="01-rain" aria-label="Открыть полное видео">⤢</a>
          </div>
          <p class="scene-error" role="status" hidden>Видео не загрузилось. <a href="/assets/video/mp4/erhu-01-rain.mp4">Открыть видео ↗</a></p>
        </div>
      </div>
    </section>
    <div class="landscape landscape-night" aria-hidden="true"><svg viewBox="0 0 1440 150" preserveAspectRatio="none"><path d="M0 127Q95 112 159 117T286 101L387 61 436 81 495 44 529 69 594 33 651 66 713 54 790 94Q900 114 1000 76L1092 23 1138 48 1190 34 1277 88 1360 65 1440 92V150H0Z" fill="#27353c" stroke="#60727a" stroke-opacity=".4" stroke-width=".7"/><path d="M0 145L117 121 192 136 287 95 354 111 450 91 558 126 677 99 770 129 867 104 970 128 1108 83 1197 105 1280 90 1390 122 1440 115V150H0Z" fill="#121d23" stroke="#4b5b64" stroke-opacity=".55" stroke-width=".7"/></svg></div>
    </div>
    <section class="gallery-section" id="gallery" aria-labelledby="gallery-title">
      <div class="gallery-leaves" aria-hidden="true">
        <img class="gallery-leaf gallery-leaf-center" src="/assets/erhu/maple-leaf.svg" alt="" width="340" height="370">
        <img class="gallery-leaf gallery-leaf-right" src="/assets/erhu/maple-leaf.svg" alt="" width="340" height="370">
        <img class="gallery-leaf gallery-leaf-lower" src="/assets/erhu/maple-leaf.svg" alt="" width="340" height="370">
      </div>
      <div class="wrap">
        <div class="section-heading"><div><h2 id="gallery-title">Звучащие свитки <span class="slash">/</span> <span lang="zh-Hans">弦音画卷</span></h2></div></div>
        <div class="gallery-tools"><div class="filters" aria-label="Формат видео"><button type="button" data-filter="all" aria-pressed="true">Все / <span lang="zh-Hans">全部</span> <span>{{ erhuVideos | length }}</span></button><button type="button" data-filter="solo" aria-pressed="false">Соло / <span lang="zh-Hans">独奏</span></button><button type="button" data-filter="stage" aria-pressed="false">На сцене / <span lang="zh-Hans">舞台</span></button></div><span class="result-count" aria-live="polite">{{ erhuVideos | length }} видео</span></div>
        <div class="video-grid" id="video-carousel" role="region" aria-label="Карусель видео" aria-roledescription="карусель" tabindex="0">
        {% for video in erhuVideos %}
          <article class="video-card" data-category="{{ video.category }}" style="--video-ratio: {{ video.width }} / {{ video.height }}">
            <a class="thumbnail play-item" href="{{ video.url }}" data-slug="{{ video.slug }}" aria-label="Смотреть видео: {{ video.title }} / {{ video.titleZh }}">
              <img src="{{ video.poster }}" alt="{{ video.title }} / {{ video.titleZh }} — кадр выступления на эрху" loading="lazy" decoding="async" width="{{ video.width }}" height="{{ video.height }}">
              <span class="round-play" aria-hidden="true">▶</span><span class="duration">{{ video.time }}</span>
            </a>
            <div class="card-details"><span class="card-label">{{ video.label }} / <span lang="zh-Hans">{% if video.category == 'solo' %}独奏{% else %}舞台{% endif %}</span></span><h3><span>{{ video.title }}</span> <span class="slash">/</span> <span lang="zh-Hans">{{ video.titleZh }}</span></h3><a class="download" href="{{ video.url }}" download aria-label="Скачать видео: {{ video.title }} / {{ video.titleZh }}">Скачать видео <span aria-hidden="true">↓</span></a></div>
          </article>
        {% endfor %}
        </div>
        <div class="carousel-controls" hidden>
          <button class="carousel-prev" type="button" aria-label="Предыдущие видео" aria-controls="video-carousel">←</button>
          <div class="carousel-dots" aria-label="Страницы карусели"></div>
          <span class="carousel-position" aria-live="polite"></span>
          <button class="carousel-next" type="button" aria-label="Следующие видео" aria-controls="video-carousel">→</button>
        </div>
      </div>
    </section>
    <div class="photos-backdrop">
    <section class="photos-section wrap" id="photos" aria-labelledby="photos-title">
      <div class="section-heading"><h2 id="photos-title">Образы <span class="slash">/</span> <span lang="zh-Hans">风姿</span></h2><a class="text-link" href="https://drive.google.com/drive/folders/1d9dS6L7lHlbROonWRyD0ModH0tyQTt4m" target="_blank" rel="noopener">Материалы / <span lang="zh-Hans">资料</span> ↗</a></div>
      <div class="photo-grid">
      {% for photo in erhuPhotos %}
        <figure class="photo-card">
          <a class="photo-open" href="/assets/erhu/photos/erhu-{{ photo.id }}-960.webp" aria-label="Открыть фото: {{ photo.title }} / {{ photo.titleZh }}">
            <img src="/assets/erhu/photos/erhu-{{ photo.id }}-960.webp" srcset="/assets/erhu/photos/erhu-{{ photo.id }}-480.webp 480w, /assets/erhu/photos/erhu-{{ photo.id }}-960.webp {{ photo.width }}w" sizes="(max-width: 650px) calc((100vw - 54px) / 2), (max-width: 1000px) calc((100vw - 79px) / 2), 283px" alt="{{ photo.alt }}" width="{{ photo.width }}" height="{{ photo.height }}" loading="lazy" decoding="async">
            <span class="photo-enlarge" aria-hidden="true">↗</span>
          </a>
          <figcaption><h3>{{ photo.title }} <span class="slash">/</span> <span lang="zh-Hans">{{ photo.titleZh }}</span></h3>{% if photo.note %}<p class="photo-note">{{ photo.note }} / <span lang="zh-Hans">{{ photo.noteZh }}</span></p>{% endif %}</figcaption>
        </figure>
      {% endfor %}
      </div>
    </section>
    </div>
    <section class="repertoire wrap" id="repertoire" aria-labelledby="repertoire-title">
      <div class="repertoire-heading"><h2 id="repertoire-title">Репертуар <span class="slash">/</span> <span lang="zh-Hans">曲目</span></h2><a class="text-link" href="/assets/erhu/repertoire.txt?v=4" download>Скачать полный репертуар <span aria-hidden="true">↓</span></a></div>
      <div class="repertoire-groups">
      {% for group in erhuRepertoire %}
        <div class="repertoire-group">
          <h3>{{ group.title }} <span class="slash">/</span> <span lang="zh-Hans">{{ group.titleZh }}</span></h3>
          <p class="repertoire-note">{{ group.note }}</p>
          <ol class="song-list">
          {% for song in group.songs %}
            <li><span class="song-number">{{ loop.index }}</span><span class="song-name">{{ song.title }} <span class="slash">/</span> <span lang="zh-Hans">{{ song.titleZh }}</span>{% if song.note or song.key %}<small class="song-detail">{{ song.note }}{{ song.key }}</small>{% endif %}</span>{% if song.duration %}<span class="song-duration">{{ song.duration }}</span>{% endif %}</li>
          {% endfor %}
          </ol>
        </div>
      {% endfor %}
      </div>
      <p class="repertoire-note">Закажите музыканта на эрху для мероприятия в Москве. Живое исполнение китайской музыки на традиционном китайском струнном инструменте — для свадеб, корпоративов и частных событий.<br><span lang="zh-Hans">为您在莫斯科的活动预约二胡演奏者。以中国传统弦乐器现场演绎中国音乐，适合婚礼、企业活动和私人聚会。</span></p>
    </section>
  </main>
  <footer class="wrap"><a href="https://luxuryband.ru/">Luxury Band</a><span>Эрху / <span lang="zh-Hans">二胡</span> · Видео, фото и репертуар / <span lang="zh-Hans">影像、照片与曲目</span></span><a href="#">Наверх ↑</a></footer>
  <dialog class="photo-viewer" aria-labelledby="photo-title">
    <div class="photo-viewer-head"><h2 id="photo-title">Фото / <span lang="zh-Hans">照片</span></h2><button class="close-photo" type="button" aria-label="Закрыть фото">×</button></div>
    <img class="photo-full" alt="">
    <div class="photo-viewer-foot"><div><button class="photo-previous" type="button" aria-label="Предыдущее фото">←</button><span class="photo-count" aria-live="polite"></span><button class="photo-next" type="button" aria-label="Следующее фото">→</button></div><a class="photo-download" download>Скачать фото / <span lang="zh-Hans">下载照片</span> ↓</a></div>
  </dialog>
  <dialog class="player" aria-labelledby="player-title">
    <div class="player-head"><div><p class="eyebrow">Звучащие свитки / <span lang="zh-Hans">弦音画卷</span></p><h2 id="player-title">Видео / <span lang="zh-Hans">影像</span></h2></div><button class="close-player" aria-label="Закрыть видео" type="button">×</button></div>
    <video controls playsinline preload="none" aria-label="Видео выступления на эрху"></video>
    <p class="playback-error" hidden>Не удалось начать воспроизведение. Попробуйте открыть или скачать видео по ссылке ниже.</p>
    <div class="player-foot"><div><button class="previous" type="button" aria-label="Предыдущее видео">←</button><span class="player-count"></span><button class="next" type="button" aria-label="Следующее видео">→</button></div><a class="player-download" download>Скачать видео ↓</a></div>
  </dialog>
  <p class="toast" role="status" hidden></p>
</body>
</html>
