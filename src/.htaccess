RewriteRule ^download\.php$ https://luxuryband.ru/download.php?file=live-icon-c970843de9c5-%2.mp4 [L,R=301,NE]

# 3) /index.html → /  (корень и подпапки) — убирает дубль главной и вложенных
RewriteCond %{THE_REQUEST} \s/+(([^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^(([^/]+/)*)index\.html$ https://luxuryband.ru/%1 [L,R=301,NE]

# 4) HTML всегда перепроверяем на сервере. Иначе Chrome может держать старый
#    index.html с прежним main.js и продолжать редиректить / на сохранённую локаль
#    даже после публикации исправления. Версионированные CSS/JS/медиа это не затрагивает.
<IfModule mod_headers.c>
	<FilesMatch "\.html?$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>

# 5) CORS только для видеофайлов — чтобы их можно было fetch'ить с других origin
#    (нужно для программной перезаливки на видеохостинги; на рендер сайта не влияет)
<IfModule mod_headers.c>
	<FilesMatch "\.(mp4|webm|mov|m4v)$">
		Header set Access-Control-Allow-Origin "*"
		Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
	</FilesMatch>
	<FilesMatch "\.(avif|webp|mp4|webm)$">
		Header set Cache-Control "public, max-age=604800"
	</FilesMatch>
</IfModule>
