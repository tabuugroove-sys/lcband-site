---
pagination:
  data: events
  size: 1
  alias: event
permalink: "/events/{{ event.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{% if event.seoTitle %}{{ event.seoTitle }}{% else %}{{ event.title }} — кавер-группа в Москве · {{ site.shortName }}{% endif %}"
  description: "{{ event.lead }}"
  keywords: "{{ event.keywords }}"
---

{% block schema %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "MusicGroup",
			"@id": "{{ site.url }}/#musicgroup",
			"name": "{{ site.name }}",
			"url": "{{ site.url }}"
		},
		{
			"@type": "Service",
			"@id": "{{ site.url }}{{ page.url }}#service",
			"name": "{{ event.title }} — {{ site.name }}",
			"description": "{{ event.lead }}",
			"serviceType": "Живая музыка и кавер-группа на мероприятие",
			"provider": { "@id": "{{ site.url }}/#musicgroup" },
			"areaServed": ["Москва", "Россия", "Международные туры"],
			"url": "{{ site.url }}{{ page.url }}"
		}
		,
		{
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "{{ site.shortName }}", "item": "{{ site.url }}/" },
				{ "@type": "ListItem", "position": 2, "name": "События", "item": "{{ site.url }}/events/" },
				{ "@type": "ListItem", "position": 3, "name": {{ event.title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
			]
		}
		{% set _img0 = event.blocks[0].image %}{% if _img0 %},
		{
			"@type": "ImageObject",
			"@id": "{{ site.url }}{{ page.url }}#primaryimage",
			"url": "{{ site.url }}/assets/photos/{{ _img0 }}",
			"contentUrl": "{{ site.url }}/assets/photos/{{ _img0 }}",
			"caption": {{ (event.blocks[0].imageAlt or (event.title + " — Luxury Cover Band")) | dump | safe }},
			"representativeOfPage": true,
			"creator": { "@id": "{{ site.url }}/#musicgroup" }
		}
		{% endif %}
		{% if event.faq %},
		{
			"@type": "FAQPage",
			"@id": "{{ site.url }}{{ page.url }}#faq",
			"mainEntity": [
				{%- for item in event.faq %}
				{ "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}
				{%- endfor %}
			]
		}
		{% endif %}
		{% if event.featuredVideo %},
		{
			"@type": "VideoObject",
			"@id": "{{ site.url }}{{ page.url }}#video-{{ event.featuredVideo }}",
			"name": "{{ event.title }} — видео {{ site.name }}",
			"description": "{{ event.lead }}",
			"thumbnailUrl": "{{ site.url }}/assets/video/posters/{{ event.featuredVideo }}.jpg",
			"contentUrl": "{{ site.url }}/assets/video/mp4/{{ event.featuredVideo }}-720.mp4",
			"embedUrl": "{{ site.url }}{{ page.url }}",
			"uploadDate": "2026-06-18",
			"publisher": { "@id": "{{ site.url }}/#musicgroup" }
		}
		{% endif %}
	]
}
</script>
{% endblock %}

<section class="page-hero">
	<div class="container container--narrow">
		<p class="page-hero__breadcrumb">
			<a href="{{ '/' | url }}">{{ site.shortName }}</a> <span>·</span>
			<a href="{{ '/events/' | url }}">События</a> <span>·</span>
			<span>{{ event.title }}</span>
		</p>
		<p class="page-hero__eyebrow">{{ event.eyebrow }}</p>
		<h1 class="page-hero__title">{{ event.headline }}</h1>
		<p class="page-hero__lead">{{ event.lead }}</p>
	</div>
</section>

<section class="section section--flush">
	<div class="container reveal">
		<div class="stats">
			<div class="stat"><div class="stat__num">{{ site.stats.shows }}</div><div class="stat__label">выступлений</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.countries }}</div><div class="stat__label">стран</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.years }}</div><div class="stat__label">лет на сцене</div></div>
			<div class="stat"><div class="stat__num">{{ site.stats.songs }}</div><div class="stat__label">песен в репертуаре</div></div>
		</div>
		{% if event.trustLine %}<p class="trust-line">{{ event.trustLine }}</p>{% endif %}
	</div>
</section>

<section class="section section--light">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Как строится</p>
		<h2 class="section__title">Структура<br><span class="muted">программы.</span></h2>
	</div>
</section>

{% for b in event.blocks %}
<section class="feature-block feature-block--{% if loop.index0 % 2 == 0 %}light{% else %}elev{% endif %}{% if loop.index0 % 2 == 1 %} feature-block--reverse{% endif %}">
	<div class="feature-block__inner reveal">
		{% if b.image %}
			{% if b.video %}
			<a class="feature-block__media feature-block__media--video video-card" href="#" data-video="{{ b.video }}" aria-label="Смотреть видео {{ b.title }}">
				<img src="{{ ('/assets/photos/' + b.image) | url }}" alt="{{ b.imageAlt or (b.title + ' — ' + event.title) }}" loading="lazy">
				<span class="video-card__play" aria-hidden="true"></span>
			</a>
			{% else %}
			<div class="feature-block__media">
				<img src="{{ ('/assets/photos/' + b.image) | url }}" alt="{{ b.imageAlt or (b.title + ' — ' + event.title) }}" loading="lazy">
			</div>
			{% endif %}
		{% endif %}
		<div class="feature-block__body">
			<h3 class="feature-block__title">{{ b.title }}</h3>
			<p class="feature-block__text">{{ b.text }}</p>
		</div>
	</div>
</section>
{% endfor %}

{% if event.featuredVideo %}
<section class="section section--elev">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Видео</p>
		<h2 class="section__title">Как это<br><span class="muted">выглядит.</span></h2>
	</div>
	<div class="container reveal">
		<div class="featured-video">
			<a class="video-card video-card--wide" href="#" data-video="{{ event.featuredVideo }}">
				<img src="{{ ('/assets/video/posters/' + event.featuredVideo + '.jpg') | url }}" alt="{{ event.title }} — видео" loading="lazy">
				<span class="video-card__play" aria-hidden="true"></span>
			</a>
		</div>
	</div>
</section>
{% endif %}

{% if event.slug == 'corporate' %}
<section class="section section--light" id="formats">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Форматы работы</p>
		<h2 class="section__title">Одна команда —<br><span class="muted">четыре роли.</span></h2>
		<p class="section__lead">Мы не просто играем концерт. Мы встраиваемся в формат события — от хоровой коллаборации до караоке-шоу с гостями.</p>
	</div>
	<div class="container reveal">
		<ul class="formats">
			{% for f in formats %}
			<li class="format">
				<a class="format__link" href="{{ ('/formats/' + f.slug + '/') | url }}">
					<div class="format__photo"><img src="{{ ('/' + f.poster) | url }}" alt="{{ f.title }} — формат LC Band" loading="lazy"></div>
					<div class="format__body">
						<span class="format__label">{{ f.eyebrow }}</span>
						<h3 class="format__title">{{ f.title }}</h3>
						<p class="format__text">{{ f.headline }}</p>
						<span class="format__more">Подробнее ›</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>
{% endif %}

<section class="section section--elev" id="addons">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Дополнительно</p>
		<h2 class="section__title">Соберём вечер<br><span class="muted">целиком.</span></h2>
		<p class="section__lead">Кроме бенда закрываем техническую и развлекательную часть события — под ключ или отдельными блоками.</p>
	</div>
	<div class="container reveal">
		<ul class="addon-grid">
			<li class="addon-card">
				<span class="addon-card__icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="20" cy="20" r="2.2" fill="currentColor" stroke="none"/><path d="M14 14a8.4 8.4 0 000 12"/><path d="M26 14a8.4 8.4 0 010 12"/><path d="M9.5 9.5a15 15 0 000 21"/><path d="M30.5 9.5a15 15 0 010 21"/></svg></span>
				<h3 class="addon-card__title">Звук</h3>
				<p class="addon-card__text">Профессиональный звук под площадку любого размера — от камерного зала до открытой территории.</p>
			</li>
			<li class="addon-card">
				<span class="addon-card__icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 8h12l3 10H11z"/><path d="M15 18l-4 14M25 18l4 14M20 18v14"/></svg></span>
				<h3 class="addon-card__title">Свет</h3>
				<p class="addon-card__text">Световое шоу и оформление сцены под концепцию и цвета вашего события.</p>
			</li>
			<li class="addon-card">
				<span class="addon-card__icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="18" cy="20" r="11"/><circle cx="18" cy="20" r="2.4" fill="currentColor" stroke="none"/><path d="M27 11l5-3M29 9v5"/></svg></span>
				<h3 class="addon-card__title">DJ</h3>
				<p class="addon-card__text">DJ на afterparty — плавный переход от живого сета к танцполу до утра.</p>
			</li>
			<li class="addon-card">
				<span class="addon-card__icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="15.5" y="7" width="9" height="15" rx="4.5"/><path d="M11 18a9 9 0 0018 0"/><path d="M20 27v5M15 32h10"/></svg></span>
				<h3 class="addon-card__title">Ведущий</h3>
				<p class="addon-card__text">Ведущий держит тайминг, конкурсы и настроение зала весь вечер.</p>
			</li>
			<li class="addon-card">
				<span class="addon-card__icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="20" cy="14" rx="10" ry="4"/><path d="M10 14v10a10 4 0 0020 0V14"/><path d="M13 8l7 8M27 8l-7 8"/></svg></span>
				<h3 class="addon-card__title">Drum-show</h3>
				<p class="addon-card__text">Барабанное шоу с LED-эффектами — яркий акцент в середине программы.</p>
			</li>
			<li class="addon-card">
				<span class="addon-card__icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="15" cy="27" r="4"/><circle cx="27" cy="24" r="4"/><path d="M19 27V9l12-3v18"/></svg></span>
				<h3 class="addon-card__title">Jazz band</h3>
				<p class="addon-card__text">Камерный джазовый состав — для welcome-зоны и коктейльной части.</p>
			</li>
		</ul>
		<div class="addon-grid__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Обсудить в Телеграм</a>
		</div>
	</div>
</section>

{% if event.faq %}
<section class="section section--light" id="faq">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Вопросы</p>
		<h2 class="section__title">Частые<br><span class="muted">вопросы.</span></h2>
		<div class="faq">
			{% for item in event.faq %}
			<details class="faq__item">
				<summary class="faq__q">{{ item.q }}</summary>
				<div class="faq__a"><p>{% set _ans = item.aHtml if item.aHtml else item.a %}{{ _ans | replace("Телеграм", '<a href="' + site.telegram + '">Телеграм</a>') | safe }}</p></div>
			</details>
			{% endfor %}
		</div>
	</div>
</section>
{% endif %}

<section class="section section--flush">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Ещё у нас</p>
		<ul class="related-links">
			<li><a href="{{ '/programs/' | url }}">Тематические программы</a></li>
			<li><a href="{{ '/repertoire/' | url }}">Репертуар — 500+ песен</a></li>
			<li><a href="{{ '/vocalists/' | url }}">Вокалисты</a></li>
			<li><a href="{{ '/formats/' | url }}">Форматы работы</a></li>
			<li><a href="{{ '/sax/' | url }}">Саксофонист</a></li>
		</ul>
	</div>
</section>

<section class="section section--book">
	<div class="container container--narrow reveal">
		<h2 class="section__title">{{ event.cta }}.</h2>
		<div class="book__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Написать в Телеграм</a>
			<a class="btn btn--ghost-dark" href="{{ '/events/' | url }}">Все события</a>
		</div>
	</div>
</section>
