					{% for s in g.songs %}
					<li class="sx-song"><span class="sx-song__title">{{ s[0] }}</span><span class="sx-song__artist">{{ s[1] }}</span></li>
					{% endfor %}
				</ul>
			</div>
			{% endfor %}
		</div>
	</section>

	<section class="sx-live" id="sx-live">
		<div class="sx-wrap">
			<div class="sx-eyebrow sx-eyebrow--accent">Форматы</div>
			<h2 class="sx-h2">Можно заказать отдельно или добавить к группе.</h2>
			<div class="sx-format-grid">
