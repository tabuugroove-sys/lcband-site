						<a class="btn btn--blue" href="{{ '/events/birthday/' | url }}">Saiba mais</a>
						<a class="btn btn--blue-ghost" href="{{ site.telegram }}">Falar no Telegram</a>
					</div>
				</div>
			</li>
			<li class="tile tile--has-photo tile--copy-stack tile--copy-dark tile--clients">
				<a class="tile__tap-target" href="{{ '/events/corporate/' | url }}" aria-label="Abrir: Eventos para clientes"></a>
				<picture class="tile__pic">
					<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
						srcset="{{ '/assets/photos/clients-768.webp' | url }} 768w, {{ '/assets/photos/clients-1152.webp' | url }} 1152w">
					<img class="tile__img" src="{{ '/assets/photos/clients.jpg' | url }}" alt="Eventos para clientes — Luxury Cover Band" loading="lazy">
				</picture>
				<div class="tile__content">
					<h3 class="tile__title">Eventos<span class="tile__line"> para clientes</span></h3>
