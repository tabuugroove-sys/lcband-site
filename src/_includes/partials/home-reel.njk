{#- Четыре немых ролика 2×2 вместо фото блока «О группе» — решение Михаила 29.10:
    Epic Live 04 «Голоса», студийное промо «пик за пиком», лучшие моменты остальных
    видео (mix-12, вместо 06 «Неон» — слева снизу) и 03 «Зал поёт».
    Полоса сверху — по образцу ленточки Apple One: одна фраза и «Узнать больше».
    Формат сетки по ширине экрана: 21:9 → 2:1 → 3:2, на телефоне четыре квадрата.
    Ролики из 4K/HQ-исходников («чтобы пикселей не было»), 30.10 облегчены («приоритет —
    скорость»): широкие 1280×640 ≈ 1,6 Мбит/с; квадраты для телефона — 480×480 ≈ 0,6 Мбит/с
    («на телефоне облегчённую версию, чтобы быстро», 30.10), без анимации появления; лежат на хостинге
    в assets/video/mp4 (media/manifest.json), постеры — assets/hero, описание —
    media/home-reel.json. Странице задать reelTitle, reelHref, reelMore. -#}
{#- Размытая заглушка прямо в странице: плитка не чёрная, пока постер в пути (30.10, Safari). -#}
{% set reelBlur = {'epic-04':'UklGRnYAAABXRUJQVlA4IGoAAADQAwCdASoUAAoAPxFysVAsJqSisAgBgCIJbACdH8ACuTLWFSfYW8AA/szSOLL3yzphADjN5cWT7dyj/JtXs67zk5EL2Qc8e7XDBXd2h0Vak4vLS7COzf2936aIPpH50meokO6cZkl1wAAA', 'studio-11':'UklGRmIAAABXRUJQVlA4IFYAAACwAwCdASoUAAoAPxFysFAsJqSisAgBgCIJYgCdMoGv/gUDVg7FgAD+7Zpz/jS3yxikAB3/g1pJzQTeLz0UoEswSRJFzy0Gs0RQfKUoUyhRMsyZJAAAAA==', 'mix-12':'UklGRoAAAABXRUJQVlA4IHQAAABQBACdASoUAAoAPxFysFAsJqSisAgBgCIJbACdMoR3AB6gC4aQJ7NoDcgAAPk80lIWA/g3DW6Wvg+ITvI207rgYIFDpxw8e+XzChxu6zatSCOQB7nSbc/US+2Q3O5PuxaBZClvAT4yhIVLi68ImVZ2T3AAAA==', 'epic-03':'UklGRnQAAABXRUJQVlA4IGgAAABwBACdASoUAAoAPxFysVAsJqSisAgBgCIJbACdMoR4GCluxCaEqJV41rcayAD+Dz/NnuO04MKPdufRQGor4tjBetukmSsVWJd6nUkZX7tVUtABVVZGUyDc4XsGMV/jljZA8s6YnOYAAA=='} %}
{% set reelLabels = {
  ru: {pause:'Пауза видео', resume:'Включить видео'},
  en: {pause:'Pause videos', resume:'Play videos'},
  ar: {pause:'إيقاف الفيديو مؤقتًا', resume:'تشغيل الفيديو'},
  'pt-BR': {pause:'Pausar vídeos', resume:'Reproduzir vídeos'}
} %}
{% set reelLabel = reelLabels[htmlLang or 'ru'] %}
<section class="reel" id="about" data-reel aria-labelledby="reel-title">
	<div class="reel__ribbon">
		<h2 class="reel__title" id="reel-title">{{ reelTitle | safe }}</h2>
		<a class="btn reel__more" href="{{ reelHref | url }}">{{ reelMore }}</a>
	</div>
	{#- data-reel-zoom — эксперимент 30.10: плитка вырастает из центра чуть больше своего размера
	    и возвращается к обычному. Откатить — убрать атрибут. -#}
	<div class="reel__grid" data-reel-grid data-reel-zoom>
		{#- 30.10: плитки прячутся сразу, до main.js, иначе все постеры мелькают и пропадают. Дошли до
		    сетки раньше скрипта (медленный интернет) — показываем постеры, чтобы не было черноты.
		    Телефон и reduced-motion — без анимации. -#}
		<script>(function(g){if(g&&innerWidth>599&&'IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){g.classList.add('is-sequenced');new IntersectionObserver(function(e,o){if(e[0].isIntersecting){o.disconnect();if(!window.LCBReelSequence)g.classList.remove('is-sequenced')}}).observe(g)}})(document.currentScript.parentElement);</script>
		{%- for id in ['epic-04', 'studio-11', 'mix-12', 'epic-03'] %}
		{#- 30.10: нижний ряд — отдельный слой с магнитом, как остальные блоки; верхний появляется по одному. -#}
		<div class="reel__tile"{% if loop.index0 >= 2 %} data-magnet-item="desktop"{% endif %}>
			<div class="reel__bloom" style="background-image:url(data:image/webp;base64,{{ reelBlur[id] }})">
			<picture class="reel__poster">
				<source media="(max-width: 599px)" srcset="{{ ('/assets/hero/hq-20261029-' + id + '-square.webp') | url }}">
				<img src="{{ ('/assets/hero/hq-20261029-' + id + '-wide.webp') | url }}" alt="" width="1280" height="640" decoding="async"{% if loop.index0 == 0 %} fetchpriority="high"{% endif %}>
			</picture>
			<video class="reel__video" data-reel-video muted loop playsinline preload="none" tabindex="-1" aria-hidden="true"
				data-src-wide="{{ ('/assets/video/mp4/lt2-20261030-' + id + '-wide.mp4') | url }}"
				data-src-square="{{ ('/assets/video/mp4/ph-20261030-' + id + '-square.mp4') | url }}"></video>
			</div>
		</div>
		{%- endfor %}
		<button class="reel__toggle" type="button" data-reel-toggle hidden
			data-label-pause="{{ reelLabel.pause }}" data-label-resume="{{ reelLabel.resume }}"
			aria-label="{{ reelLabel.pause }}"></button>
	</div>
</section>
