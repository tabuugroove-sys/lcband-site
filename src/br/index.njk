</section>

<!-- =============== VÍDEOS (2 fileiras estilo Apple · sem faixas com título em cirílico) =============== -->
<section class="section" id="videos">
	{% set promos = [
		{slug:'promo-danza-cuduro', poster:'promo-danza-cuduro-2026', title:'Danza Cuduro · Ao Vivo', eyebrow:'Ao Vivo'},
		{slug:'thematic-retro-heart', poster:'thematic-retro-heart-2026', title:'You\'re My Heart · Retrô', eyebrow:'Temático'},
		{slug:'promo-lets-get-it-started', title:'Let\'s Get It Started', eyebrow:'Promo'},
		{slug:'promo-cold-heart', title:'Cold Heart', eyebrow:'Promo'},
		{slug:'promo-loca-loca', title:'Loca Loca · LAZ', eyebrow:'Promo'},
		{slug:'promo-amore-no', title:'Amore No · Italiana', eyebrow:'Temático'},
		{slug:'thematic-italian', title:'Cosa sei · Italiana', eyebrow:'Temático'},
		{slug:'interact-wedding-shallow', title:'Shallow · casamento', eyebrow:'Interativo'}
	] %}
	{% set lives = [
		{slug:'live-icon', title:'Ao Vivo Épico · Icon', eyebrow:'Ao Vivo'},
		{slug:'teddy-macarena', title:'Teddy · Macarena', eyebrow:'Interativo'},
		{slug:'teddy-latina-promo', title:'Teddy · Latina', eyebrow:'Latino'},
		{slug:'luxury-latin-dance-master-class', title:'Teddy · Masterclass de Dança', eyebrow:'Interativo'},
		{slug:'interact-laz-coco-jambo', title:'LAZ · Coco Jambo', eyebrow:'Interativo'},
		{slug:'live-lets-get-loud', title:'Let\'s Get Loud', eyebrow:'Ao Vivo'},
		{slug:'live-jazz-vintage', title:'Jazz · Vintage', eyebrow:'Temático'},
		{slug:'live-big-lineup', title:'Big Lineup', eyebrow:'Ao Vivo'},
		{slug:'live-perfect', title:'Perfect', eyebrow:'Ao Vivo'},
		{slug:'live-soho', title:'Soho Rooms', eyebrow:'Ao Vivo'},
		{slug:'interact-chainsmokers', title:'Chainsmokers', eyebrow:'Interativo'},
		{slug:'live-dance-monkey', title:'Dance Monkey', eyebrow:'Ao Vivo'},
		{slug:'live-simple-the-best', title:'Simply the Best · Jazz', eyebrow:'Ao Vivo'},
		{slug:'live-adele-hello', title:'Adele · Hello', eyebrow:'Ao Vivo'}
	] %}
	<div class="container container--narrow reveal">
		<h2 class="section__title">Veja como<br><span class="muted">funciona no palco.</span></h2>
		<p class="section__lead">Promos de estúdio, gravações de shows, momentos interativos e programas temáticos.</p>
	</div>

	<div class="video-rail video-rail--big reveal" role="region" aria-label="Vídeos promocionais de estúdio">
		<div class="video-rail__heading"><h3 class="video-rail__title">Vídeos promocionais de estúdio</h3></div>
		<ul class="video-rail__track">
			{% for v in promos %}
			<li class="vtile vtile--big">
				<a class="vtile__link" href="#" data-video="{{ v.slug }}">
					<picture class="vtile__pic">
						<source media="(max-width: 734px)" type="image/webp" sizes="84vw"
							srcset="{{ ('/assets/video/posters/' + (v.poster or v.slug) + '-720.webp') | url }} 720w, {{ ('/assets/video/posters/' + (v.poster or v.slug) + '-1080.webp') | url }} 1080w">
						<img class="vtile__poster" src="{{ ('/assets/video/posters/' + (v.poster or v.slug) + '.jpg') | url }}?v=20260620i" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					</picture>
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
	<div class="video-rail video-rail--small reveal" role="region" aria-label="Vídeos ao vivo de shows">
		<div class="video-rail__heading"><h3 class="video-rail__title">Vídeos ao vivo de shows</h3></div>
		<ul class="video-rail__track">
			{% for v in lives %}
			<li class="vtile vtile--small">
				<a class="vtile__link" href="#" data-video="{{ v.slug }}">
					<picture class="vtile__pic">
						<source media="(max-width: 734px)" type="image/webp" sizes="72vw"
							srcset="{{ ('/assets/video/posters/' + v.slug + '-720.webp') | url }} 720w, {{ ('/assets/video/posters/' + v.slug + '-1080.webp') | url }} 1080w">
						<img class="vtile__poster" src="{{ ('/assets/video/posters/' + v.slug + '.jpg') | url }}?v=20260622c" alt="{{ v.title }} — Luxury Cover Band" loading="lazy">
					</picture>
					<span class="vtile__play" aria-hidden="true"></span>
					<div class="vtile__caption">
						<span class="vtile__eyebrow">{{ v.eyebrow }}</span>
						<span class="vtile__title">{{ v.title }}</span>
					</div>
				</a>
			</li>
			{% endfor %}
		</ul>
	</div>
</section>

<!-- =============== RESERVA =============== -->
<section class="section section--book" id="book">
	<div class="container container--narrow reveal">
		<p class="section__eyebrow">Reserva</p>
		<h2 class="section__title">Escreva para nós —<br><span class="muted">montamos um show sob medida para o seu evento.</span></h2>
		<p class="section__lead">Conte a data, o local e o formato. Enviamos a formação, o cronograma e o orçamento no mesmo dia.</p>
		<div class="book__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">Falar no Telegram</a>
			<a class="btn btn--ghost-dark" href="#top">Voltar ao topo</a>
		</div>
	</div>
</section>
