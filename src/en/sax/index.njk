	.sx-hero__content { padding:0 20px max(42px, 8svh); }
	.sx-hero__title { font-size:clamp(40px, 14vw, 68px); }
	.sx-hero__lead { font-size:clamp(20px, 6.4vw, 28px); }
	.sx-hero__cta { margin-top:28px; }
	.sx-genres { gap:12px 0; letter-spacing:0.24em; }
