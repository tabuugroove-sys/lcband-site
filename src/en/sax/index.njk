</style>

<script>
(function () {
	var v = document.querySelector('.sx-hero__media');
	if (!v || !('IntersectionObserver' in window)) return;
	var scrolledAway = false;   // the hero has left the viewport
	var started = false;        // the video has already been started
	var play = function () { var p = v.play(); if (p && p.catch) p.catch(function () {}); };
	// Keep the poster still on initial load. Start only after the user scrolls
	// past the hero and returns to it.
	var io = new IntersectionObserver(function (entries) {
		entries.forEach(function (e) {
			if (!e.isIntersecting) {
				scrolledAway = true;
			} else if (scrolledAway) {
				started = true;
				play();
			} else if (started) {
				play();
			}
		});
	}, { threshold: 0.35 });
	io.observe(v);
})();
</script>
