<!-- =============== HERO (AR · 4-COLOR SWITCHABLE LINEUP + INLINE VIDEO) =============== -->
<section class="hero" data-hero>
	<div class="hero__stage">
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-red-640.webp' | url }} 640w, {{ '/assets/hero/hero-red-960.webp' | url }} 960w, {{ '/assets/hero/hero-red-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--red is-active"  src="{{ '/assets/hero/hero-red.jpg' | url }}"   alt="{{ site.name }} — إطلالة حمراء أمام شاشة LED" loading="eager" fetchpriority="high" data-hero-img="red">
		</picture>
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-bw-640.webp' | url }} 640w, {{ '/assets/hero/hero-bw-960.webp' | url }} 960w, {{ '/assets/hero/hero-bw-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--bw"             src="{{ '/assets/hero/hero-bw.jpg' | url }}"    alt="{{ site.name }} — إطلالة بالأبيض والأسود"  loading="lazy" data-hero-img="bw">
		</picture>
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-gold-640.webp' | url }} 640w, {{ '/assets/hero/hero-gold-960.webp' | url }} 960w, {{ '/assets/hero/hero-gold-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--gold"           src="{{ '/assets/hero/hero-gold.jpg' | url }}"  alt="{{ site.name }} — إطلالة ذهبية على المسرح"       loading="lazy" data-hero-img="gold">
		</picture>
		<picture>
			<source media="(max-width: 734px)" type="image/webp" sizes="100vw"
				srcset="{{ '/assets/hero/hero-white-640.webp' | url }} 640w, {{ '/assets/hero/hero-white-960.webp' | url }} 960w, {{ '/assets/hero/hero-white-1280.webp' | url }} 1280w">
			<img class="hero__bg hero__bg--white"          src="{{ '/assets/hero/hero-white.jpg' | url }}" alt="{{ site.name }} — إطلالة بيضاء على خلفية النجوم"  loading="lazy" data-hero-img="white">
		</picture>
		<video class="hero__video" data-hero-video playsinline preload="none"></video>
	</div>
	<div class="hero__scrim"></div>
	<button class="hero__play" data-hero-play type="button" aria-label="شاهد الفيديو بهذه الإطلالات"></button>
	<button class="hero__close" data-hero-close type="button" aria-label="إغلاق الفيديو"></button>
	<div class="hero__controls" data-hero-controls>
		<button class="hero__toggle" data-hero-toggle type="button" aria-label="إيقاف مؤقت"></button>
		<div class="hero__progress" data-hero-progress>
			<div class="hero__progress-filled" data-hero-progress-filled></div>
		</div>
		<span class="hero__time" data-hero-time>0:00 / 0:00</span>
	</div>
	<div class="hero__quality" data-hero-quality role="group" aria-label="جودة الفيديو">
		<button type="button" data-hero-q="720">720p</button>
		<button type="button" data-hero-q="1080" class="is-active">1080p</button>
		<button type="button" data-hero-q="2160" hidden>4K</button>
	</div>
	<div class="hero__recommendations" data-hero-recommendations aria-hidden="true" aria-label="شاهد التالي">
		<button class="hero-rec" type="button" data-hero-recommendation="0">
			<img class="hero-rec__poster" data-hero-rec-poster alt="" loading="eager">
			<span class="hero-rec__copy">
				<span class="hero-rec__costume" data-hero-rec-costume></span>
				<strong class="hero-rec__title" data-hero-rec-title></strong>
			</span>
			<span class="hero-rec__play" aria-hidden="true"></span>
		</button>
		<button class="hero-rec" type="button" data-hero-recommendation="1">
			<img class="hero-rec__poster" data-hero-rec-poster alt="" loading="eager">
			<span class="hero-rec__copy">
				<span class="hero-rec__costume" data-hero-rec-costume></span>
				<strong class="hero-rec__title" data-hero-rec-title></strong>
			</span>
			<span class="hero-rec__play" aria-hidden="true"></span>
		</button>
	</div>
	<div class="hero__content">
		<p class="hero__eyebrow">فرقة كوفر عالمية</p>
		<h1 class="hero__title">{{ site.name }}</h1>
		<div class="hero__cta">
			<a class="btn btn--primary" href="{{ site.telegram }}">راسلنا على تيليجرام</a>
		</div>
		<div class="hero__picker" role="tablist" aria-label="اختر الإطلالة">
			<button class="hero__dot hero__dot--red is-active"  data-hero-dot="red"   role="tab" aria-label="الإطلالة الحمراء"       aria-selected="true"></button>
			<button class="hero__dot hero__dot--bw"             data-hero-dot="bw"    role="tab" aria-label="إطلالة الأبيض والأسود" aria-selected="false"></button>
			<button class="hero__dot hero__dot--gold"           data-hero-dot="gold"  role="tab" aria-label="الإطلالة الذهبية"      aria-selected="false"></button>
			<button class="hero__dot hero__dot--white"          data-hero-dot="white" role="tab" aria-label="الإطلالة البيضاء"     aria-selected="false"></button>
		</div>
	</div>
	<a class="hero__scroll" href="#about" aria-label="انتقل إلى الوصف"><span></span></a>
</section>

<!-- =============== ABOUT / STATS =============== -->
<section class="section section--elev" id="about">
