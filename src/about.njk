<!-- =============== STORY ROOMS (Apple TV 4K style: bands + pinned screen) =============== -->
{#- Полосы и слои экрана строятся из ОДНОГО массива: новая полоса = одна
    запись {eyebrow, title, text, bg, tint?, light?, video}. Порядок записей =
    порядок полос и z-порядок слоёв. Видео и постер берутся по slug'у video:
    /assets/video/mp4/<video>-720.mp4 + /assets/video/posters/<video>.jpg
    bg — любое CSS-background; палитра ниже = цвета полос section-rooms
    с apple.com/apple-tv-4k (Music / Fitness+ / Arcade / Photos). 28.10.2026
    зелёная и красная полосы затемнены, тинт текста осветлён: белый текст на
    исходных цветах читался на 1,2–3,1:1, нужно ≥ 4,5:1. -#}
{% set storyRooms = [
	{eyebrow:'Репертуар', title:'Песни<br>на 12 языках.', text:'Итальянский, испанский, французский, английский и другие языки — под программу и аудиторию. Список песен можно открыть с поиском или скачать в PDF.', href:'/repertoire/', linkLabel:'Открыть список песен', bg:'radial-gradient(at top right, #6547ba, #572f91)', tint:'rgba(255,255,255,.9)', video:'interact-chainsmokers'},
	{eyebrow:'Репертуар', title:'500+ песен.<br>От джаза до танцпола.', text:'Для welcome — джаз и лаунж; для основной программы — поп, рок, ретро или латино. Выбираем песни и порядок блоков под сценарий вашего вечера.', href:'/programs/', linkLabel:'Посмотреть программы', bg:'radial-gradient(at top right, #00745c, #005f2a)', tint:'rgba(255,255,255,.9)', video:'live-big-lineup'},
	{eyebrow:'Интерактив', title:'«Не побоялись даже<br>выйти к зрителям»', text:'«Вы первый кто так сделал в нашем городе!!! Мы были в огромном восторге!!!» — зрительница о концерте Lazzy в Лабытнангах. Рассказ о выступлении 12 сентября 2026 года и выходе к зрителям — на странице LAZ. В ролике — пример интерактива на другом выступлении.', href:'/vocalists/laz/', linkLabel:'Рассказ о концерте в Лабытнангах', bg:'radial-gradient(at top right, #ad3720, #a91d30)', tint:'rgba(255,255,255,.9)', video:'interact-laz-coco-jambo'},
	{eyebrow:'Образы', title:'20+ образов.<br>Свой стиль на каждый повод.', text:'Красный, чёрно-белый, золотой и другие сценические образы — в фотогалерее. Выбираем костюмы под палитру и формат события.', href:'/costumes/', linkLabel:'Посмотреть сценические образы', bg:'#f5f5f7', light:true, video:'live-icon'}
] %}
<section class="story-rooms" data-story-rooms>
	<div class="story-rooms__gallery" aria-hidden="true">
		<div class="story-rooms__device">
			<div class="story-rooms__frame">
				{% for r in storyRooms %}
				<div class="story-rooms__layer" data-story-layer="{{ loop.index0 }}" style="z-index: {{ loop.index }};">
					<video muted loop playsinline preload="none"
						poster="{{ ('/assets/video/posters/' + r.video + '.jpg') | url }}">
						<source data-src="{{ site.url }}/assets/video/mp4/{{ r.video }}-720.mp4" type="video/mp4">
					</video>
				</div>
				{% endfor %}
			</div>
		</div>
	</div>
	<div class="story-rooms__rooms">
		{% for r in storyRooms %}
		<div class="story-room{% if r.light %} story-room--light{% endif %}" data-room="{{ loop.index0 }}" style="--room-bg: {{ r.bg }};{% if r.tint %} --room-tint: {{ r.tint }};{% endif %}">
			<div class="story-room__copy">
				<img class="story-room__static" src="{{ ('/assets/video/posters/' + r.video + '.jpg') | url }}" alt="" loading="lazy" width="1800" height="1012">
				<a class="story-room__watch" href="#" data-video="{{ r.video }}">Смотреть видео</a>
				<p class="story-room__eyebrow">{{ r.eyebrow }}</p>
				<h2 class="story-room__title">{{ r.title | safe }}</h2>
				<p class="story-room__text">{{ r.text }}</p>
				<p class="story-room__text"><a href="{{ r.href | url }}">{{ r.linkLabel }} →</a></p>
			</div>
		</div>
		{% endfor %}
	</div>
</section>

