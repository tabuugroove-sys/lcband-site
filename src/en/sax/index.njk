.sx-eyebrow--accent { color:#c69a4e; }
.sx-h2 { font-size:clamp(34px,5.2vw,68px); font-weight:600; letter-spacing:-0.025em; line-height:1.02; margin:18px 0 0; max-width:840px; color:#1d1d1f; }
.sx-h2--light { color:#f5f5f7; }

